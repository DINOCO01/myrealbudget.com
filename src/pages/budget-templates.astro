---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { BUDGET_TEMPLATES } from '../data/templatesData';

const title = 'Budget Templates Directory: Free Spreadsheets & Planners';
const description = 'Browse our directory of free budget templates. Choose from 50/30/20, Zero-Based, Simple Monthly, Student, and Couples household budget spreadsheets.';
---

<Layout title={title} description={description}>
  <!-- HEADER INTRO -->
  <section class="border-b border-[#ebebeb] bg-white pt-12 pb-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <Eyebrow text="Templates Catalog" tKey="templates.eyebrow" />
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-[-0.03em] text-[#171717] leading-tight" data-mrb-t="templates.heading">
          Budget Templates Directory
        </h1>
        <p class="text-base sm:text-lg text-[#4d4d4d] leading-relaxed" data-mrb-t="templates.desc">
          Find the right budgeting spreadsheet for your specific situation. Every template is completely free to download or use with our online planners.
        </p>
      </div>
    </div>
  </section>

  <!-- DIRECTORY GRID -->
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {BUDGET_TEMPLATES.map((template) => (
        <article class="bg-white rounded-[12px] border border-[#ebebeb] p-6 shadow-whisper flex flex-col justify-between hover:border-[#a1a1a1] transition">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="inline-block px-2.5 py-0.5 rounded-[6px] bg-[#f2f2f2] text-xs font-mono text-[#4d4d4d]" data-mrb-t={`tmpl.${template.id}.method`}>
                {template.method}
              </span>
              <span class="text-xs text-[#8f8f8f] font-mono">CSV / Sheets</span>
            </div>

            <h2 class="text-lg font-semibold text-[#171717] tracking-tight" data-mrb-t={`tmpl.${template.id}.name`}>
              {template.name}
            </h2>

            <p class="text-xs text-[#4d4d4d] leading-relaxed" data-mrb-t={`tmpl.${template.id}.short_desc`}>
              {template.shortDescription}
            </p>

            <div class="pt-2 border-t border-[#f2f2f2] space-y-1">
              <span class="text-[11px] font-mono uppercase text-[#8f8f8f] block" data-mrb-t="templates.who_for">Who it is for:</span>
              <p class="text-xs text-[#171717]" data-mrb-t={`tmpl.${template.id}.audience`}>
                {template.targetAudience}
              </p>
            </div>
          </div>

          <div class="pt-6 border-t border-[#ebebeb] mt-6 flex flex-col sm:flex-row gap-2">
            <a
              href={template.downloadUrl || `/budget-planner-template/#${template.id}`}
              download={template.downloadUrl ? true : undefined}
              class="flex-1 inline-flex items-center justify-center h-9 px-4 rounded-full bg-[#171717] text-white text-xs font-medium hover:bg-neutral-800 transition text-center"
              data-mrb-t="templates.get_template"
            >
              Get Template
            </a>
            <a
              href={template.methodSlug}
              class="flex-1 inline-flex items-center justify-center h-9 px-4 rounded-full bg-white text-[#171717] border border-[#ebebeb] text-xs font-medium hover:bg-neutral-50 transition text-center shadow-whisper"
              data-mrb-t="templates.online_tool"
            >
              Online Tool
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- DETAILED EDUCATIONAL GUIDE & COMPARISON -->
    <section class="mt-20 border-t border-[#ebebeb] pt-16 space-y-16">
      <!-- Section 1: What a Budget Template Does -->
      <div class="max-w-4xl mx-auto space-y-6">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.02em] text-[#171717]">
          What Is a Budget Template and How Does It Work?
        </h2>
        <div class="prose prose-neutral max-w-none text-sm sm:text-base text-[#4d4d4d] leading-relaxed space-y-4">
          <p>
            A budget template is a pre-formatted financial framework that categorizes your incoming revenue and outgoing expenses into structured groups. Rather than starting from an empty blank page each month, a well-engineered template provides the necessary mathematical architecture—including automated subtotals, cash surplus or deficit calculations, and category allocations—so you can quickly understand your exact disposable income.
          </p>
          <p>
            The fundamental purpose of using a template is not to restrict your lifestyle or induce guilt over small everyday purchases. Instead, it transforms abstract account balances into an intentional plan. By projecting your known fixed commitments (such as housing, utilities, insurance, and debt minimums) against your verified net income before the month begins, a template eliminates guesswork and gives you the confidence to spend discretionary funds without financial anxiety.
          </p>
        </div>
      </div>

      <!-- Section 2: Comparing Budgeting Methodologies -->
      <div class="max-w-4xl mx-auto space-y-8">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.02em] text-[#171717]">
          Comparing Budgeting Frameworks: Finding the Right Match
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-[#4d4d4d]">
          <div class="p-6 rounded-[12px] bg-[#fafafa] border border-[#ebebeb] space-y-3">
            <h3 class="text-lg font-semibold text-[#171717]">General Monthly Budgeting</h3>
            <p class="leading-relaxed">
              <strong>When to use:</strong> Ideal when you want a standard, realistic overview of regular income and typical household expenses. It organizes spending into predictable buckets and helps you track month-over-month trends without requiring every single dollar to be accounted for in advance.
            </p>
            <p class="text-xs text-[#737373]">
              Best paired with our <a href="/budget-planner/" class="text-[#171717] font-medium underline hover:text-[#0070f3]">Interactive Budget Planner</a> to normalize irregular paychecks and multi-frequency bills into consistent monthly averages.
            </p>
          </div>

          <div class="p-6 rounded-[12px] bg-[#fafafa] border border-[#ebebeb] space-y-3">
            <h3 class="text-lg font-semibold text-[#171717]">The 50/30/20 Proportional Rule</h3>
            <p class="leading-relaxed">
              <strong>When to use:</strong> Perfect for people who find detailed line-item bookkeeping tedious. The 50/30/20 framework simplifies your finances into three macro allocations: 50% for essential needs, 30% for personal wants, and 20% for savings and debt reduction.
            </p>
            <p class="text-xs text-[#737373]">
              Test your numbers instantly with our <a href="/50-30-20-budget/" class="text-[#171717] font-medium underline hover:text-[#0070f3]">50/30/20 Budget Calculator</a> to verify whether your current fixed living costs fit within the 50% benchmark.
            </p>
          </div>

          <div class="p-6 rounded-[12px] bg-[#fafafa] border border-[#ebebeb] space-y-3">
            <h3 class="text-lg font-semibold text-[#171717]">Zero-Based Budgeting (ZBB)</h3>
            <p class="leading-relaxed">
              <strong>When to use:</strong> Essential when you have aggressive financial milestones—such as eliminating high-interest credit card debt, building an emergency fund, or investing heavily. In a zero-based budget, <em>Income minus All Outflows equals exactly Zero</em>. Every single dollar is assigned a job before the month starts.
            </p>
            <p class="text-xs text-[#737373]">
              Explore our <a href="/zero-based-budget/" class="text-[#171717] font-medium underline hover:text-[#0070f3]">Zero-Based Budget Tool</a> to allocate every dollar without leaving unassigned cash balances that vanish into mindless spending.
            </p>
          </div>

          <div class="p-6 rounded-[12px] bg-[#fafafa] border border-[#ebebeb] space-y-3">
            <h3 class="text-lg font-semibold text-[#171717]">Student & Household Spreadsheets</h3>
            <p class="leading-relaxed">
              <strong>When to use:</strong> Tailored for specific life phases. Student templates account for fluctuating semester expenses, loan disbursements, and textbooks. Household templates provide shared line items for rent, childcare, and groceries while respecting individual personal discretionary allowances.
            </p>
            <p class="text-xs text-[#737373]">
              Download customized layouts directly from our <a href="/budget-planner-template/" class="text-[#171717] font-medium underline hover:text-[#0070f3]">Free Budget Planner Templates Hub</a> with instant CSV and spreadsheet formats.
            </p>
          </div>
        </div>
      </div>

      <!-- Section 3: Decision Framework -->
      <div class="max-w-4xl mx-auto space-y-6">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.02em] text-[#171717]">
          How to Choose the Right Budget Template
        </h2>
        <div class="space-y-4 text-sm sm:text-base text-[#4d4d4d] leading-relaxed">
          <p>
            Choosing the most effective template depends on your financial personality, the complexity of your cash flow, and how much time you want to spend maintaining your records:
          </p>
          <ul class="list-disc pl-5 space-y-2 text-sm text-[#4d4d4d]">
            <li>
              <strong>If you are completely new to budgeting:</strong> Start with the <strong>Simple Monthly Template</strong> or <strong>50/30/20 Template</strong>. These introduce foundational habits without overwhelming you with micro-categories.
            </li>
            <li>
              <strong>If you are tackling debt or saving for a house down payment:</strong> Choose the <strong>Zero-Based Budget Template</strong>. The discipline of giving every dollar a defined destination prevents surplus cash from slipping away untracked.
            </li>
            <li>
              <strong>If you have fluctuating or freelance income:</strong> Base your template calculations on your lowest typical monthly income over the past six months, treating any additional earnings as a bonus buffer toward savings or debt payoff.
            </li>
            <li>
              <strong>If you share expenses with a partner:</strong> Use the <strong>Couples & Household Template</strong> to maintain clarity on shared obligations like rent and groceries while keeping personal spending stress-free.
            </li>
          </ul>
        </div>
      </div>

      <!-- Section 4: Connecting Templates with Online Tools -->
      <div class="max-w-4xl mx-auto p-8 rounded-[12px] bg-[#fafafa] border border-[#ebebeb] space-y-5">
        <h3 class="text-xl font-semibold text-[#171717]">
          Online Interactive Planners vs. Downloadable Spreadsheets
        </h3>
        <p class="text-sm text-[#4d4d4d] leading-relaxed">
          Spreadsheet templates and web-based calculators fulfill complementary roles in personal finance:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-[#4d4d4d]">
          <div class="bg-white p-4 rounded-[8px] border border-[#ebebeb] space-y-2">
            <h4 class="font-semibold text-[#171717]">Interactive Web Planners</h4>
            <p>
              Ideal for quick scenario testing, real-time frequency conversions (converting weekly, bi-weekly, or quarterly bills into standardized monthly figures), and zero-friction calculation right in your browser. All numbers are saved privately to your local browser storage.
            </p>
          </div>
          <div class="bg-white p-4 rounded-[8px] border border-[#ebebeb] space-y-2">
            <h4 class="font-semibold text-[#171717]">Spreadsheet Templates</h4>
            <p>
              Ideal for multi-year historical archives, offline record-keeping, and deeply personalized customizations in Microsoft Excel or Google Sheets. Visit our <a href="/budget-planner-template/" class="text-[#171717] font-medium underline hover:text-[#0070f3]">Budget Planner Template download page</a> to grab your files.
            </p>
          </div>
        </div>
        <div class="pt-2 flex flex-wrap gap-3">
          <a href="/budget-planner/" class="inline-flex items-center justify-center h-9 px-4 rounded-full bg-[#171717] text-white text-xs font-medium hover:bg-neutral-800 transition">
            Launch Online Budget Planner
          </a>
          <a href="/learn/" class="inline-flex items-center justify-center h-9 px-4 rounded-full bg-white text-[#171717] border border-[#ebebeb] text-xs font-medium hover:bg-neutral-50 transition shadow-whisper">
            Read Budgeting Guides
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
