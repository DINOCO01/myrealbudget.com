---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { BUDGET_TEMPLATES } from '../data/templatesData';

const title = 'Free Budget Planner Templates: Excel, Sheets & Printable CSV';
const description = 'Download free budget planner templates for Excel, Google Sheets, and CSV. Choose from 50/30/20, Zero-Based, Simple Monthly, Student, and Couples household budget templates.';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Are these budget planner templates free to download?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, all budget planner templates on My Real Budget are 100% free with no email registration, account creation, or payment required. You can download the CSV files instantly or import them into Google Sheets and Microsoft Excel.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I open a CSV budget template in Google Sheets?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Download the CSV template, open Google Sheets, click File > Import > Upload, and select the downloaded CSV file. It will automatically populate the structured rows and categories.',
      },
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={faqSchema}>
  <!-- HERO INTRO -->
  <section class="border-b border-[#ebebeb] bg-white pt-12 pb-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <Eyebrow text="Free Spreadsheets & Worksheets" />
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-[-0.03em] text-[#171717] leading-tight">
          Budget Planner Templates
        </h1>
        <p class="text-base sm:text-lg text-[#4d4d4d] leading-relaxed">
          Clean, purpose-built budget planner templates for Google Sheets, Microsoft Excel, and printable use. Download directly with zero paywalls or account sign-ups.
        </p>
      </div>

      <!-- Quick Nav Strip -->
      <div class="mt-8 pt-6 border-t border-[#f2f2f2] flex flex-wrap items-center gap-2 text-xs">
        <span class="text-[#8f8f8f] font-mono mr-2">Quick Jump:</span>
        {BUDGET_TEMPLATES.map(t => (
          <a href={`#${t.id}`} class="px-3 py-1.5 rounded-full bg-[#f2f2f2] text-[#4d4d4d] hover:text-[#171717] hover:bg-[#ebebeb] transition">
            {t.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- TEMPLATES DIRECTORY & INSTANT DOWNLOADS -->
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-12 space-y-16">
    
    <!-- Introduction: What is a budget template -->
    <div class="max-w-3xl space-y-4">
      <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717]">
        Why Use a Pre-Formatted Budget Template?
      </h2>
      <p class="text-sm text-[#4d4d4d] leading-relaxed">
        Starting a budget on a blank spreadsheet often causes decision fatigue: which categories should you track? How do you organize annual insurance or weekly groceries? Our templates solve this by providing pre-structured line items, categories, and practical starting layouts tailored to specific budgeting methodologies.
      </p>
    </div>

    <!-- Template Cards -->
    <div class="space-y-12">
      {BUDGET_TEMPLATES.map((template, idx) => (
        <article
          id={template.id}
          class="bg-white rounded-[12px] border border-[#ebebeb] p-6 sm:p-8 shadow-whisper scroll-mt-24 space-y-6"
        >
          <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 pb-6 border-b border-[#ebebeb]">
            <div class="space-y-2 max-w-2xl">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs font-semibold px-2.5 py-0.5 rounded-[6px] bg-[#f2f2f2] text-[#171717]">
                  Template #{idx + 1}
                </span>
                <span class="text-xs font-mono text-[#8f8f8f]">Method: {template.method}</span>
              </div>
              <h3 class="text-2xl font-semibold text-[#171717] tracking-tight">
                {template.name}
              </h3>
              <p class="text-sm text-[#4d4d4d] leading-relaxed">
                {template.fullDescription}
              </p>
            </div>

            <!-- Download Action Button -->
            <div class="shrink-0 flex flex-col sm:flex-row md:flex-col gap-2.5">
              <button
                type="button"
                data-template-id={template.id}
                class="btn-download-template inline-flex items-center justify-center gap-2 h-10 px-5 rounded-full bg-[#171717] text-white text-xs font-medium hover:bg-neutral-800 transition shadow-sm"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Download CSV
              </button>
              <a
                href={template.methodSlug}
                class="inline-flex items-center justify-center h-10 px-5 rounded-full bg-white text-[#171717] border border-[#ebebeb] text-xs font-medium hover:bg-neutral-50 transition shadow-whisper text-center"
              >
                Use Interactive Tool
              </a>
            </div>
          </div>

          <!-- Template Details Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
            <div class="space-y-2">
              <h4 class="font-mono font-medium uppercase tracking-wider text-[#8f8f8f]">
                Best For & Target Audience
              </h4>
              <p class="text-[#4d4d4d] leading-relaxed">
                {template.targetAudience}
              </p>
            </div>

            <div class="space-y-2">
              <h4 class="font-mono font-medium uppercase tracking-wider text-[#8f8f8f]">
                Template Structure & Highlights
              </h4>
              <ul class="space-y-1.5 text-[#4d4d4d]">
                {template.features.map(f => (
                  <li class="flex items-center gap-2">
                    <svg class="w-3.5 h-3.5 text-[#047857]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Raw CSV Code Preview Block from DESIGN.md -->
          <div class="space-y-2 pt-2">
            <div class="flex items-center justify-between text-xs text-[#8f8f8f] font-mono">
              <span>Preview (CSV Header & Top Rows)</span>
              <span>Formatted for Excel / Google Sheets</span>
            </div>
            <pre class="p-4 rounded-[8px] bg-[#fafafa] border border-[#ebebeb] font-mono text-xs text-[#171717] overflow-x-auto leading-relaxed">{template.csvContent.split('\n').slice(0, 6).join('\n') + '\n...'}</pre>
          </div>
        </article>
      ))}
    </div>

    <!-- HOW TO IMPORT IN GOOGLE SHEETS & EXCEL -->
    <section class="border-t border-[#ebebeb] pt-12 space-y-6">
      <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717]">
        How to Use These Templates in Excel or Google Sheets
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-[#4d4d4d]">
        <div class="p-5 rounded-[12px] bg-white border border-[#ebebeb] shadow-whisper space-y-2">
          <h3 class="font-semibold text-sm text-[#171717]">Opening in Google Sheets</h3>
          <ol class="space-y-1.5 list-decimal list-inside leading-relaxed text-[#4d4d4d]">
            <li>Click <strong>Download CSV</strong> on any template above.</li>
            <li>Go to <a href="https://sheets.new" target="_blank" rel="noopener" class="text-[#0070f3] underline">sheets.new</a> in your browser.</li>
            <li>Click <strong>File &gt; Import &gt; Upload</strong> and choose the downloaded file.</li>
            <li>Select <strong>Replace current sheet</strong> and click <em>Import data</em>.</li>
          </ol>
        </div>

        <div class="p-5 rounded-[12px] bg-white border border-[#ebebeb] shadow-whisper space-y-2">
          <h3 class="font-semibold text-sm text-[#171717]">Opening in Microsoft Excel</h3>
          <ol class="space-y-1.5 list-decimal list-inside leading-relaxed text-[#4d4d4d]">
            <li>Download the desired template CSV file.</li>
            <li>Open Excel and click <strong>File &gt; Open</strong>.</li>
            <li>Select the downloaded <code>.csv</code> file.</li>
            <li>Format the currency columns as Currency ($) and save as <code>.xlsx</code> to preserve custom formulas.</li>
          </ol>
        </div>
      </div>
    </section>

    <!-- FAQs -->
    <section class="border-t border-[#ebebeb] pt-12 space-y-6">
      <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717]">
        Frequently Asked Questions About Budget Templates
      </h2>
      <div class="space-y-4 text-xs">
        <div class="p-4 rounded-[8px] bg-white border border-[#ebebeb] space-y-1.5">
          <h3 class="font-semibold text-sm text-[#171717]">Can I print these budget templates?</h3>
          <p class="text-[#4d4d4d] leading-relaxed">
            Yes. When imported into Google Sheets or Excel, the layouts are formatted to fit cleanly on standard Letter or A4 paper. You can also export directly to PDF for offline tracking.
          </p>
        </div>
        <div class="p-4 rounded-[8px] bg-white border border-[#ebebeb] space-y-1.5">
          <h3 class="font-semibold text-sm text-[#171717]">Do I need to pay or provide an email to download?</h3>
          <p class="text-[#4d4d4d] leading-relaxed">
            No. All templates on My Real Budget are completely free, open, and instant. We believe practical personal finance tools should be accessible to everyone without friction.
          </p>
        </div>
      </div>
    </section>

    <!-- Cross-Linking -->
    <div class="pt-8 border-t border-[#ebebeb] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#8f8f8f]">
      <span>Prefer an interactive budgeting tool?</span>
      <div class="flex items-center gap-3">
        <a href="/budget-planner/" class="text-[#171717] font-medium underline hover:text-[#0070f3]">General Budget Planner →</a>
        <a href="/50-30-20-budget/" class="text-[#171717] font-medium underline hover:text-[#0070f3]">50/30/20 Planner →</a>
        <a href="/zero-based-budget/" class="text-[#171717] font-medium underline hover:text-[#0070f3]">Zero-Based Tool →</a>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
(function() {
  const templates = {
    '50-30-20-template': {
      filename: '50-30-20-budget-template.csv',
      content: `Category,Type,Planned Monthly Amount,Actual Amount,Variance
Primary Salary,Income,5000,5000,0
Additional Income,Income,0,0,0
Rent/Mortgage,Needs (50%),1500,1500,0
Groceries & Essentials,Needs (50%),450,420,-30
Utilities & Bills,Needs (50%),250,260,+10
Transportation & Gas,Needs (50%),300,290,-10
Health & Auto Insurance,Needs (50%),200,200,0
Dining & Social,Wants (30%),400,450,+50
Entertainment & Streaming,Wants (30%),150,150,0
Shopping & Personal,Wants (30%),200,180,-20
Travel & Leisure,Wants (30%),250,200,-50
Emergency Fund,Savings (20%),500,500,0
Retirement / IRA,Savings (20%),300,300,0
Extra Debt Payoff,Savings (20%),200,200,0`,
    },
    'zero-based-template': {
      filename: 'zero-based-budget-template.csv',
      content: `Category,Allocation Category,Planned Allocation,Actual Spent,Status
Income,Primary Paycheck,4500,4500,Funded
Income,Side Hustle / Extra,500,500,Funded
Housing,Rent or Mortgage,1400,1400,Paid
Housing,Utilities (Electric/Water/Gas),220,215,Paid
Living,Groceries,500,485,Active
Living,Transportation & Gas,250,260,Active
Protection,Insurances (Auto/Health/Renters),230,230,Paid
Debt,Student Loans (Minimum + Extra),450,450,Paid
Debt,Credit Card Balance Payoff,300,300,Paid
Savings,Emergency Buffer,400,400,Saved
Savings,Roth IRA Retirement,500,500,Invested
Lifestyle,Dining & Entertainment,250,260,Active
Lifestyle,Subscriptions,50,50,Paid
Buffer,Miscellaneous Cushion,150,100,Active`,
    },
    'simple-monthly-template': {
      filename: 'simple-monthly-budget-template.csv',
      content: `Section,Item Name,Frequency,Entered Amount,Normalized Monthly
Income,Net Paycheck,Monthly,4200,4200
Expenses,Rent or Mortgage,Monthly,1350,1350
Expenses,Electric & Water,Monthly,160,160
Expenses,Internet & Mobile,Monthly,130,130
Expenses,Groceries,Weekly,125,541.67
Expenses,Car Payment,Monthly,290,290
Expenses,Auto Insurance,Yearly,1200,100
Expenses,Streaming & Subscriptions,Monthly,45,45
Expenses,Dining & Leisure,Monthly,250,250
Expenses,Student Loan,Monthly,175,175
Expenses,Savings Transfer,Monthly,400,400
Summary,Net Monthly Surplus,,,$758.33`,
    },
    'student-template': {
      filename: 'student-budget-template.csv',
      content: `Term Category,Item,Frequency,Amount,Monthly Equivalent
Income,Part-time Campus Job,Weekly,220,953.33
Income,Stipend / Aid Disbursement,Quarterly,1500,500
Expense,Shared Rent (Room),Monthly,650,650
Expense,Campus Meal Plan / Groceries,Monthly,280,280
Expense,Textbooks & Class Fees,Quarterly,300,100
Expense,Public Transit Pass,Monthly,45,45
Expense,Phone Service,Monthly,40,40
Expense,Social & Club Dues,Monthly,60,60
Expense,Emergency Cushion,Monthly,50,50
Summary,Net Student Balance,,,$228.33`,
    },
    'household-couples-template': {
      filename: 'household-couples-budget-template.csv',
      content: `Contributor,Category / Line Item,Frequency,Amount,Monthly Equivalent
Partner 1,Salary Take-Home,Monthly,4500,4500
Partner 2,Salary Take-Home,Monthly,3800,3800
Joint,Mortgage / Rent,Monthly,2100,2100
Joint,Homeowners Insurance & Tax,Yearly,2400,200
Joint,Household Groceries,Weekly,220,953.33
Joint,Family Utilities & High-Speed Web,Monthly,320,320
Joint,Childcare / Activities,Monthly,650,650
Joint,Family Health & Medical,Monthly,180,180
Joint,Shared Emergency Fund,Monthly,600,600
Partner 1,Individual Personal Allowance,Monthly,250,250
Partner 2,Individual Personal Allowance,Monthly,250,250
Joint,Vacation & Home Improvement Fund,Monthly,400,400
Summary,Total Household Surplus,,,$2396.67`,
    },
  };

  document.querySelectorAll('.btn-download-template').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-template-id');
      const item = templates[id];
      if (!item) return;

      const blob = new Blob([item.content], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = item.filename;
      a.click();
      URL.revokeObjectURL(url);
    });
  });
})();
</script>
