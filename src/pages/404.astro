---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';

const title = 'Page Not Found (404) | My Real Budget';
const description = 'The page you requested could not be found. Return to My Real Budget to access our free budget planners, 50/30/20 calculator, and spreadsheet templates.';
---

<Layout title={title} description={description} noIndex={true}>
  <div class="min-h-[70vh] flex items-center justify-center py-16 sm:py-24 px-4 sm:px-6">
    <div class="max-w-2xl w-full text-center space-y-8">
      <!-- Status Badge & Icon -->
      <div class="space-y-4">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-[14px] bg-[#f4f0ea] dark:bg-[#172033] border border-[#e5e0d8] dark:border-[#1e293b] text-[#0e6e55] dark:text-[#10b981] mx-auto shadow-whisper">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>

        <Eyebrow text="Error 404 • Page Not Found" tKey="error.404_eyebrow" class="mx-auto" />

        <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.035em] text-[#0f172a] dark:text-[#f8fafc] leading-[1.15]" data-mrb-t="error.404_title">
          This Page Isn't in the Budget
        </h1>

        <p class="text-base sm:text-lg text-[#475569] dark:text-[#94a3b8] leading-relaxed max-w-lg mx-auto" data-mrb-t="error.404_desc">
          The link you followed may be outdated, or the address may have been mistyped. Rest assured, your saved budget calculations on your device remain safe.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 h-11 px-7 rounded-full bg-[#0e6e55] hover:bg-[#0a5240] dark:bg-[#10b981] dark:hover:bg-[#34d399] text-white dark:text-[#042f24] text-sm font-medium transition shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span data-mrb-t="error.return_home">Return to Home</span>
        </a>

        <a
          href="/budget-planner/"
          class="inline-flex items-center justify-center gap-2 h-11 px-7 rounded-full bg-white dark:bg-[#111827] text-[#0f172a] dark:text-[#f8fafc] border border-[#e5e0d8] dark:border-[#1e293b] text-sm font-medium hover:bg-[#f8f7f4] dark:hover:bg-[#172033] transition shadow-whisper"
        >
          <span data-mrb-t="learn.open_planner">Open Budget Planner</span>
        </a>
      </div>

      <!-- Quick Helpful Destinations Grid -->
      <div class="pt-6 border-t border-[#e5e0d8] dark:border-[#1e293b]">
        <span class="block text-xs font-mono uppercase tracking-wider text-[#64748b] dark:text-[#94a3b8] mb-4" data-mrb-t="error.popular_destinations">
          Popular Destinations
        </span>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-left">
          <a
            href="/50-30-20-budget/"
            class="p-3.5 rounded-[10px] bg-white dark:bg-[#111827] border border-[#e5e0d8] dark:border-[#1e293b] hover:border-[#0e6e55] dark:hover:border-[#10b981] transition shadow-xs group"
          >
            <span class="text-xs font-semibold text-[#0f172a] dark:text-[#f8fafc] group-hover:text-[#0e6e55] dark:group-hover:text-[#10b981] block" data-mrb-t="error.destination_503020_title">
              50/30/20 Rule →
            </span>
            <span class="text-[11px] text-[#475569] dark:text-[#94a3b8]" data-mrb-t="error.destination_503020_desc">Calculate needs, wants & savings</span>
          </a>

          <a
            href="/zero-based-budget/"
            class="p-3.5 rounded-[10px] bg-white dark:bg-[#111827] border border-[#e5e0d8] dark:border-[#1e293b] hover:border-[#0e6e55] dark:hover:border-[#10b981] transition shadow-xs group"
          >
            <span class="text-xs font-semibold text-[#0f172a] dark:text-[#f8fafc] group-hover:text-[#0e6e55] dark:group-hover:text-[#10b981] block" data-mrb-t="error.destination_zbb_title">
              Zero-Based Budget →
            </span>
            <span class="text-[11px] text-[#475569] dark:text-[#94a3b8]" data-mrb-t="error.destination_zbb_desc">Assign every single dollar a job</span>
          </a>

          <a
            href="/budget-planner-template/"
            class="p-3.5 rounded-[10px] bg-white dark:bg-[#111827] border border-[#e5e0d8] dark:border-[#1e293b] hover:border-[#0e6e55] dark:hover:border-[#10b981] transition shadow-xs group"
          >
            <span class="text-xs font-semibold text-[#0f172a] dark:text-[#f8fafc] group-hover:text-[#0e6e55] dark:group-hover:text-[#10b981] block" data-mrb-t="error.destination_tmpl_title">
              Free Templates →
            </span>
            <span class="text-[11px] text-[#475569] dark:text-[#94a3b8]" data-mrb-t="error.destination_tmpl_desc">Google Sheets & Excel formats</span>
          </a>
        </div>
      </div>

      <!-- Need Help Note -->
      <p class="text-xs text-[#64748b] dark:text-[#94a3b8]" data-mrb-t-html="error.let_us_know">
        Think something should be here? <a href="/contact/" class="text-[#0e6e55] dark:text-[#10b981] underline">Let us know</a>.
      </p>
    </div>
  </div>
</Layout>
