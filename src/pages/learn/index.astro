---
import Layout from '../../layouts/Layout.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import { LEARN_ARTICLES } from '../../data/learnArticles';

const title = 'Learn Budgeting: Practical Cash Flow Guides & Strategies';
const description = 'Explore practical guides on budgeting fundamentals, how to build a monthly budget that balances, the 50/30/20 rule, and zero-based budgeting.';
---

<Layout title={title} description={description}>
  <!-- HEADER INTRO -->
  <section class="border-b border-[#ebebeb] bg-white pt-12 pb-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <Eyebrow text="Knowledge Center" />
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-[-0.03em] text-[#171717] leading-tight">
          Budgeting Learning Center
        </h1>
        <p class="text-base sm:text-lg text-[#4d4d4d] leading-relaxed">
          Clear, jargon-free guides to help you understand where your money goes, select the best budgeting method, and build sustainable financial habits.
        </p>
      </div>
    </div>
  </section>

  <!-- ARTICLES LIST -->
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {LEARN_ARTICLES.map((article) => (
        <article class="bg-white rounded-[12px] border border-[#ebebeb] p-6 shadow-whisper flex flex-col justify-between hover:border-[#a1a1a1] transition group">
          <div class="space-y-3">
            <div class="flex items-center justify-between text-xs text-[#8f8f8f] font-mono">
              <span class="px-2 py-0.5 rounded-[4px] bg-[#f2f2f2] text-[#4d4d4d]">{article.category}</span>
              <span>{article.readTime}</span>
            </div>

            <h2 class="text-lg font-semibold text-[#171717] tracking-tight leading-snug group-hover:text-[#0070f3] transition-colors">
              <a href={`/learn/${article.slug}/`}>
                {article.title}
              </a>
            </h2>

            <p class="text-xs text-[#4d4d4d] leading-relaxed">
              {article.summary}
            </p>
          </div>

          <div class="pt-6 border-t border-[#f2f2f2] mt-6">
            <a
              href={`/learn/${article.slug}/`}
              class="text-xs font-medium text-[#171717] group-hover:text-[#0070f3] inline-flex items-center gap-1.5 transition-colors"
            >
              Read Full Guide
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Interactive Tools Callout -->
    <section class="mt-16 p-8 rounded-[12px] bg-[#fafafa] border border-[#ebebeb] text-center max-w-2xl mx-auto space-y-4">
      <Eyebrow text="Put Knowledge Into Practice" class="mx-auto" />
      <h3 class="text-xl font-semibold text-[#171717]">Ready to plan your numbers?</h3>
      <p class="text-xs text-[#4d4d4d]">
        Reading guides is helpful, but seeing your real cash flow numbers in an interactive tool creates immediate clarity.
      </p>
      <div class="pt-2 flex flex-wrap justify-center gap-3">
        <a href="/budget-planner/" class="inline-flex items-center justify-center h-10 px-6 rounded-full bg-[#171717] text-white text-xs font-medium hover:bg-neutral-800 transition">
          Open Budget Planner
        </a>
        <a href="/50-30-20-budget/" class="inline-flex items-center justify-center h-10 px-6 rounded-full bg-white text-[#171717] border border-[#ebebeb] text-xs font-medium hover:bg-neutral-50 transition shadow-whisper">
          50/30/20 Budget
        </a>
        <a href="/zero-based-budget/" class="inline-flex items-center justify-center h-10 px-6 rounded-full bg-white text-[#171717] border border-[#ebebeb] text-xs font-medium hover:bg-neutral-50 transition shadow-whisper">
          Zero-Based Budget
        </a>
      </div>
    </section>
  </main>
</Layout>
