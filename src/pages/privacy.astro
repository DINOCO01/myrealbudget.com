---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';

const title = 'Privacy Policy | My Real Budget — 100% Private & Local';
const description = 'Read the My Real Budget privacy policy. We protect your financial privacy through local browser storage, zero bank account linking, and no data selling.';
const canonical = 'https://myrealbudget.com/privacy/';

const privacySchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy Policy',
  url: canonical,
  description: description,
  publisher: {
    '@type': 'Organization',
    name: 'My Real Budget',
    url: 'https://myrealbudget.com/',
    logo: 'https://myrealbudget.com/favicon.svg',
  },
};
---

<Layout title={title} description={description} canonical={canonical} jsonLd={privacySchema}>
  <!-- HERO INTRO -->
  <section class="border-b border-[#e5e0d8] dark:border-[#1e293b] bg-[#faf8f5] dark:bg-[#0b1220] py-14 sm:py-20 transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="space-y-4">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs font-mono text-[#64748b] dark:text-[#94a3b8]" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[#0e6e55] dark:hover:text-[#10b981] transition-colors" data-mrb-t="error.home_breadcrumb">Home</a>
          <span aria-hidden="true">/</span>
          <span class="text-[#0f172a] dark:text-[#f8fafc] font-medium" data-mrb-t="privacy.breadcrumb">Privacy Policy</span>
        </nav>

        <Eyebrow text="Transparency & Security" tKey="privacy.eyebrow" />

        <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.035em] text-[#0f172a] dark:text-[#f8fafc] leading-[1.15]" data-mrb-t="privacy.h1">
          Privacy Policy
        </h1>

        <p class="text-sm font-mono text-[#64748b] dark:text-[#94a3b8]" data-mrb-t="privacy.updated">
          Last Updated: October 2026 • Effective Date: October 2026
        </p>

        <p class="text-base sm:text-lg text-[#475569] dark:text-[#94a3b8] leading-relaxed max-w-2xl" data-mrb-t-html="privacy.hero_p">
          At <strong>My Real Budget</strong> (accessible at <a href="https://myrealbudget.com" class="text-[#0e6e55] dark:text-[#10b981] underline">myrealbudget.com</a>), your financial privacy is our foundational commitment. We believe your personal money calculations should remain yours alone.
        </p>
      </div>
    </div>
  </section>

  <!-- MAIN BODY -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-12">
    <!-- HIGHLIGHT SUMMARY BOX -->
    <div class="bg-white dark:bg-[#111827] rounded-[16px] border border-[#e5e0d8] dark:border-[#1e293b] p-6 sm:p-8 shadow-whisper space-y-4">
      <div class="flex items-center gap-2 text-[#0e6e55] dark:text-[#10b981]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <h2 class="text-base font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="privacy.hl_title">
          Privacy at a Glance
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs text-[#475569] dark:text-[#94a3b8]">
        <div class="p-3.5 rounded-[10px] bg-[#f8f7f4] dark:bg-[#172033] border border-[#e5e0d8] dark:border-[#1e293b] space-y-1">
          <strong class="text-[#0f172a] dark:text-[#f8fafc] block" data-mrb-t="privacy.hl_b1_title">100% Local Storage:</strong>
          <span data-mrb-t="privacy.hl_b1_desc">Your income and expense numbers are processed and saved solely within your device's browser localStorage.</span>
        </div>
        <div class="p-3.5 rounded-[10px] bg-[#f8f7f4] dark:bg-[#172033] border border-[#e5e0d8] dark:border-[#1e293b] space-y-1">
          <strong class="text-[#0f172a] dark:text-[#f8fafc] block" data-mrb-t="privacy.hl_b2_title">No Account Required:</strong>
          <span data-mrb-t="privacy.hl_b2_desc">You never need to provide passwords, financial account credentials, or connect bank feeds.</span>
        </div>
        <div class="p-3.5 rounded-[10px] bg-[#f8f7f4] dark:bg-[#172033] border border-[#e5e0d8] dark:border-[#1e293b] space-y-1">
          <strong class="text-[#0f172a] dark:text-[#f8fafc] block" data-mrb-t="privacy.hl_b3_title">Zero Data Selling:</strong>
          <span data-mrb-t="privacy.hl_b3_desc">We do not sell, rent, monetize, or broker personal financial data under any circumstance.</span>
        </div>
      </div>
    </div>

    <!-- DETAILED SECTIONS -->
    <article class="prose max-w-none text-sm text-[#475569] dark:text-[#94a3b8] space-y-10 leading-relaxed">
      <!-- Section 1 -->
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="privacy.s1_title">
          1. Local Storage Architecture
        </h2>
        <p data-mrb-t="privacy.s1_p">
          All calculations within our General Budget Planner, 50/30/20 Calculator, and Zero-Based Planner take place entirely on the client side. Data saved into localStorage remains strictly on your device.
        </p>
      </section>

      <!-- Section 2 -->
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="privacy.s2_title">
          2. Information We Do Not Collect
        </h2>
        <p data-mrb-t="privacy.s2_p">
          We do not collect banking credentials, account balances, credit card details, government identification numbers, or precise geo-location data.
        </p>
      </section>

      <!-- Section 3 -->
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="privacy.s3_title">
          3. Information We May Process
        </h2>
        <p data-mrb-t="privacy.s3_p">
          When you voluntarily send a message through our contact form, we process your name, email address, and message text solely to respond to your request.
        </p>
      </section>

      <!-- Section 4 -->
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="privacy.s4_title">
          4. Analytics & Cookies
        </h2>
        <p data-mrb-t="privacy.s4_p">
          We employ minimal, privacy-respecting aggregate analytics to assess aggregate website traffic and page performance without profiling individual users.
        </p>
      </section>

      <!-- Section 5 -->
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="privacy.s5_title">
          5. Your Rights and Data Deletion
        </h2>
        <p data-mrb-t="privacy.s5_p">
          You can wipe all saved budget data at any time simply by clearing your browser cache and localStorage, or by using the in-app "Reset Defaults" buttons.
        </p>
      </section>

      <!-- Section 6 -->
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="privacy.s6_title">
          6. Contact for Privacy Concerns
        </h2>
        <p data-mrb-t="privacy.s6_p">
          If you have questions regarding this Privacy Policy, please email us at privacy@myrealbudget.com.
        </p>
      </section>
    </article>
  </div>
</Layout>
