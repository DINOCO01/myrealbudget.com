---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import FiftyThirtyTwentyPlanner from '../components/planners/FiftyThirtyTwentyPlanner.astro';
import { formatCurrency } from '../utils/currency';

const title = '50/30/20 Budget Rule: Calculator, Examples & Practical Guide';
const description = 'Calculate your Needs (50%), Wants (30%), and Savings (20%) targets with our free interactive planner. See real income examples and balance your monthly budget.';

const incomeExamples = [
  { income: 3000, needs: 1500, wants: 900, savings: 600 },
  { income: 5000, needs: 2500, wants: 1500, savings: 1000 },
  { income: 7500, needs: 3750, wants: 2250, savings: 1500 },
  { income: 10000, needs: 5000, wants: 3000, savings: 2000 },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the 50/30/20 budget rule?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The 50/30/20 budget is an intuitive personal finance rule popularized by Senator Elizabeth Warren. It allocates after-tax income into three buckets: 50% for essential needs, 30% for personal wants, and 20% for savings and extra debt repayment.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is the 50/30/20 rule realistic in high-cost-of-living areas?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'In cities where rent or mortgages are exceptionally high, needs may naturally take up 55% to 65% of net income. The framework is meant to be adaptable—users in expensive areas often adjust to a 60/25/15 or 60/20/20 ratio while keeping their total spending balanced.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do minimum debt payments count as Needs or Savings?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Minimum debt payments (such as student loans or minimum credit card payments) count as essential Needs because skipping them damages your credit score. Any extra principal payments above the minimum count toward the 20% Savings & Debt bucket.',
      },
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={faqSchema}>
  <!-- HEADER INTRO -->
  <section class="border-b border-[#ebebeb] bg-white pt-8 pb-10 sm:pt-12 sm:pb-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <Eyebrow text="Budgeting Framework" tKey="f3020.eyebrow" />
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-[-0.03em] text-[#171717] leading-tight" data-mrb-t="f3020.heading">
          The 50/30/20 Budget Rule
        </h1>
        <p class="text-base sm:text-lg text-[#4d4d4d] leading-relaxed" data-mrb-t="f3020.subtitle">
          A clear, percentage-based framework designed to balance living essentials, personal enjoyment, and financial security without micro-managing every transaction.
        </p>
      </div>

      <!-- Budgeting Method Switcher Bar -->
      <div class="mt-6 sm:mt-8 pt-4 sm:pt-6 border-t border-[#f2f2f2] flex flex-wrap items-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs">
        <span class="text-[#8f8f8f] font-mono mr-1 sm:mr-2" data-mrb-t="common.method">Budgeting Method:</span>
        <a href="/budget-planner/" class="px-3 py-1.5 rounded-full bg-[#f2f2f2] text-[#4d4d4d] hover:text-[#171717] hover:bg-[#ebebeb] transition" data-mrb-t="common.general_budget">
          General Budget
        </a>
        <span class="px-3 py-1.5 rounded-full bg-[#171717] text-white font-medium" data-mrb-t="common.f3020_method">50/30/20 Method</span>
        <a href="/zero-based-budget/" class="px-3 py-1.5 rounded-full bg-[#f2f2f2] text-[#4d4d4d] hover:text-[#171717] hover:bg-[#ebebeb] transition" data-mrb-t="common.zero_based_method">
          Zero-Based Method
        </a>
        <a href="/budget-planner-template/" class="px-3 py-1.5 rounded-full bg-[#f2f2f2] text-[#4d4d4d] hover:text-[#171717] hover:bg-[#ebebeb] transition" data-mrb-t="common.spreadsheet_templates">
          Spreadsheet Templates
        </a>
      </div>
    </div>
  </section>

  <!-- INTERACTIVE PLANNER ISLAND -->
  <main class="max-w-6xl mx-auto px-3.5 sm:px-6 py-6 sm:py-12">
    <div class="mb-6 sm:mb-10 text-center max-w-2xl mx-auto space-y-2">
      <Eyebrow text="Interactive Calculator" tKey="f3020.calc_eyebrow" class="mx-auto" />
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717]" data-mrb-t="f3020.calc_title">
        Interactive 50/30/20 Planner & Target Comparison
      </h2>
      <p class="text-xs sm:text-sm text-[#4d4d4d]" data-mrb-t="f3020.calc_desc">
        Enter your net income to generate automatic benchmark targets, then plug in your actual items to see how closely your real spending aligns.
      </p>
    </div>

    <FiftyThirtyTwentyPlanner />
  </main>

  <!-- COMPREHENSIVE EDUCATIONAL BREAKDOWN (SEO Clustered Content) -->
  <section class="border-t border-[#ebebeb] bg-white py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-16">
      
      <!-- 1. What is the 50/30/20 Rule -->
      <div class="space-y-4">
        <Eyebrow text="The Breakdown" tKey="f3020.breakdown_eyebrow" />
        <h2 class="text-2xl font-semibold tracking-tight text-[#171717]" data-mrb-t="f3020.what_is_title">
          What Is the 50/30/20 Budget?
        </h2>
        <p class="text-sm text-[#4d4d4d] leading-relaxed" data-mrb-t-html="f3020.what_is_p1">
          Popularized by bankruptcy expert and Harvard law professor Elizabeth Warren in her book <em>All Your Worth: The Ultimate Lifetime Money Plan</em>, the 50/30/20 rule divides your <strong>after-tax, take-home pay</strong> into three intentional categories.
        </p>
        <p class="text-sm text-[#4d4d4d] leading-relaxed" data-mrb-t="f3020.what_is_p2">
          Unlike restrictive diets that prohibit dining out or entertainment, the 50/30/20 model explicitly budgets for guilt-free personal spending, providing a straightforward framework for organizing essential spending, discretionary spending, and savings.
        </p>
      </div>

      <!-- 2. The Three Buckets in Detail -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Needs Card -->
        <div class="p-6 rounded-[12px] bg-[#fafafa] border border-[#ebebeb] space-y-3">
          <div class="flex items-center justify-between">
            <span class="w-8 h-8 rounded-full bg-[#171717] text-white flex items-center justify-center font-mono text-xs font-semibold">50%</span>
            <span class="font-mono text-xs text-[#8f8f8f]" data-mrb-t="f3020.needs_badge">Essential</span>
          </div>
          <h3 class="text-lg font-semibold text-[#171717]" data-mrb-t="f3020.needs_card_title">Needs</h3>
          <p class="text-xs text-[#4d4d4d] leading-relaxed" data-mrb-t="f3020.needs_card_desc">
            Expenses required to live and work. If you lost your job tomorrow, these would still be necessary.
          </p>
          <ul class="text-xs text-[#4d4d4d] space-y-1 pt-2 border-t border-[#ebebeb]">
            <li data-mrb-t="f3020.needs_i1">• Rent or mortgage & HOA fees</li>
            <li data-mrb-t="f3020.needs_i2">• Basic groceries & household goods</li>
            <li data-mrb-t="f3020.needs_i3">• Water, electricity & gas utilities</li>
            <li data-mrb-t="f3020.needs_i4">• Commuter transit & car insurance</li>
            <li data-mrb-t="f3020.needs_i5">• Healthcare co-pays & prescriptions</li>
            <li data-mrb-t="f3020.needs_i6">• Minimum required debt payments</li>
          </ul>
        </div>

        <!-- Wants Card -->
        <div class="p-6 rounded-[12px] bg-[#fafafa] border border-[#ebebeb] space-y-3">
          <div class="flex items-center justify-between">
            <span class="w-8 h-8 rounded-full bg-[#7928ca] text-white flex items-center justify-center font-mono text-xs font-semibold">30%</span>
            <span class="font-mono text-xs text-[#8f8f8f]" data-mrb-t="f3020.wants_badge">Lifestyle</span>
          </div>
          <h3 class="text-lg font-semibold text-[#171717]" data-mrb-t="f3020.wants_card_title">Wants</h3>
          <p class="text-xs text-[#4d4d4d] leading-relaxed" data-mrb-t="f3020.wants_card_desc">
            Discretionary choices that enhance quality of life but are not strictly mandatory for survival.
          </p>
          <ul class="text-xs text-[#4d4d4d] space-y-1 pt-2 border-t border-[#ebebeb]">
            <li data-mrb-t="f3020.wants_i1">• Restaurant meals, bars & takeaway</li>
            <li data-mrb-t="f3020.wants_i2">• Streaming services (Netflix, Spotify)</li>
            <li data-mrb-t="f3020.wants_i3">• Concerts, movies & sporting events</li>
            <li data-mrb-t="f3020.wants_i4">• Vacations, weekend trips & flights</li>
            <li data-mrb-t="f3020.wants_i5">• Non-essential clothing & shoes</li>
            <li data-mrb-t="f3020.wants_i6">• Hobbies, fitness clubs & gear</li>
          </ul>
        </div>

        <!-- Savings Card -->
        <div class="p-6 rounded-[12px] bg-[#fafafa] border border-[#ebebeb] space-y-3">
          <div class="flex items-center justify-between">
            <span class="w-8 h-8 rounded-full bg-[#0070f3] text-white flex items-center justify-center font-mono text-xs font-semibold">20%</span>
            <span class="font-mono text-xs text-[#8f8f8f]" data-mrb-t="f3020.savings_badge">Future</span>
          </div>
          <h3 class="text-lg font-semibold text-[#171717]" data-mrb-t="f3020.savings_card_title">Savings & Extra Debt</h3>
          <p class="text-xs text-[#4d4d4d] leading-relaxed" data-mrb-t="f3020.savings_card_desc">
            Investments in your future resilience and accelerated freedom from high-interest liabilities.
          </p>
          <ul class="text-xs text-[#4d4d4d] space-y-1 pt-2 border-t border-[#ebebeb]">
            <li data-mrb-t="f3020.savings_i1">• High-yield emergency buffer funds</li>
            <li data-mrb-t="f3020.savings_i2">• Roth IRA & brokerage investments</li>
            <li data-mrb-t="f3020.savings_i3">• Extra 401(k) retirement contributions</li>
            <li data-mrb-t="f3020.savings_i4">• Extra credit card / debt principal paydown</li>
            <li data-mrb-t="f3020.savings_i5">• Sinking funds for future home deposit</li>
          </ul>
        </div>

      </div>

      <!-- 3. Real Income Benchmark Table -->
      <div class="space-y-5">
        <Eyebrow text="Benchmarks" tKey="f3020.table_eyebrow" />
        <h2 class="text-2xl font-semibold tracking-tight text-[#171717]" data-mrb-t="f3020.table_title">
          Example 50/30/20 Budgets Across Different Incomes
        </h2>
        <p class="text-sm text-[#4d4d4d]" data-mrb-t="f3020.table_sub">
          Here is how the numbers break down across common monthly take-home pay thresholds:
        </p>

        <div class="overflow-x-auto rounded-[8px] border border-[#ebebeb]">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-[#fafafa] border-b border-[#ebebeb] text-[#8f8f8f] font-mono">
                <th class="p-3.5" data-mrb-t="f3020.net_monthly_income">Net Monthly Income</th>
                <th class="p-3.5" data-mrb-t="f3020.needs_title">Needs (50%)</th>
                <th class="p-3.5" data-mrb-t="f3020.wants_title">Wants (30%)</th>
                <th class="p-3.5" data-mrb-t="f3020.savings_title">Savings / Debt (20%)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#ebebeb] font-mono">
              {incomeExamples.map(row => (
                <tr class="hover:bg-[#fafafa]/60 transition">
                  <td class="p-3.5 font-semibold text-[#171717]" data-mrb-currency-val={row.income}>{formatCurrency(row.income)}</td>
                  <td class="p-3.5 text-[#171717]" data-mrb-currency-val={row.needs}>{formatCurrency(row.needs)}</td>
                  <td class="p-3.5 text-[#7928ca]" data-mrb-currency-val={row.wants}>{formatCurrency(row.wants)}</td>
                  <td class="p-3.5 text-[#0070f3]" data-mrb-currency-val={row.savings}>{formatCurrency(row.savings)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- 4. Not a Rigid Financial Law: Nuances & Adjustments -->
      <div class="p-6 rounded-[12px] bg-[#fafafa] border border-[#ebebeb] space-y-3">
        <h3 class="text-base font-semibold text-[#171717]" data-mrb-t="f3020.flexible_title">
          Important: 50/30/20 is a flexible guide, not a rigid law
        </h3>
        <p class="text-xs text-[#4d4d4d] leading-relaxed" data-mrb-t="f3020.flexible_p1">
          If you reside in New York, London, Toronto, or San Francisco, spending only 50% on needs may be temporarily impossible when modest rents alone claim 40% of net pay.
        </p>
        <p class="text-xs text-[#4d4d4d] leading-relaxed" data-mrb-t-html="f3020.flexible_p2">
          In those situations, adopt an honest ratio such as <strong>60/25/15</strong> or <strong>65/20/15</strong>. The purpose of the 50/30/20 rule is not perfection—it is providing a north-star benchmark so you can identify spending creep before it threatens your solvency.
        </p>
      </div>

      <!-- 5. FAQ Section -->
      <div class="space-y-6 pt-4 border-t border-[#ebebeb]">
        <h2 class="text-2xl font-semibold tracking-tight text-[#171717]" data-mrb-t="pagefaq.f3020.heading">
          Frequently Asked Questions About the 50/30/20 Rule
        </h2>
        <div class="space-y-4 text-xs">
          <div class="p-4 rounded-[8px] bg-[#fafafa] border border-[#ebebeb] space-y-1.5">
            <h3 class="font-semibold text-sm text-[#171717]" data-mrb-t="pagefaq.f3020.q1">Do I calculate percentages from gross or net income?</h3>
            <div class="text-[#4d4d4d] leading-relaxed" data-mrb-t-html="pagefaq.f3020.a1">
              <p>
                The 50/30/20 framework is calculated using <strong>net (after-tax) income</strong> rather than gross salary. You can approach this in one of two ways:
              </p>
              <ul class="space-y-1 text-[#4d4d4d] pl-3 list-disc mt-1">
                <li><strong>Take-home pay approach:</strong> Budget strictly from the net amount deposited into your checking account. Pre-tax deductions (like 401(k) contributions or health premiums) are already accounted for before you start.</li>
                <li><strong>Comprehensive income approach:</strong> Add voluntary paycheck deductions (such as retirement or health benefits) back to your take-home pay, and then list them explicitly under your Savings (retirement) and Needs (health coverage) categories.</li>
              </ul>
              <p class="text-[#4d4d4d] leading-relaxed pt-1">
                Either approach works well—the important part is picking one method and applying it consistently.
              </p>
            </div>
          </div>
          <div class="p-4 rounded-[8px] bg-[#fafafa] border border-[#ebebeb] space-y-1.5">
            <h3 class="font-semibold text-sm text-[#171717]" data-mrb-t="pagefaq.f3020.q2">What if my Needs exceed 50%?</h3>
            <p class="text-[#4d4d4d] leading-relaxed" data-mrb-t="pagefaq.f3020.a2">
              When essential living costs are high, temporarily reduce your Wants allocation rather than eliminating savings entirely. Maintaining an ongoing emergency savings cushion helps reduce the need to rely on high-interest credit cards when unexpected car or medical bills arise.
            </p>
          </div>
        </div>
      </div>

      <!-- 6. Template CTA & Interlinking -->
      <div class="p-6 rounded-[12px] bg-white border border-[#ebebeb] shadow-whisper flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <h3 class="font-semibold text-sm text-[#171717]" data-mrb-t="pagefaq.f3020.cta_title">Prefer a downloadable spreadsheet?</h3>
          <p class="text-xs text-[#8f8f8f]" data-mrb-t="pagefaq.f3020.cta_desc">Get our free 50/30/20 CSV template ready for Excel and Google Sheets.</p>
        </div>
        <a
          href="/budget-planner-template/#50-30-20-template"
          class="inline-flex items-center justify-center h-10 px-6 rounded-full bg-[#171717] text-white text-xs font-medium hover:bg-neutral-800 transition"
          data-mrb-t="pagefaq.f3020.cta_btn"
        >
          Download 50/30/20 Template
        </a>
      </div>

      <div class="pt-8 border-t border-[#ebebeb] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#8f8f8f]">
        <span data-mrb-t="f3020.other_methods_label">Explore other budgeting methodologies:</span>
        <div class="flex items-center gap-3">
          <a href="/zero-based-budget/" class="text-[#171717] font-medium underline hover:text-[#0070f3]" data-mrb-t="f3020.zbb_guide_link">Zero-Based Budget Guide →</a>
          <a href="/budget-planner/" class="text-[#171717] font-medium underline hover:text-[#0070f3]" data-mrb-t="f3020.gbp_link">General Budget Planner →</a>
          <a href="/learn/50-30-20-vs-zero-based-budget/" class="text-[#171717] font-medium underline hover:text-[#0070f3]" data-mrb-t="f3020.compare_link">50/30/20 vs Zero-Based →</a>
        </div>
      </div>

    </div>
  </section>
</Layout>
