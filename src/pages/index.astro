---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { BUDGET_TEMPLATES } from '../data/templatesData';
import { LEARN_ARTICLES } from '../data/learnArticles';
import { HOME_FAQS } from '../data/homeFaqs';

const title = 'Free Budget Planner: 50/30/20 & Zero-Based | My Real Budget';
const description = 'Plan your money with My Real Budget, an online budget planner for monthly budgets, the 50/30/20 rule, zero-based budgeting and budget templates.';
const canonical = 'https://myrealbudget.com/';
const ogTitle = 'Free Budget Planner: 50/30/20 & Zero-Based | My Real Budget';
const ogDescription = 'Plan your money with an online budget planner, 50/30/20 budgeting tools, zero-based budgeting and practical budget templates.';

const faqPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.question.en,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answerText.en,
    },
  })),
};
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  jsonLd={faqPageJsonLd}
>
  <!-- HERO SECTION WITH COMPACT EDITORIAL SPLIT LAYOUT -->
  <section class="relative pt-10 pb-14 sm:pt-14 sm:pb-18 border-b border-[#e5e0d8] dark:border-[#1e293b] bg-[#faf8f5] dark:bg-[#0b1220] transition-colors">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- LEFT: Hero Copy & Actions (7 cols on lg) -->
        <div class="lg:col-span-7 space-y-5 sm:space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-[#111827] border border-[#e5e0d8] dark:border-[#1e293b] text-xs font-mono font-medium text-[#475569] dark:text-[#94a3b8] shadow-whisper">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0e6e55] dark:bg-[#10b981]"></span>
            <span data-mrb-t="home.eyebrow">Practical Cash Flow Planning</span>
          </div>
          
          <h1 class="text-3xl sm:text-5xl md:text-[50px] font-semibold tracking-[-0.035em] text-[#0f172a] dark:text-[#f8fafc] leading-[1.14]" data-mrb-t-html="home.hero_title">
            Budget Planner for <br class="hidden sm:inline" />
            <span class="text-[#0e6e55] dark:text-[#10b981]">Real-Life Money Management</span>
          </h1>

          <p class="text-base sm:text-lg text-[#475569] dark:text-[#94a3b8] leading-relaxed max-w-xl font-normal" data-mrb-t="home.hero_p">
            Take command of your personal finances with an intuitive online budget planner designed for realistic cash flow. Model monthly income, balance needs and wants with the 50/30/20 rule, assign every dollar with zero-based budgeting, and download free customizable spreadsheet templates.
          </p>

          <!-- CTAs -->
          <div class="pt-1 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <a
              href="/budget-planner/"
              class="inline-flex items-center justify-center gap-2 h-12 px-7 rounded-full bg-[#0e6e55] hover:bg-[#0a5240] dark:bg-[#10b981] dark:hover:bg-[#34d399] text-white dark:text-[#042f24] text-[15px] font-medium transition shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0e6e55]/30"
            >
              <span data-mrb-t="nav.start_budget">Start Budget Planner</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="#methods"
              class="inline-flex items-center justify-center h-12 px-7 rounded-full bg-white dark:bg-[#111827] text-[#0f172a] dark:text-[#f8fafc] border border-[#e5e0d8] dark:border-[#1e293b] text-[15px] font-medium hover:bg-[#f4f0ea] dark:hover:bg-[#172033] transition shadow-whisper focus-visible:outline-none"
              data-mrb-t="home.explore_methods"
            >
              Explore Budget Methods
            </a>
          </div>

          <!-- Quick Trust Indicators (Outline-style, crisp) -->
          <div class="pt-2 flex flex-wrap items-center gap-y-2.5 gap-x-6 text-xs text-[#64748b] dark:text-[#94a3b8] font-mono">
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[#0e6e55] dark:text-[#10b981]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span data-mrb-t="common.no_account">No Account Needed</span>
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[#0e6e55] dark:text-[#10b981]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span data-mrb-t="common.private_local">100% Private & Local</span>
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[#0e6e55] dark:text-[#10b981]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span data-mrb-t="common.free_templates">Free Templates & Tools</span>
            </span>
          </div>
        </div>

        <!-- RIGHT: The Polished Budget-Preview Visual (5 cols on lg) -->
        <div class="lg:col-span-5 w-full">
          <div class="bg-white dark:bg-[#111827] rounded-[14px] border border-[#e5e0d8] dark:border-[#1e293b] p-5 sm:p-6 shadow-whisper relative transition-all">
            
            <!-- Interface Top Header -->
            <div class="flex items-center justify-between pb-3.5 mb-3.5 border-b border-[#e5e0d8] dark:border-[#1e293b]">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#0e6e55] dark:bg-[#10b981]"></span>
                <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-[#64748b] dark:text-[#94a3b8]" data-mrb-t="home.preview_title">
                  YOUR MONTHLY BUDGET
                </span>
              </div>
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[#e8f5f1] dark:bg-[rgba(16,185,129,0.15)] text-[#0e6e55] dark:text-[#10b981] font-mono text-[11px] font-medium border border-[#bbf0dd] dark:border-[rgba(16,185,129,0.25)]">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span data-mrb-t="summary.balanced">Balanced</span>
              </span>
            </div>

            <!-- Income Row -->
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-[#f4f0ea] dark:border-[#172033]">
              <div>
                <span class="text-[11px] font-medium text-[#64748b] dark:text-[#94a3b8] block" data-mrb-t="home.preview_takehome">Monthly Take-Home</span>
                <span class="text-sm font-semibold text-[#0f172a] dark:text-[#f8fafc]" data-mrb-t="home.preview_income">Income</span>
              </div>
              <div class="text-right">
                <span class="text-lg font-semibold font-mono text-[#0f172a] dark:text-[#f8fafc]" data-mrb-currency-val="5200">$5,200</span>
                <span class="text-[10px] text-[#64748b] dark:text-[#94a3b8] block font-mono" data-mrb-t="summary.available_pct">100% available</span>
              </div>
            </div>

            <!-- Allocation Multi-Segment Visual Bar -->
            <div class="mb-4 space-y-1.5">
              <div class="flex justify-between text-[11px] text-[#64748b] dark:text-[#94a3b8] font-mono">
                <span data-mrb-t="home.preview_distribution">Cash Distribution</span>
                <span data-mrb-t="home.preview_assigned">100% Assigned</span>
              </div>
              <div class="w-full h-2 rounded-full bg-[#f4f0ea] dark:bg-[#172033] overflow-hidden flex" aria-label="Monthly budget allocation chart showing 50% needs, 30% wants, 20% savings">
                <div class="h-full bg-[#0f172a] dark:bg-[#94a3b8]" style="width: 50%" title="Needs: 50%"></div>
                <div class="h-full bg-[#d97706] dark:bg-[#fbbf24]" style="width: 30%" title="Wants: 30%"></div>
                <div class="h-full bg-[#0e6e55] dark:bg-[#10b981]" style="width: 20%" title="Savings: 20%"></div>
              </div>
            </div>

            <!-- The 3 Core Buckets (Needs, Wants, Savings) with subtle indicators & mini progress bars -->
            <div class="space-y-2.5">
              
              <!-- Needs (50%) -->
              <div class="p-3 rounded-[10px] bg-[#f8f7f4] dark:bg-[#172033] border border-[#e5e0d8] dark:border-[#1e293b] flex items-center justify-between">
                <div class="space-y-1">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-[#0f172a] dark:bg-[#94a3b8]"></span>
                    <span class="text-xs font-semibold text-[#0f172a] dark:text-[#f8fafc]" data-mrb-t="home.preview_needs">Needs</span>
                    <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-white dark:bg-[#111827] border border-[#e5e0d8] dark:border-[#1e293b] text-[#64748b] dark:text-[#94a3b8]">50%</span>
                  </div>
                  <div class="w-24 sm:w-28 h-1 rounded-full bg-[#e5e0d8] dark:bg-[#0e1626] overflow-hidden">
                    <div class="h-full bg-[#0f172a] dark:bg-[#94a3b8]" style="width: 100%"></div>
                  </div>
                </div>
                <div class="text-right">
                  <span class="text-sm font-semibold font-mono text-[#0f172a] dark:text-[#f8fafc]" data-mrb-currency-val="2600">$2,600</span>
                  <span class="text-[10px] text-[#64748b] dark:text-[#94a3b8] block font-mono" data-mrb-t="home.preview_needs_sub">Rent, groceries, bills</span>
                </div>
              </div>

              <!-- Wants (30%) -->
              <div class="p-3 rounded-[10px] bg-[#f8f7f4] dark:bg-[#172033] border border-[#e5e0d8] dark:border-[#1e293b] flex items-center justify-between">
                <div class="space-y-1">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-[#d97706] dark:bg-[#fbbf24]"></span>
                    <span class="text-xs font-semibold text-[#0f172a] dark:text-[#f8fafc]" data-mrb-t="home.preview_wants">Wants</span>
                    <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-white dark:bg-[#111827] border border-[#e5e0d8] dark:border-[#1e293b] text-[#64748b] dark:text-[#94a3b8]">30%</span>
                  </div>
                  <div class="w-24 sm:w-28 h-1 rounded-full bg-[#e5e0d8] dark:bg-[#0e1626] overflow-hidden">
                    <div class="h-full bg-[#d97706] dark:bg-[#fbbf24]" style="width: 100%"></div>
                  </div>
                </div>
                <div class="text-right">
                  <span class="text-sm font-semibold font-mono text-[#0f172a] dark:text-[#f8fafc]" data-mrb-currency-val="1560">$1,560</span>
                  <span class="text-[10px] text-[#64748b] dark:text-[#94a3b8] block font-mono" data-mrb-t="home.preview_wants_sub">Dining, leisure, hobby</span>
                </div>
              </div>

              <!-- Savings (20%) -->
              <div class="p-3 rounded-[10px] bg-[#f8f7f4] dark:bg-[#172033] border border-[#e5e0d8] dark:border-[#1e293b] flex items-center justify-between">
                <div class="space-y-1">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-[#0e6e55] dark:bg-[#10b981]"></span>
                    <span class="text-xs font-semibold text-[#0f172a] dark:text-[#f8fafc]" data-mrb-t="home.preview_savings">Savings</span>
                    <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-[#e8f5f1] dark:bg-[rgba(16,185,129,0.15)] text-[#0e6e55] dark:text-[#10b981]">20%</span>
                  </div>
                  <div class="w-24 sm:w-28 h-1 rounded-full bg-[#e5e0d8] dark:bg-[#0e1626] overflow-hidden">
                    <div class="h-full bg-[#0e6e55] dark:bg-[#10b981]" style="width: 100%"></div>
                  </div>
                </div>
                <div class="text-right">
                  <span class="text-sm font-semibold font-mono text-[#0e6e55] dark:text-[#10b981]" data-mrb-currency-val="1040">$1,040</span>
                  <span class="text-[10px] text-[#64748b] dark:text-[#94a3b8] block font-mono" data-mrb-t="home.preview_savings_sub">Emergency fund, debt</span>
                </div>
              </div>

            </div>

            <!-- Remaining / Zero-Balance Bottom Line -->
            <div class="mt-4 pt-3.5 border-t border-[#e5e0d8] dark:border-[#1e293b] flex items-center justify-between">
              <div class="flex items-center gap-1.5 text-xs text-[#64748b] dark:text-[#94a3b8]">
                <span class="font-mono uppercase text-[11px] font-medium" data-mrb-t="home.preview_remaining">Remaining Unassigned</span>
              </div>
              <span class="font-mono text-sm font-bold text-[#0e6e55] dark:text-[#10b981]" data-mrb-currency-val="0">$0</span>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- VISIBLE CAPABILITY HIGHLIGHTS SECTION -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="bg-white dark:bg-[#111827] rounded-[16px] border border-[#e5e0d8] dark:border-[#1e293b] p-6 sm:p-10 shadow-whisper">
      <div class="max-w-3xl mb-8 space-y-2">
        <Eyebrow text="Core Capabilities" tKey="home.core_capabilities" />
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.03em] text-[#0f172a] dark:text-[#f8fafc]" data-mrb-t="home.built_for_real_life">
          An Online Budget Planner Built for Real Life
        </h2>
        <p class="text-sm sm:text-base text-[#475569] dark:text-[#94a3b8] leading-relaxed" data-mrb-t="home.built_desc">
          My Real Budget provides modern financial planning tools directly in your browser. Whether you are balancing paychecks week-to-week or planning annual savings goals, our suite helps you model, organize, and execute an actionable spending plan without spreadsheets breaking or bank accounts being exposed.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Feature 1 -->
        <div class="p-4 rounded-[10px] bg-[#f8f7f4] dark:bg-[#172033] border border-[#e5e0d8] dark:border-[#1e293b] space-y-2">
          <div class="w-8 h-8 rounded-[6px] bg-[#0e6e55]/10 dark:bg-[#10b981]/20 text-[#0e6e55] dark:text-[#10b981] flex items-center justify-center font-mono font-bold text-xs">
            01
          </div>
          <h3 class="text-sm font-semibold text-[#0f172a] dark:text-[#f8fafc]" data-mrb-t="home.feat1_title">Create a Monthly Budget</h3>
          <p class="text-xs text-[#475569] dark:text-[#94a3b8] leading-relaxed" data-mrb-t="home.feat1_desc">
            Organize all sources of income, fixed obligations, and variable expenses into a synchronized monthly balance sheet with automated totals.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="p-4 rounded-[10px] bg-[#f8f7f4] dark:bg-[#172033] border border-[#e5e0d8] dark:border-[#1e293b] space-y-2">
          <div class="w-8 h-8 rounded-[6px] bg-[#0e6e55]/10 dark:bg-[#10b981]/20 text-[#0e6e55] dark:text-[#10b981] flex items-center justify-center font-mono font-bold text-xs">
            02
          </div>
          <h3 class="text-sm font-semibold text-[#0f172a] dark:text-[#f8fafc]" data-mrb-t="home.feat2_title">Customize Budget Categories</h3>
          <p class="text-xs text-[#475569] dark:text-[#94a3b8] leading-relaxed" data-mrb-t="home.feat2_desc">
            Organize living expenses, debt payments, and savings into clear categories to see exactly where your money is allocated.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="p-4 rounded-[10px] bg-[#f8f7f4] dark:bg-[#172033] border border-[#e5e0d8] dark:border-[#1e293b] space-y-2">
          <div class="w-8 h-8 rounded-[6px] bg-[#0e6e55]/10 dark:bg-[#10b981]/20 text-[#0e6e55] dark:text-[#10b981] flex items-center justify-center font-mono font-bold text-xs">
            03
          </div>
          <h3 class="text-sm font-semibold text-[#0f172a] dark:text-[#f8fafc]" data-mrb-t="home.feat3_title">Apply the 50/30/20 Rule</h3>
          <p class="text-xs text-[#475569] dark:text-[#94a3b8] leading-relaxed" data-mrb-t="home.feat3_desc">
            Distribute after-tax income across 50% essentials, 30% lifestyle choices, and 20% savings and debt acceleration in seconds.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="p-4 rounded-[10px] bg-[#f8f7f4] dark:bg-[#172033] border border-[#e5e0d8] dark:border-[#1e293b] space-y-2">
          <div class="w-8 h-8 rounded-[6px] bg-[#0e6e55]/10 dark:bg-[#10b981]/20 text-[#0e6e55] dark:text-[#10b981] flex items-center justify-center font-mono font-bold text-xs">
            04
          </div>
          <h3 class="text-sm font-semibold text-[#0f172a] dark:text-[#f8fafc]" data-mrb-t="home.feat4_title">Create a Zero-Based Budget</h3>
          <p class="text-xs text-[#475569] dark:text-[#94a3b8] leading-relaxed" data-mrb-t="home.feat4_desc">
            Assign purpose to every single dollar until unassigned cash reaches zero, giving you a clearer plan for where your money is intended to go.
          </p>
        </div>

        <!-- Feature 5 -->
        <div class="p-4 rounded-[10px] bg-[#f8f7f4] dark:bg-[#172033] border border-[#e5e0d8] dark:border-[#1e293b] space-y-2">
          <div class="w-8 h-8 rounded-[6px] bg-[#0e6e55]/10 dark:bg-[#10b981]/20 text-[#0e6e55] dark:text-[#10b981] flex items-center justify-center font-mono font-bold text-xs">
            05
          </div>
          <h3 class="text-sm font-semibold text-[#0f172a] dark:text-[#f8fafc]" data-mrb-t="home.feat5_title">Normalize Billing Frequencies</h3>
          <p class="text-xs text-[#475569] dark:text-[#94a3b8] leading-relaxed" data-mrb-t="home.feat5_desc">
            Convert weekly paychecks, bi-weekly subscriptions, and semi-annual insurance premiums into true monthly mathematical equivalents.
          </p>
        </div>

        <!-- Feature 6 -->
        <div class="p-4 rounded-[10px] bg-[#f8f7f4] dark:bg-[#172033] border border-[#e5e0d8] dark:border-[#1e293b] space-y-2">
          <div class="w-8 h-8 rounded-[6px] bg-[#0e6e55]/10 dark:bg-[#10b981]/20 text-[#0e6e55] dark:text-[#10b981] flex items-center justify-center font-mono font-bold text-xs">
            06
          </div>
          <h3 class="text-sm font-semibold text-[#0f172a] dark:text-[#f8fafc]" data-mrb-t="home.feat6_title">Use Budget Planner Templates</h3>
          <p class="text-xs text-[#475569] dark:text-[#94a3b8] leading-relaxed" data-mrb-t="home.feat6_desc">
            Export ready-to-run worksheets directly formatted for Google Sheets, Microsoft Excel, and offline personal financial recordkeeping.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CHOOSE HOW YOU WANT TO BUDGET -->
  <section id="methods" class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-2.5">
      <Eyebrow text="Methodologies" tKey="methods.eyebrow" class="mx-auto" />
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.03em] text-[#0f172a] dark:text-[#f8fafc]" data-mrb-t="home.choose_how_to_budget">
        Choose how you want to budget
      </h2>
      <p class="text-sm sm:text-base text-[#475569] dark:text-[#94a3b8]" data-mrb-t="methods.subtitle">
        Different financial stages call for different tools. Select the method that fits your goals, income flow, and lifestyle.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Option 1: 50/30/20 Budget -->
      <div class="bg-white dark:bg-[#111827] rounded-[12px] border border-[#e5e0d8] dark:border-[#1e293b] p-7 shadow-whisper flex flex-col justify-between hover:border-[#cbd5e1] dark:hover:border-[#334155] transition group">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-[8px] bg-[#f4f0ea] dark:bg-[#172033] text-[#0f172a] dark:text-[#f8fafc] border border-[#e5e0d8] dark:border-[#1e293b] flex items-center justify-center font-mono font-bold text-sm">
            50%
          </div>
          <h3 class="text-xl font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="nav.f3020_budget">
            50/30/20 Budget
          </h3>
          <p class="text-sm text-[#475569] dark:text-[#94a3b8] leading-relaxed" data-mrb-t="methods.f3020_desc">
            A simple percentage-based starting point. Divides take-home pay into 50% Needs, 30% Wants, and 20% Savings & Debt.
          </p>
          <ul class="space-y-2 text-xs text-[#64748b] dark:text-[#94a3b8] pt-2">
            <li class="flex items-center gap-2">
