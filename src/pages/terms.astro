---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';

const title = 'Terms & Conditions | My Real Budget';
const description = 'Review the Terms & Conditions for My Real Budget, including acceptable use of our free calculators, spreadsheet templates, and budgeting guides.';
const canonical = 'https://myrealbudget.com/terms/';

const termsSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Terms & Conditions',
  url: canonical,
  description: description,
  publisher: {
    '@type': 'Organization',
    name: 'My Real Budget',
    url: 'https://myrealbudget.com/',
    logo: 'https://myrealbudget.com/favicon.svg',
  },
};
---

<Layout title={title} description={description} canonical={canonical} jsonLd={termsSchema}>
  <!-- HERO INTRO -->
  <section class="border-b border-[#e5e0d8] dark:border-[#1e293b] bg-[#faf8f5] dark:bg-[#0b1220] py-14 sm:py-20 transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="space-y-4">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs font-mono text-[#64748b] dark:text-[#94a3b8]" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[#0e6e55] dark:hover:text-[#10b981] transition-colors" data-mrb-t="error.home_breadcrumb">Home</a>
          <span aria-hidden="true">/</span>
          <span class="text-[#0f172a] dark:text-[#f8fafc] font-medium" data-mrb-t="terms.breadcrumb">Terms & Conditions</span>
        </nav>

        <Eyebrow text="Agreement & Disclaimers" tKey="terms.eyebrow" />

        <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.035em] text-[#0f172a] dark:text-[#f8fafc] leading-[1.15]" data-mrb-t="terms.h1">
          Terms & Conditions
        </h1>

        <p class="text-sm font-mono text-[#64748b] dark:text-[#94a3b8]" data-mrb-t="terms.updated">
          Last Updated: October 2026 • Effective Date: October 2026
        </p>

        <p class="text-base sm:text-lg text-[#475569] dark:text-[#94a3b8] leading-relaxed max-w-2xl" data-mrb-t-html="terms.hero_p">
          Please read these Terms & Conditions carefully before using <strong>My Real Budget</strong> (myrealbudget.com). By accessing or using our websites, online calculators, and templates, you agree to be bound by these terms.
        </p>
      </div>
    </div>
  </section>

  <!-- MAIN BODY -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-12">
    <!-- IMPORTANT FINANCIAL ADVISORY NOTICE BANNER -->
    <div class="bg-white dark:bg-[#111827] rounded-[16px] border border-[#e5e0d8] dark:border-[#1e293b] p-6 sm:p-8 shadow-whisper space-y-3">
      <div class="flex items-center gap-2 text-[#d97706] dark:text-[#fbbf24]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <h2 class="text-base font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="terms.notice_title">
          Educational Disclaimer
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-[#475569] dark:text-[#94a3b8] leading-relaxed" data-mrb-t="terms.notice_desc">
        The tools, calculators, templates, and articles on My Real Budget are provided strictly for educational and informational personal budgeting purposes. We do not provide formal certified financial, tax, or legal advisory.
      </p>
    </div>

    <!-- DETAILED TERMS SECTIONS -->
    <article class="prose max-w-none text-sm text-[#475569] dark:text-[#94a3b8] space-y-10 leading-relaxed">
      <!-- Section 1 -->
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="terms.s1_title">
          1. Acceptance of Terms
        </h2>
        <p data-mrb-t="terms.s1_p">
          By browsing this site, using our interactive tools, or downloading templates, you agree to comply with and be bound by these Terms and our Privacy Policy.
        </p>
      </section>

      <!-- Section 2 -->
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="terms.s2_title">
          2. Educational Purpose Only
        </h2>
        <p data-mrb-t="terms.s2_p">
          All materials are intended to help users model and organize personal cash flows. They do not constitute formal fiduciary, investment, or legal advice.
        </p>
      </section>

      <!-- Section 3 -->
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="terms.s3_title">
          3. Use of Calculators and Templates
        </h2>
        <p data-mrb-t="terms.s3_p">
          You are granted a revocable, non-exclusive license to use the calculators and templates for personal, non-commercial financial planning.
        </p>
      </section>

      <!-- Section 4 -->
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="terms.s4_title">
          4. Intellectual Property
        </h2>
        <p data-mrb-t="terms.s4_p">
          The design, logo, content, guides, and software code of My Real Budget are the exclusive property of My Real Budget and protected by international intellectual property laws.
        </p>
      </section>

      <!-- Section 5 -->
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="terms.s5_title">
          5. Limitation of Liability
        </h2>
        <p data-mrb-t="terms.s5_p">
          In no event shall My Real Budget be liable for any direct, indirect, incidental, or consequential damages resulting from the use or inability to use our tools.
        </p>
      </section>

      <!-- Section 6 -->
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-[#0f172a] dark:text-[#f8fafc] tracking-tight" data-mrb-t="terms.s6_title">
          6. Changes to Terms
        </h2>
        <p data-mrb-t="terms.s6_p">
          We reserve the right to modify these terms at any time. Continued use of the website following changes represents acceptance of updated terms.
        </p>
      </section>
    </article>
  </div>
</Layout>
