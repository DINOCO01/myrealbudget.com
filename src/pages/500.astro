---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';

const title = 'Server Error (500) | My Real Budget';
const description = 'An unexpected server error occurred. Please refresh the page or return to the My Real Budget home page.';
---

<Layout title={title} description={description} noIndex={true}>
  <div class="min-h-[70vh] flex items-center justify-center py-16 sm:py-24 px-4 sm:px-6">
    <div class="max-w-2xl w-full text-center space-y-8">
      <!-- Status Badge & Icon -->
      <div class="space-y-4">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-[14px] bg-[#fef2f2] dark:bg-[rgba(248,113,113,0.15)] border border-[#fecaca] dark:border-[rgba(248,113,113,0.3)] text-[#dc2626] dark:text-[#f87171] mx-auto shadow-whisper">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>

        <Eyebrow text="Error 500 • Internal Error" tKey="error.500_eyebrow" class="mx-auto" />

        <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.035em] text-[#0f172a] dark:text-[#f8fafc] leading-[1.15]" data-mrb-t="error.500_title">
          Something Went Temporarily Wrong
        </h1>

        <p class="text-base sm:text-lg text-[#475569] dark:text-[#94a3b8] leading-relaxed max-w-lg mx-auto" data-mrb-t="error.500_desc">
          We encountered an unexpected technical issue processing this request. Because your budgets are calculated and saved in your device's browser, your data is completely intact.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <button
          type="button"
          onclick="window.location.reload()"
          class="inline-flex items-center justify-center gap-2 h-11 px-7 rounded-full bg-[#0e6e55] hover:bg-[#0a5240] dark:bg-[#10b981] dark:hover:bg-[#34d399] text-white dark:text-[#042f24] text-sm font-medium transition shadow-sm cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span data-mrb-t="error.reload_page">Reload Page</span>
        </button>

        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 h-11 px-7 rounded-full bg-white dark:bg-[#111827] text-[#0f172a] dark:text-[#f8fafc] border border-[#e5e0d8] dark:border-[#1e293b] text-sm font-medium hover:bg-[#f8f7f4] dark:hover:bg-[#172033] transition shadow-whisper"
        >
          <span data-mrb-t="error.return_home">Return to Home</span>
        </a>
      </div>

      <!-- Reassurance Card -->
      <div class="bg-white dark:bg-[#111827] rounded-[14px] border border-[#e5e0d8] dark:border-[#1e293b] p-5 shadow-whisper text-left max-w-lg mx-auto space-y-2">
        <div class="flex items-center gap-2 text-xs font-semibold text-[#0f172a] dark:text-[#f8fafc]">
          <span class="w-2 h-2 rounded-full bg-[#0e6e55] dark:bg-[#10b981]"></span>
          <span data-mrb-t="error.data_safe">Your Local Data Is Safe</span>
        </div>
        <p class="text-xs text-[#475569] dark:text-[#94a3b8] leading-relaxed" data-mrb-t="error.data_safe_desc">
          My Real Budget doesn't transmit your calculations to remote databases. If this error persists, our technical team may be rolling out an update. Please check back in a few minutes.
        </p>
      </div>

      <!-- Contact Support link -->
      <p class="text-xs text-[#64748b] dark:text-[#94a3b8]">
        Need assistance or want to report this issue? <a href="/contact/" class="text-[#0e6e55] dark:text-[#10b981] underline">Contact our support team</a>.
      </p>
    </div>
  </div>
</Layout>
