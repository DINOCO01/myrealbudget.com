---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  noIndex?: boolean;
  lang?: string;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogTitle,
  ogDescription,
  ogImage,
  jsonLd,
  noIndex = false,
  lang,
} = Astro.props;

const siteUrl = 'https://myrealbudget.com';

// Ensure consistent canonical URL with trailing slash, non-www, and https
let normalizedPath = Astro.url.pathname;
if (!normalizedPath.startsWith('/')) {
  normalizedPath = `/${normalizedPath}`;
}
if (!normalizedPath.endsWith('/')) {
  normalizedPath = `${normalizedPath}/`;
}

const isZhHant = normalizedPath.startsWith('/zh-hant/') || lang === 'zh-Hant';
const isZhHans = (normalizedPath.startsWith('/zh/') && !isZhHant) || lang === 'zh-Hans' || lang === 'zh-CN' || (lang === 'zh' && !isZhHant);
const isZh = isZhHant || isZhHans;
const htmlLang = isZhHant ? 'zh-Hant' : (isZhHans ? 'zh-Hans' : (lang || 'en'));
const ogLocale = isZhHant ? 'zh_TW' : (isZhHans ? 'zh_CN' : 'en_US');

const canonicalUrl = canonical || (normalizedPath === '/' ? `${siteUrl}/` : `${siteUrl}${normalizedPath}`);
const resolvedOgImage = ogImage || `${siteUrl}/og-image.png`;
const resolvedOgTitle = ogTitle || title;
const resolvedOgDescription = ogDescription || description;

// Hreflang alternates for the 5 supported English-Simplified-Traditional page triplets
const HREFLANG_PAIRS: Record<string, { en: string; zhHans: string; zhHant: string }> = {
  '/': { en: `${siteUrl}/`, zhHans: `${siteUrl}/zh/`, zhHant: `${siteUrl}/zh-hant/` },
  '/zh/': { en: `${siteUrl}/`, zhHans: `${siteUrl}/zh/`, zhHant: `${siteUrl}/zh-hant/` },
  '/zh-hant/': { en: `${siteUrl}/`, zhHans: `${siteUrl}/zh/`, zhHant: `${siteUrl}/zh-hant/` },

  '/budget-planner/': { en: `${siteUrl}/budget-planner/`, zhHans: `${siteUrl}/zh/budget-planner/`, zhHant: `${siteUrl}/zh-hant/budget-planner/` },
  '/zh/budget-planner/': { en: `${siteUrl}/budget-planner/`, zhHans: `${siteUrl}/zh/budget-planner/`, zhHant: `${siteUrl}/zh-hant/budget-planner/` },
  '/zh-hant/budget-planner/': { en: `${siteUrl}/budget-planner/`, zhHans: `${siteUrl}/zh/budget-planner/`, zhHant: `${siteUrl}/zh-hant/budget-planner/` },

  '/50-30-20-budget/': { en: `${siteUrl}/50-30-20-budget/`, zhHans: `${siteUrl}/zh/50-30-20-budget/`, zhHant: `${siteUrl}/zh-hant/50-30-20-budget/` },
  '/zh/50-30-20-budget/': { en: `${siteUrl}/50-30-20-budget/`, zhHans: `${siteUrl}/zh/50-30-20-budget/`, zhHant: `${siteUrl}/zh-hant/50-30-20-budget/` },
  '/zh-hant/50-30-20-budget/': { en: `${siteUrl}/50-30-20-budget/`, zhHans: `${siteUrl}/zh/50-30-20-budget/`, zhHant: `${siteUrl}/zh-hant/50-30-20-budget/` },

  '/zero-based-budget/': { en: `${siteUrl}/zero-based-budget/`, zhHans: `${siteUrl}/zh/zero-based-budget/`, zhHant: `${siteUrl}/zh-hant/zero-based-budget/` },
  '/zh/zero-based-budget/': { en: `${siteUrl}/zero-based-budget/`, zhHans: `${siteUrl}/zh/zero-based-budget/`, zhHant: `${siteUrl}/zh-hant/zero-based-budget/` },
  '/zh-hant/zero-based-budget/': { en: `${siteUrl}/zero-based-budget/`, zhHans: `${siteUrl}/zh/zero-based-budget/`, zhHant: `${siteUrl}/zh-hant/zero-based-budget/` },

  '/budget-templates/': { en: `${siteUrl}/budget-templates/`, zhHans: `${siteUrl}/zh/templates/`, zhHant: `${siteUrl}/zh-hant/templates/` },
  '/budget-planner-template/': { en: `${siteUrl}/budget-planner-template/`, zhHans: `${siteUrl}/zh/templates/`, zhHant: `${siteUrl}/zh-hant/templates/` },
  '/zh/templates/': { en: `${siteUrl}/budget-templates/`, zhHans: `${siteUrl}/zh/templates/`, zhHant: `${siteUrl}/zh-hant/templates/` },
  '/zh-hant/templates/': { en: `${siteUrl}/budget-templates/`, zhHans: `${siteUrl}/zh/templates/`, zhHant: `${siteUrl}/zh-hant/templates/` },
};
const hreflangData = HREFLANG_PAIRS[normalizedPath];

// Base structured data graph: WebSite & Organization
const baseGraph: Record<string, any>[] = [
  {
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    url: isZhHant ? `${siteUrl}/zh-hant/` : (isZhHans ? `${siteUrl}/zh/` : `${siteUrl}/`),
    name: 'My Real Budget',
    description: isZhHant
      ? '免費線上預算規劃工具，提供每月預算規劃、50/30/20法則、零基預算及試算表預算範本。'
      : (isZhHans
        ? '免费在线预算规划器，提供月度预算规划、50/30/20法则、零基预算及电子表格预算模板。'
        : 'Online budget planner for monthly budgeting, the 50/30/20 rule, zero-based budgeting, and spreadsheet templates.'),
    publisher: {
      '@id': `${siteUrl}/#organization`,
    },
  },
  {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'My Real Budget',
    url: `${siteUrl}/`,
    logo: `${siteUrl}/favicon.svg`,
  },
];

// WebApplication for planner/interactive routes
const isPlannerRoute = [
  '/',
  '/budget-planner/',
  '/50-30-20-budget/',
  '/zero-based-budget/',
  '/zh/',
  '/zh/budget-planner/',
  '/zh/50-30-20-budget/',
  '/zh/zero-based-budget/',
  '/zh-hant/',
  '/zh-hant/budget-planner/',
  '/zh-hant/50-30-20-budget/',
  '/zh-hant/zero-based-budget/',
].includes(normalizedPath);

if (isPlannerRoute) {
  baseGraph.push({
    '@type': 'WebApplication',
    '@id': `${siteUrl}/#webapp`,
    name: isZhHant ? 'My Real Budget 個人預算計算機' : (isZhHans ? 'My Real Budget 预算规划器' : 'My Real Budget Planner'),
    url: isZhHant
      ? `${siteUrl}/zh-hant/budget-planner/`
      : (isZhHans ? `${siteUrl}/zh/budget-planner/` : `${siteUrl}/budget-planner/`),
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires modern web browser with HTML5 and JavaScript enabled.',
    offers: isZh
      ? {
          '@type': 'Offer',
          price: '0',
        }
      : {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'USD',
        },
    description: isZhHant
      ? '免費線上預算規劃工具，支援每月現金流規劃、50/30/20預算分配與零基預算。'
      : (isZhHans
        ? '免费在线预算规划器，支持月度现金流规划、50/30/20预算分配与零基预算。'
        : 'Free online budget planner for monthly cash flow planning, 50/30/20 budgets, and zero-based budgeting.'),
  });
}

// Add BreadcrumbList for indexable subpages
if (normalizedPath !== '/' && normalizedPath !== '/zh/' && normalizedPath !== '/zh-hant/' && !noIndex) {
  const pathSegments = normalizedPath.split('/').filter(Boolean);
  const breadcrumbItems: Record<string, any>[] = [
    {
      '@type': 'ListItem',
      position: 1,
      name: isZhHant ? '首頁' : (isZhHans ? '首页' : 'Home'),
      item: isZhHant ? `${siteUrl}/zh-hant/` : (isZhHans ? `${siteUrl}/zh/` : `${siteUrl}/`),
    },
  ];

  if (isZhHant) {
    const zhHantNames: Record<string, string> = {
      'budget-planner': '個人預算計算機',
      '50-30-20-budget': '50/30/20預算',
      'zero-based-budget': '零基預算',
      'templates': '預算範本',
    };
    const sub = pathSegments[1] || '';
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: 2,
      name: zhHantNames[sub] || title.split('|')[0].split('—')[0].split(':')[0].trim(),
      item: canonicalUrl,
    });
  } else if (isZhHans) {
    const zhNames: Record<string, string> = {
      'budget-planner': '预算规划器',
      '50-30-20-budget': '50/30/20预算',
      'zero-based-budget': '零基预算',
      'templates': '预算模板',
    };
    const sub = pathSegments[1] || '';
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: 2,
      name: zhNames[sub] || title.split('|')[0].split('—')[0].split(':')[0].trim(),
      item: canonicalUrl,
    });
  } else if (pathSegments.length === 1) {
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: 2,
      name: title.split('|')[0].split('—')[0].split(':')[0].trim(),
      item: canonicalUrl,
    });
  } else if (pathSegments.length === 2 && pathSegments[0] === 'learn') {
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: 2,
      name: 'Learn',
      item: `${siteUrl}/learn/`,
    });
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: 3,
      name: title.split('|')[0].split('—')[0].split(':')[0].trim(),
      item: canonicalUrl,
    });
  }

  baseGraph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumbItems,
  });
}

// Merge page-specific jsonLd schemas
if (jsonLd) {
  const extraItems = Array.isArray(jsonLd)
    ? jsonLd
    : ((jsonLd as any)['@graph'] ? (jsonLd as any)['@graph'] : [jsonLd]);

  for (const item of extraItems) {
    const { '@context': _, ...cleanItem } = item;
    baseGraph.push(cleanItem);
  }
}

const finalJsonLd = {
  '@context': 'https://schema.org',
  '@graph': baseGraph,
};
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth">
  <head>
    <!-- Canonical Hostname Enforcement Fallback -->
    <script is:inline>
      if (typeof window !== 'undefined' && window.location.hostname === 'www.myrealbudget.com') {
        window.location.replace('https://myrealbudget.com' + window.location.pathname + window.location.search + window.location.hash);
      }
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4RNEV5QNR0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-4RNEV5QNR0');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="My Real Budget" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Core -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {hreflangData && (
      <>
        <link rel="alternate" hreflang="en" href={hreflangData.en} />
        <link rel="alternate" hreflang="zh-Hans" href={hreflangData.zhHans} />
        <link rel="alternate" hreflang="zh-Hant" href={hreflangData.zhHant} />
        <link rel="alternate" hreflang="x-default" href={hreflangData.en} />
      </>
    )}
    {noIndex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Open Graph -->
    <meta property="og:site_name" content="My Real Budget" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedOgTitle} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={resolvedOgTitle} />

    <!-- Fonts: Geist & Geist Mono (as specified in DESIGN.md) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Anti-FOUC Theme & Language Initialization -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('myrealbudget_theme');
          if (stored === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          if (window.location.pathname.startsWith('/zh/')) {
            document.documentElement.lang = 'zh-CN';
          } else {
            const storedLang = localStorage.getItem('myrealbudget_language');
            if (storedLang) {
              document.documentElement.lang = storedLang;
            } else if (typeof navigator !== 'undefined') {
              const langs = (navigator.languages && navigator.languages.length) ? navigator.languages : [navigator.language];
              for (const raw of langs) {
                if (!raw) continue;
                const lower = raw.toLowerCase().trim();
                const code = lower.split('-')[0];
                if (code === 'zh' || lower.startsWith('zh')) { document.documentElement.lang = 'zh'; break; }
                if (code === 'es') { document.documentElement.lang = 'es'; break; }
                if (code === 'fr') { document.documentElement.lang = 'fr'; break; }
                if (code === 'de') { document.documentElement.lang = 'de'; break; }
                if (code === 'pt') { document.documentElement.lang = 'pt'; break; }
                if (code === 'en') { document.documentElement.lang = 'en'; break; }
              }
            }
          }
        } catch (e) {}
      })();
    </script>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--bg-page)] text-[var(--text-primary)] selection:bg-[var(--text-primary)] selection:text-[var(--bg-page)] antialiased font-sans">
    <Header currentPath={Astro.url.pathname} />
    <div class="flex-1 flex flex-col min-w-0 w-full max-w-full">
      <slot />
    </div>
    <Footer currentPath={Astro.url.pathname} />

    <!-- Buy Me a Coffee Widget -->
    <script data-name="BMC-Widget" data-cfasync="false" src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js" data-id="princeupads" data-description="Support me on Buy me a coffee!" data-message="Thanks for supporting independent projects! ❤️ Your contribution helps keep my tools useful, accessible, and improving." data-color="#FF813F" data-position="Right" data-x_margin="18" data-y_margin="18"></script>

    <!-- Global Currency & Language Controller -->
    <script>
      import {
        initCurrency,
        getSelectedCurrency,
        setSelectedCurrency,
        formatCurrency,
        getCurrencySymbol,
        getCurrencyConfig,
        updateDocumentCurrencies,
        SUPPORTED_CURRENCIES,
        MONEY_TOLERANCE,
        cleanMoney,
        isMoneyZero,
        sanitizeAmount,
      } from '../utils/currency';
      import {
        initLanguage,
        getSelectedLanguage,
        setSelectedLanguage,
        t,
        translateCategoryName,
        translateItemName,
        getFrequencyLabel,
        getBuiltinCategoryId,
        getCanonicalCategoryName,
        updateDocumentTranslations,
        SUPPORTED_LANGUAGES,
      } from '../utils/i18n';

      (window as any)._mrb_currency = {
        get: getSelectedCurrency,
        set: setSelectedCurrency,
        format: formatCurrency,
        symbol: getCurrencySymbol,
        config: getCurrencyConfig,
        update: updateDocumentCurrencies,
        currencies: SUPPORTED_CURRENCIES,
        tolerance: MONEY_TOLERANCE,
        cleanMoney: cleanMoney,
        isZero: isMoneyZero,
        sanitizeAmount: sanitizeAmount,
      };

      (window as any)._mrb_i18n = {
        get: getSelectedLanguage,
        set: setSelectedLanguage,
        t: t,
        translateCategory: translateCategoryName,
        translateItem: translateItemName,
        getFrequencyLabel: getFrequencyLabel,
        getBuiltinCategoryId: getBuiltinCategoryId,
        getCanonicalCategoryName: getCanonicalCategoryName,
        update: updateDocumentTranslations,
        languages: SUPPORTED_LANGUAGES,
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initCurrency();
          initLanguage();
        });
      } else {
        initCurrency();
        initLanguage();
      }
    </script>
  </body>
</html>
