---
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { href: '/budget-planner/', label: 'Budget Planner' },
  { href: '/50-30-20-budget/', label: '50/30/20 Budget' },
  { href: '/zero-based-budget/', label: 'Zero-Based Budget' },
  { href: '/budget-planner-template/', label: 'Templates' },
  { href: '/learn/', label: 'Learn' },
];
---

<header class="sticky top-0 z-50 w-full bg-[var(--bg-page)]/90 backdrop-blur-md border-b border-[var(--border-main)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Wordmark -->
    <a href="/" class="flex items-center gap-2.5 text-[var(--text-primary)] hover:opacity-90 transition group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] rounded-[6px]">
      <Logo class="w-7 h-7 rounded-[6px] shadow-sm" />
      <span class="font-semibold text-[17px] tracking-tight text-[var(--text-primary)]">
        My Real Budget
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 text-[14px] text-[var(--text-secondary)]" aria-label="Main Navigation">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-full transition-colors font-normal ${
              isActive
                ? 'text-[var(--text-primary)] font-medium bg-[var(--surface-subtle)]'
                : 'hover:text-[var(--text-primary)] hover:bg-[var(--surface-subtle)]/70'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions (Desktop) -->
    <div class="hidden sm:flex items-center gap-2.5">
      <ThemeToggle id="desktop-theme-toggle" />
      <a
        href="/budget-planner/"
        class="inline-flex items-center justify-center h-9 px-4 rounded-full bg-[var(--btn-primary-bg)] text-[var(--btn-primary-fg)] text-[14px] font-medium hover:opacity-90 transition shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)]"
      >
        Start Your Budget
      </a>
    </div>

    <!-- Mobile Header Actions (Toggle + Menu Button) -->
    <div class="flex items-center gap-2 sm:hidden">
      <ThemeToggle id="mobile-header-theme-toggle" />
      <button
        type="button"
        id="mobile-menu-toggle"
        class="flex items-center justify-center w-9 h-9 rounded-[6px] border border-[var(--border-main)] bg-[var(--surface)] text-[var(--text-primary)] hover:bg-[var(--surface-subtle)] transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)]"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg id="menu-icon-open" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Nav -->
  <div id="mobile-nav" class="hidden md:hidden border-b border-[var(--border-main)] bg-[var(--bg-page)] px-4 py-3 space-y-1">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`block px-3 py-2 rounded-[6px] text-[14px] ${
            isActive
              ? 'bg-[var(--surface-subtle)] text-[var(--text-primary)] font-medium'
              : 'text-[var(--text-secondary)] hover:bg-[var(--surface-subtle)] hover:text-[var(--text-primary)]'
          }`}
        >
          {link.label}
        </a>
      );
    })}
    <div class="pt-3 flex items-center justify-between gap-2 border-t border-[var(--border-main)] mt-2">
      <span class="text-xs text-[var(--text-muted)] font-mono">Theme Mode</span>
      <ThemeToggle id="mobile-menu-theme-toggle" />
    </div>
    <div class="pt-2">
      <a
        href="/budget-planner/"
        class="block w-full text-center py-2.5 rounded-full bg-[var(--btn-primary-bg)] text-[var(--btn-primary-fg)] text-[14px] font-medium hover:opacity-90 transition"
      >
        Start Your Budget
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileNav && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = !mobileNav.classList.contains('hidden');
      if (isOpen) {
        mobileNav.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      } else {
        mobileNav.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
      }
    });
  }
</script>
