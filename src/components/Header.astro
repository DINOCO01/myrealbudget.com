---
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';
import CurrencyLanguageControls from './ui/CurrencyLanguageControls.astro';
import { SUPPORTED_CURRENCIES, DEFAULT_CURRENCY } from '../utils/currency';
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE } from '../utils/i18n';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const isZh = currentPath.startsWith('/zh/');
const homeHref = isZh ? '/zh/' : '/';

const navLinks = isZh
  ? [
      {
        href: '/zh/budget-planner/',
        label: '预算规划器',
        compactLabel: '预算规划器',
        tKey: 'nav.budget_planner',
        tKeyCompact: 'nav.budget_planner',
        ariaLabel: '预算规划器',
      },
      {
        href: '/zh/50-30-20-budget/',
        label: '50/30/20预算',
        compactLabel: '50/30/20',
        tKey: 'nav.f3020_budget',
        tKeyCompact: 'nav.f3020_compact',
        ariaLabel: '50/30/20 预算规划器',
      },
      {
        href: '/zh/zero-based-budget/',
        label: '零基预算',
        compactLabel: '零基预算',
        tKey: 'nav.zero_based_budget',
        tKeyCompact: 'nav.zero_based_compact',
        ariaLabel: '零基预算规划器',
      },
      {
        href: '/zh/templates/',
        label: '预算模板',
        compactLabel: '预算模板',
        tKey: 'nav.templates',
        tKeyCompact: 'nav.templates',
        ariaLabel: '免费预算模板',
      },
    ]
  : [
      {
        href: '/budget-planner/',
        label: 'Budget Planner',
        compactLabel: 'Budget Planner',
        tKey: 'nav.budget_planner',
        tKeyCompact: 'nav.budget_planner',
        ariaLabel: 'Budget Planner',
      },
      {
        href: '/50-30-20-budget/',
        label: '50/30/20 Budget',
        compactLabel: '50/30/20',
        tKey: 'nav.f3020_budget',
        tKeyCompact: 'nav.f3020_compact',
        ariaLabel: '50/30/20 Budget Planner',
      },
      {
        href: '/zero-based-budget/',
        label: 'Zero-Based Budget',
        compactLabel: 'Zero-Based',
        tKey: 'nav.zero_based_budget',
        tKeyCompact: 'nav.zero_based_compact',
        ariaLabel: 'Zero-Based Budget Planner',
      },
      {
        href: '/budget-planner-template/',
        label: 'Templates',
        compactLabel: 'Templates',
        tKey: 'nav.templates',
        tKeyCompact: 'nav.templates',
        ariaLabel: 'Templates',
      },
      {
        href: '/learn/',
        label: 'Learn',
        compactLabel: 'Learn',
        tKey: 'nav.learn',
        tKeyCompact: 'nav.learn',
        ariaLabel: 'Learn',
      },
    ];
---

<header class="sticky top-0 z-50 w-full bg-[var(--bg-page)]/90 backdrop-blur-md border-b border-[var(--border-main)]">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-2 sm:gap-3">
    <!-- Brand Wordmark -->
    <a
      href={homeHref}
      class="flex items-center gap-2 text-[var(--text-primary)] hover:opacity-90 transition group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] rounded-[6px] shrink-0"
    >
      <Logo class="w-6 h-6 sm:w-7 sm:h-7 rounded-[6px] shadow-sm shrink-0" />
      <span class="font-semibold text-[15px] sm:text-[17px] tracking-tight text-[var(--text-primary)] whitespace-nowrap">
        My Real Budget
      </span>
    </a>

    <!-- Desktop Navigation: strictly 1-line, compact labels, whitespace-nowrap -->
    <nav
      class="hidden xl:flex items-center gap-1 text-[13.5px] text-[var(--text-secondary)] whitespace-nowrap shrink-0"
      aria-label="Main Navigation"
    >
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && link.href !== '/zh/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            data-mrb-t={link.tKeyCompact}
            aria-label={link.ariaLabel || link.label}
            class={`px-3 py-1.5 rounded-full transition-colors font-normal whitespace-nowrap ${
              isActive
                ? 'text-[var(--text-primary)] font-medium bg-[var(--surface-subtle)]'
                : 'hover:text-[var(--text-primary)] hover:bg-[var(--surface-subtle)]/70'
            }`}
          >
            {link.compactLabel}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions (Desktop: Currency, Language, Theme, CTA) -->
    <div class="hidden xl:flex items-center gap-2 shrink-0 whitespace-nowrap">
      <CurrencyLanguageControls idPrefix="header-desktop" />
      <ThemeToggle id="desktop-theme-toggle" />
      <a
        href={isZh ? '/zh/budget-planner/' : '/budget-planner/'}
        data-mrb-t="nav.start_budget"
        class="inline-flex items-center justify-center h-9 px-4 rounded-full bg-[var(--btn-primary-bg)] text-[var(--btn-primary-fg)] text-[13px] font-medium hover:opacity-90 transition shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] whitespace-nowrap shrink-0"
      >
        {isZh ? '开始规划' : 'Start Budget Planner'}
      </a>
    </div>

    <!-- Mobile / Tablet Header Controls: [Currency] [Language] [Menu] (Visible below xl) -->
    <div class="flex items-center gap-1.5 sm:gap-2 xl:hidden shrink-0">
      <CurrencyLanguageControls idPrefix="mobile-header" compact={true} />
      <button
        type="button"
        id="mobile-menu-toggle"
        class="flex items-center justify-center w-8.5 h-8.5 rounded-[6px] border border-[var(--border-main)] bg-[var(--surface)] text-[var(--text-primary)] hover:bg-[var(--surface-subtle)] transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] shrink-0"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg id="menu-icon-open" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile / Tablet Dropdown Nav -->
  <div
    id="mobile-nav"
    class="hidden xl:hidden border-b border-[var(--border-main)] bg-[var(--bg-page)] px-4 py-4 space-y-4 shadow-sm"
  >
    <!-- SECTION 1: NAVIGATION -->
    <div class="space-y-1">
      <div
        class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-muted)] font-semibold px-2 pb-1"
        data-mrb-t="nav.navigation"
      >
        Navigation
      </div>
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            data-mrb-t={link.tKey}
            class={`block px-3 py-2 rounded-[6px] text-[14px] transition-colors ${
              isActive
                ? 'bg-[var(--surface-subtle)] text-[var(--text-primary)] font-medium'
                : 'text-[var(--text-secondary)] hover:bg-[var(--surface-subtle)] hover:text-[var(--text-primary)]'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </div>

    <!-- SECTION 2: PREFERENCES -->
    <div class="pt-3 border-t border-[var(--border-main)] space-y-2">
      <div
        class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-muted)] font-semibold px-2 pb-0.5"
        data-mrb-t="nav.preferences"
      >
        Preferences
      </div>
      <div class="bg-[var(--surface-subtle)]/50 rounded-[8px] p-2.5 border border-[var(--border-main)] space-y-2">
        <!-- Currency Row -->
        <div class="flex items-center justify-between text-xs px-1">
          <span class="text-[var(--text-secondary)] font-medium" data-mrb-t="common.currency">Currency</span>
          <div class="relative inline-flex items-center">
            <label for="drawer-currency-select" class="sr-only">Currency</label>
            <select
              id="drawer-currency-select"
              data-mrb-currency-select
              aria-label="Select Budget Currency"
              class="h-7 px-2.5 pr-6 rounded-[6px] bg-white dark:bg-[#111827] border border-[#ebebeb] dark:border-[#1e293b] text-[#171717] dark:text-[#f8fafc] text-xs font-mono font-medium focus:outline-none focus:ring-1 focus:ring-[var(--focus-ring)] transition cursor-pointer appearance-none shadow-whisper"
            >
              {Object.values(SUPPORTED_CURRENCIES).map((curr) => (
                <option value={curr.code} selected={curr.code === DEFAULT_CURRENCY}>
                  {curr.label}
                </option>
              ))}
            </select>
            <div class="pointer-events-none absolute right-1.5 text-[#8f8f8f] dark:text-[#64748b]">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>
          </div>
        </div>

        <!-- Language Row -->
        <div class="flex items-center justify-between text-xs px-1 pt-1.5 border-t border-[var(--border-main)]/50">
          <span class="text-[var(--text-secondary)] font-medium" data-mrb-t="common.language">Language</span>
          <div class="relative inline-flex items-center">
            <label for="drawer-language-select" class="sr-only">Language</label>
            <select
              id="drawer-language-select"
              data-mrb-lang-select
              aria-label="Select Interface Language"
              class="h-7 px-2.5 pr-6 rounded-[6px] bg-white dark:bg-[#111827] border border-[#ebebeb] dark:border-[#1e293b] text-[#171717] dark:text-[#f8fafc] text-xs font-medium focus:outline-none focus:ring-1 focus:ring-[var(--focus-ring)] transition cursor-pointer appearance-none shadow-whisper"
            >
              {Object.values(SUPPORTED_LANGUAGES).map((lang) => (
                <option value={lang.code} selected={lang.code === DEFAULT_LANGUAGE}>
                  {lang.label}
                </option>
              ))}
            </select>
            <div class="pointer-events-none absolute right-1.5 text-[#8f8f8f] dark:text-[#64748b]">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>
          </div>
        </div>

        <!-- Theme Row -->
        <div class="flex items-center justify-between text-xs px-1 pt-1.5 border-t border-[var(--border-main)]/50">
          <span class="text-[var(--text-secondary)] font-medium" data-mrb-t="nav.theme">Theme Mode</span>
          <ThemeToggle id="mobile-menu-theme-toggle" />
        </div>
      </div>
    </div>

    <!-- SECTION 3: PRIMARY ACTION -->
    <div class="pt-1">
      <a
        href={isZh ? '/zh/budget-planner/' : '/budget-planner/'}
        data-mrb-t="nav.start_budget"
        class="block w-full text-center py-2.5 rounded-full bg-[var(--btn-primary-bg)] text-[var(--btn-primary-fg)] text-[14px] font-medium hover:opacity-90 transition shadow-sm"
      >
        {isZh ? '开始规划' : 'Start Budget Planner'}
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileNav && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = !mobileNav.classList.contains('hidden');
      if (isOpen) {
        mobileNav.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      } else {
        mobileNav.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
      }
    });
  }
</script>
