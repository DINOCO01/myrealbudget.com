---
import {
  DEFAULT_INCOME_ITEMS,
  DEFAULT_EXPENSE_CATEGORIES,
} from "../../data/budgetCategories";
import { FREQUENCY_OPTIONS } from "../../utils/frequency";
import CurrencyLanguageControls from "../ui/CurrencyLanguageControls.astro";
---

<div id="general-budget-planner" class="w-full">
  <!-- Privacy Badge & Quick Controls -->
  <div
    class="mb-4 sm:mb-6 flex flex-wrap items-center justify-between gap-2.5 text-xs"
  >
    <div
      class="inline-flex items-center gap-1.5 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-full bg-white border border-[#ebebeb] text-[#4d4d4d] shadow-whisper text-[11px] sm:text-xs"
    >
      <span class="w-2 h-2 rounded-full bg-[#50e3c2]"></span>
      <span data-mrb-t="common.autosaved">Autosaved locally to this device</span
      >
    </div>
    <div class="flex items-center gap-1.5 sm:gap-2">
      <CurrencyLanguageControls idPrefix="gbp" />
      <button
        type="button"
        id="btn-export-csv"
        data-mrb-t="common.export_csv"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-[6px] border border-[#ebebeb] bg-white text-[#171717] font-medium hover:bg-neutral-50 transition shadow-whisper text-[11px] sm:text-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0070f3]"
      >
        <svg
          class="w-3.5 h-3.5 text-[#4d4d4d]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
          ></path>
        </svg>
        Export CSV
      </button>
      <button
        type="button"
        id="btn-load-example"
        data-mrb-t="common.see_example"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-[6px] border border-[#ebebeb] bg-white text-[#171717] font-medium hover:bg-neutral-50 transition shadow-whisper text-[11px] sm:text-xs focus-visible:outline-none"
      >
        See an Example
      </button>
      <button
        type="button"
        id="btn-reset-budget"
        data-mrb-t="common.reset_defaults"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-[6px] border border-[#ebebeb] bg-white text-[#8f8f8f] hover:text-[#ee0000] font-medium hover:bg-neutral-50 transition shadow-whisper text-[11px] sm:text-xs focus-visible:outline-none"
      >
        Reset Defaults
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-8 items-start">
    <!-- LEFT: Inputs (8 cols on lg) -->
    <div class="lg:col-span-7 xl:col-span-8 space-y-4 sm:space-y-6">
      <!-- Sample Data Banner (Shown only when viewing sample data) -->
      <div
        id="gbp-example-banner"
        class="hidden p-3 sm:p-3.5 rounded-[10px] bg-[#f8f9fa] border border-[#e5e7eb] flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 text-xs shadow-whisper"
      >
        <div class="flex items-center gap-2">
          <span
            class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-[#e0f2fe] text-[#0369a1] border border-[#bae6fd]"
            data-mrb-t="common.sample_data_badge"
          >
            Sample Data
          </span>
          <span class="text-[#374151] font-medium" data-mrb-t="common.viewing_sample_data">
            You're viewing sample data.
          </span>
        </div>
        <button
          type="button"
          id="gbp-btn-clear-example"
          class="inline-flex items-center justify-center px-3 py-1.5 rounded-[6px] bg-white border border-[#d1d5db] text-[#374151] hover:text-[#111827] hover:bg-neutral-50 font-medium text-xs shadow-whisper transition shrink-0"
          data-mrb-t="common.clear_example"
        >
          Clear Example & Start Fresh
        </button>
      </div>

      <!-- 1. INCOME SECTION -->
      <section
        class="bg-white rounded-[10px] sm:rounded-[12px] border border-[#ebebeb] p-3.5 sm:p-6 shadow-whisper"
      >
        <div
          class="flex items-center justify-between pb-2.5 mb-2.5 sm:pb-4 sm:mb-4 border-b border-[#ebebeb]"
        >
          <div>
            <h2
              class="text-base sm:text-lg font-semibold text-[#171717] tracking-tight"
              data-mrb-t="gbp.income_section"
            >
              1. Monthly Income
            </h2>
            <p
              class="text-[11px] sm:text-xs text-[#8f8f8f]"
              data-mrb-t="gbp.income_desc"
            >
              Enter all income streams. Choose how often you get paid.
            </p>
          </div>
          <div class="text-right">
            <span
              class="text-[10px] sm:text-xs font-mono text-[#8f8f8f] block"
              data-mrb-t="gbp.normalized_total">Normalized Total</span
            >
            <span
              id="income-header-total"
              class="font-mono text-sm sm:text-base font-semibold text-[#171717]"
              data-mrb-currency-val="0">$0</span
            >
          </div>
        </div>

        <div id="income-items-container" class="space-y-1.5 sm:space-y-2.5">
          <!-- Rendered via Client JS / initial markup -->
        </div>

        <button
          type="button"
          id="btn-add-income-item"
          class="mt-2.5 sm:mt-4 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-[6px] border border-dashed border-[#ebebeb] text-xs font-medium text-[#4d4d4d] hover:text-[#171717] hover:border-[#171717] hover:bg-[#fafafa] transition w-full justify-center"
        >
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v16m8-8H4"></path>
          </svg>
          <span data-mrb-t="common.add_income">Add Income Stream</span>
        </button>
      </section>

      <!-- Mobile Quick Summary Bar (Visible only on mobile/tablet < lg) -->
      <div
        class="lg:hidden bg-white rounded-[10px] border border-[#ebebeb] p-3 shadow-whisper"
      >
        <div
          class="flex items-center justify-between pb-2 mb-2 border-b border-[#ebebeb]"
        >
          <div class="flex items-center gap-1.5">
            <span
              class="text-xs font-semibold text-[#171717]"
              data-mrb-t="summary.net_balance">Net Cash Flow:</span
            >
            <span
              id="mobile-summary-balance-value"
              class="font-mono text-base font-bold text-[#171717]"
              data-mrb-currency-val="0">$0</span
            >
          </div>
          <div
            id="mobile-balance-status-badge"
            class="px-2 py-0.5 rounded text-[11px] font-medium bg-[#f2f2f2] text-[#4d4d4d]"
          >
            <span id="mobile-balance-status-text" data-mrb-t="summary.balanced"
              >Balanced</span
            >
          </div>
        </div>
        <div class="grid grid-cols-3 gap-1.5 text-center text-xs font-mono">
          <div class="bg-[#fafafa] py-1 px-1.5 rounded border border-[#ebebeb]">
            <span
              class="text-[10px] text-[#8f8f8f] block"
              data-mrb-t="summary.monthly_income">Income</span
            >
            <span
              id="mobile-summary-income"
              class="font-semibold text-[#171717] text-xs block"
              data-mrb-currency-val="0">$0</span
            >
          </div>
          <div class="bg-[#fafafa] py-1 px-1.5 rounded border border-[#ebebeb]">
            <span
              class="text-[10px] text-[#8f8f8f] block"
              data-mrb-t="summary.outflows">Outflows</span
            >
            <span
              id="mobile-summary-expenses"
              class="font-semibold text-[#171717] text-xs block"
              data-mrb-currency-val="0">$0</span
            >
          </div>
          <div class="bg-[#fafafa] py-1 px-1.5 rounded border border-[#ebebeb]">
            <span
              class="text-[10px] text-[#8f8f8f] block"
              data-mrb-t="summary.remaining">Remaining</span
            >
            <span
              id="mobile-summary-remaining"
              class="font-semibold text-[#171717] text-xs block"
              data-mrb-currency-val="0">$0</span
            >
          </div>
        </div>
      </div>

      <!-- 2. EXPENSES SECTION -->
      <section class="space-y-3 sm:space-y-6">
        <div
          class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 px-1"
        >
          <div>
            <h2
              class="text-base sm:text-lg font-semibold text-[#171717] tracking-tight"
              data-mrb-t="gbp.expenses_section"
            >
              2. Planned Expenses
            </h2>
            <p
              class="text-[11px] sm:text-xs text-[#8f8f8f]"
              data-mrb-t="gbp.expenses_desc"
            >
              Set amounts and select frequencies. Yearly and weekly items are
              annualized to monthly.
            </p>
          </div>
          <div
            class="flex items-center justify-between sm:justify-end gap-3 pt-1 sm:pt-0"
          >
            <div
              class="flex sm:hidden items-center gap-1.5 text-xs text-[#8f8f8f]"
            >
              <button
                type="button"
                class="hover:text-[#171717] underline text-[11px]"
                onclick="window._gbp.toggleAllCategories(true)"
                data-mrb-t="common.expand_all"
              >
                Expand all
              </button>
              <span>·</span>
              <button
                type="button"
                class="hover:text-[#171717] underline text-[11px]"
                onclick="window._gbp.toggleAllCategories(false)"
                data-mrb-t="common.collapse_all"
              >
                Collapse all
              </button>
            </div>
            <div class="text-right">
              <span
                class="hidden sm:block text-xs font-mono text-[#8f8f8f]"
                data-mrb-t="gbp.normalized_expenses">Normalized Expenses</span
              >
              <span
                id="expenses-header-total"
                class="font-mono text-sm sm:text-base font-semibold text-[#171717]"
                data-mrb-currency-val="0">$0</span
              >
            </div>
          </div>
        </div>

        <!-- Categories Container -->
        <div id="expense-categories-container" class="space-y-2.5 sm:space-y-5">
          <!-- Dynamically populated from DEFAULT_EXPENSE_CATEGORIES -->
        </div>

        <!-- Add Custom Category -->
        <div class="pt-1">
          <button
            type="button"
            id="btn-add-custom-category"
            class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 rounded-[10px] sm:rounded-[12px] border border-dashed border-[#ebebeb] bg-white text-xs font-medium text-[#4d4d4d] hover:text-[#171717] hover:border-[#171717] hover:bg-[#fafafa] transition shadow-whisper"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"></path>
            </svg>
            <span data-mrb-t="common.add_category"
              >Add Custom Expense Category</span
            >
          </button>
        </div>
      </section>
    </div>

    <!-- RIGHT: Results & Interpretation (Sticky on Desktop) -->
    <div class="lg:col-span-5 xl:col-span-4 lg:sticky lg:top-24 space-y-6">
      <!-- Summary Result Card -->
      <div
        class="bg-white rounded-[12px] border border-[#ebebeb] p-4 sm:p-6 shadow-whisper"
      >
        <div class="border-b border-[#ebebeb] pb-3 sm:pb-4 mb-3 sm:mb-5">
          <span
            class="font-mono text-[11px] sm:text-xs uppercase tracking-wider text-[#8f8f8f] block mb-0.5 sm:mb-1"
            data-mrb-t="summary.budget_summary"
          >
            Budget Balance
          </span>
          <div class="flex items-baseline justify-between">
            <span
              id="summary-balance-label"
              class="text-xs sm:text-sm font-medium text-[#4d4d4d]"
              data-mrb-t="summary.remaining_cash">Remaining Cash</span
            >
            <span
              id="summary-balance-value"
              class="font-mono text-xl sm:text-2xl font-bold tracking-tight text-[#171717]"
              data-mrb-currency-val="0"
            >
              $0
            </span>
          </div>
        </div>

        <!-- Balance Status Banner -->
        <div
          id="balance-status-banner"
          class="p-2.5 sm:p-3.5 rounded-[6px] mb-3 sm:mb-5 text-xs transition-colors"
        >
          <p
            id="balance-status-text"
            class="font-medium leading-relaxed"
            data-mrb-t="interpret.general_empty"
          >
            Enter your monthly income and expenses to balance your budget.
          </p>
        </div>

        <!-- Breakdown Numbers -->
        <div
          class="space-y-2 sm:space-y-3 font-mono text-sm border-b border-[#ebebeb] pb-3 sm:pb-5 mb-3 sm:mb-5"
        >
          <div class="flex justify-between items-center text-xs">
            <span class="text-[#8f8f8f]" data-mrb-t="summary.monthly_income"
              >Monthly Income</span
            >
            <span
              id="summary-total-income"
              class="font-semibold text-[#171717]"
              data-mrb-currency-val="0">$0</span
            >
          </div>
          <div class="flex justify-between items-center text-xs">
            <span class="text-[#8f8f8f]" data-mrb-t="summary.planned_expenses"
              >Planned Outflows</span
            >
            <span
              id="summary-total-expenses"
              class="font-semibold text-[#171717]"
              data-mrb-currency-val="0">$0</span
            >
          </div>
          <div
            class="flex justify-between items-center text-xs pt-1 border-t border-[#f2f2f2]"
          >
            <span class="text-[#8f8f8f]" data-mrb-t="summary.income_spent"
              >Income Allocated</span
            >
            <span id="summary-spent-pct" class="font-semibold text-[#171717]"
              >0%</span
            >
          </div>
          <div class="flex justify-between items-center text-xs">
            <span class="text-[#8f8f8f]" data-mrb-t="summary.income_remaining"
              >Income Remaining</span
            >
            <span
              id="summary-remaining-pct"
              class="font-semibold text-[#171717]">0%</span
            >
          </div>
          <div class="flex justify-between items-center text-xs">
            <span
              class="text-[#8f8f8f]"
              data-mrb-t="summary.savings_investments"
              >Savings & Investments</span
            >
            <span
              id="summary-savings-amount"
              class="font-semibold text-[#0070f3]">$0 (0%)</span
            >
          </div>
        </div>

        <!-- Visual Progress Bar -->
        <div class="space-y-1.5 sm:space-y-2 mb-4 sm:mb-6">
          <div
            class="flex justify-between text-[11px] sm:text-xs text-[#8f8f8f]"
          >
            <span data-mrb-t="home.preview_distribution">Income Allocation</span
            >
            <span id="progress-allocation-label">0% allocated</span>
          </div>
          <div
            class="w-full h-2 sm:h-2.5 rounded-full bg-[#f2f2f2] overflow-hidden flex"
          >
            <div
              id="progress-bar-spent"
              class="h-full bg-[#171717] transition-all duration-300"
              style="width: 0%"
            >
            </div>
            <div
              id="progress-bar-savings"
              class="h-full bg-[#0070f3] transition-all duration-300"
              style="width: 0%"
            >
            </div>
            <div
              id="progress-bar-surplus"
              class="h-full bg-[#50e3c2] transition-all duration-300"
              style="width: 0%"
            >
            </div>
          </div>
          <div
            class="flex items-center gap-3 text-[10px] sm:text-[11px] text-[#8f8f8f] pt-1 font-mono"
          >
            <span class="flex items-center gap-1"
              ><span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-[#171717]"
              ></span>
              <span data-mrb-t="summary.outflows">Expenses</span></span
            >
            <span class="flex items-center gap-1"
              ><span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-[#0070f3]"
              ></span>
              <span data-mrb-t="home.preview_savings">Savings</span></span
            >
            <span class="flex items-center gap-1"
              ><span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-[#50e3c2]"
              ></span>
              <span data-mrb-t="summary.remaining">Remaining</span></span
            >
          </div>
        </div>

        <!-- Plain Language Interpretation (Secondary Breakdown) -->
        <details class="group space-y-2">
          <summary
            class="flex items-center justify-between font-mono text-[11px] sm:text-xs font-medium uppercase tracking-wider text-[#8f8f8f] cursor-pointer list-none select-none py-0.5"
          >
            <span data-mrb-t="gbp.live_assessment"
              >Practical Interpretation</span
            >
            <svg
              class="w-3.5 h-3.5 text-[#8f8f8f] transition-transform duration-200 group-open:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <div
            id="interpretation-box"
            class="space-y-2 text-xs text-[#4d4d4d] leading-relaxed pt-1"
          >
            <!-- Dynamic insights based on real numbers -->
          </div>
        </details>
      </div>

      <!-- Largest Spending Categories Card -->
      <div
        class="bg-white rounded-[12px] border border-[#ebebeb] p-4 sm:p-5 shadow-whisper"
      >
        <details class="group space-y-2.5">
          <summary
            class="flex items-center justify-between font-mono text-[11px] sm:text-xs font-medium uppercase tracking-wider text-[#8f8f8f] cursor-pointer list-none select-none py-0.5"
          >
            <span data-mrb-t="summary.top_categories"
              >Top Spending Categories</span
            >
            <svg
              class="w-3.5 h-3.5 text-[#8f8f8f] transition-transform duration-200 group-open:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <div id="top-categories-list" class="space-y-2 text-xs pt-1">
            <!-- Populated dynamically -->
          </div>
        </details>
      </div>

      <!-- Quick Method Switcher -->
      <div
        class="bg-[#fafafa] rounded-[10px] sm:rounded-[12px] border border-[#ebebeb] p-3 sm:p-4 text-xs text-[#4d4d4d] space-y-1.5"
      >
        <p
          class="font-medium text-[#171717]"
          data-mrb-t="common.try_another_method"
        >
          Want to try another budgeting method?
        </p>
        <p
          class="text-[11px] sm:text-[12px] text-[#8f8f8f]"
          data-mrb-t-html="gbp.switch_methods_desc"
        >
          Switch to the <a
            href="/50-30-20-budget/"
            class="text-[#0070f3] underline hover:text-[#0761d1]"
            >50/30/20 Method</a
          > for percentage-based targets, or the <a
            href="/zero-based-budget/"
            class="text-[#0070f3] underline hover:text-[#0761d1]"
            >Zero-Based Method</a
          > to allocate every dollar to zero.
        </p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const STORAGE_KEY = "myrealbudget_general_budget_v1";

    const FREQUENCY_MULTIPLIERS = {
      weekly: 52 / 12,
      biweekly: 26 / 12,
      monthly: 1,
      quarterly: 4 / 12,
      semiannual: 2 / 12,
      yearly: 1 / 12,
    };

    const FREQUENCY_OPTIONS = [
      { id: "monthly", label: "Monthly" },
      { id: "weekly", label: "Weekly" },
      { id: "biweekly", label: "Every 2 wks" },
      { id: "quarterly", label: "Quarterly" },
      { id: "semiannual", label: "Semi-Annual" },
      { id: "yearly", label: "Yearly" },
    ];

    const defaultData = {
      income: [
        {
          id: "inc_salary",
          name: "Primary Salary (Take-home)",
          amount: 4200,
          frequency: "monthly",
        },
        {
          id: "inc_side",
          name: "Side Income",
          amount: 300,
          frequency: "monthly",
        },
        {
          id: "inc_freelance",
          name: "Freelance & Contract",
          amount: 0,
          frequency: "monthly",
        },
      ],
      categories: [
        {
          id: "cat_housing",
          categoryId: "housing",
          name: "Housing",
          items: [
            {
              id: "h1",
              name: "Rent or Mortgage",
              amount: 1400,
              frequency: "monthly",
            },
            {
              id: "h2",
              name: "Maintenance & Repairs",
              amount: 100,
              frequency: "monthly",
            },
          ],
        },
        {
          id: "cat_utilities",
          categoryId: "utilities",
          name: "Utilities",
          items: [
            {
              id: "u1",
              name: "Electricity & Gas",
              amount: 120,
              frequency: "monthly",
            },
            {
              id: "u2",
              name: "Water & Trash",
              amount: 60,
              frequency: "monthly",
            },
            {
              id: "u3",
              name: "Internet & Mobile Plan",
              amount: 130,
              frequency: "monthly",
            },
          ],
        },
        {
          id: "cat_food",
          categoryId: "food_groceries",
          name: "Food & Groceries",
          items: [
            {
              id: "f1",
              name: "Groceries & Essentials",
              amount: 110,
              frequency: "weekly",
            },
            {
              id: "f2",
              name: "Dining Out & Coffee",
              amount: 45,
              frequency: "weekly",
            },
          ],
        },
        {
          id: "cat_transportation",
          categoryId: "transportation",
          name: "Transportation",
          items: [
            {
              id: "t1",
              name: "Car Loan / Transit Pass",
              amount: 280,
              frequency: "monthly",
            },
            { id: "t2", name: "Gas / Fuel", amount: 40, frequency: "weekly" },
            {
              id: "t3",
              name: "Auto Maintenance & Tires",
              amount: 600,
              frequency: "yearly",
            },
          ],
        },
