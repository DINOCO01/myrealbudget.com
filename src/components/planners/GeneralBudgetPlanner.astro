          </div>

          <!-- Category Line Items (Collapsible on mobile < sm, always visible on sm+) -->
          <div id="gbp-cat-body-${catIdx}" class="${isOpen ? "block" : "hidden"} sm:!block pt-2 sm:pt-3">
            <div class="space-y-1.5 sm:space-y-2">
              ${cat.items
                .map((item, itemIdx) => {
                  const itemDisplayName = window._mrb_i18n
                    ? window._mrb_i18n.translateItem(item.name)
                    : item.name;
                  return `
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-1 sm:gap-2 p-1.5 sm:p-2 rounded-[6px] bg-[#fafafa] border border-[#ebebeb] text-xs">
                  <input
                    type="text"
                    value="${escapeHtml(itemDisplayName)}"
                    aria-label="${t("aria.expense_item_name") || "Expense item name"}"
                    class="flex-1 px-2 py-1 sm:px-2.5 sm:py-1.5 rounded-[5px] bg-white border border-[#ebebeb] text-[#171717] focus:outline-none focus:border-[#171717] text-xs"
                    onchange="window._gbp.updateItem(${catIdx}, ${itemIdx}, 'name', this.value)"
                  />
                  <div class="flex items-center gap-1 sm:gap-2">
                    <div class="relative flex-1 sm:w-28 sm:flex-initial">
                      <span class="currency-symbol absolute left-2 top-1 sm:top-1.5 text-[#8f8f8f] font-mono text-xs">${getCurrencySymbol()}</span>
                      <input
                        type="number"
                        min="0"
                        step="any"
                        value="${item.amount || ""}"
                        placeholder="0"
                        aria-label="${t("aria.expense_amount") || "Expense amount"}"
                        class="w-full pl-5 pr-1.5 py-1 sm:pl-6 sm:pr-2 sm:py-1.5 rounded-[5px] bg-white border border-[#ebebeb] text-[#171717] font-mono text-right focus:outline-none focus:border-[#171717] text-xs"
                        oninput="window._gbp.updateItem(${catIdx}, ${itemIdx}, 'amount', this.value, this)"
                        onchange="if((this.value||'').trim().startsWith('-')||Number(this.value)<0){this.value='';window._gbp.updateItem(${catIdx}, ${itemIdx}, 'amount', 0, this);}"
                      />
                    </div>
                    <select
                      aria-label="${t("aria.expense_frequency") || "Expense frequency"}"
                      class="px-1.5 py-1 sm:px-2 sm:py-1.5 rounded-[5px] bg-white border border-[#ebebeb] text-[#4d4d4d] focus:outline-none focus:border-[#171717] text-xs font-mono shrink-0"
                      onchange="window._gbp.updateItem(${catIdx}, ${itemIdx}, 'frequency', this.value)"
                    >
                      ${FREQUENCY_OPTIONS.map((opt) => {
                        const freqLabel = window._mrb_i18n
                          ? window._mrb_i18n.getFrequencyLabel(opt.id)
                          : opt.label;
                        return `<option value="${opt.id}" ${item.frequency === opt.id ? "selected" : ""}>${freqLabel}</option>`;
                      }).join("")}
                    </select>
                    <button
                      type="button"
                      title="${t("actions.delete") || "Remove item"}"
                      aria-label="${t("common.remove_item") || "Remove item"}"
                      class="p-1 sm:p-1.5 text-[#8f8f8f] hover:text-[#ee0000] rounded hover:bg-neutral-100 transition shrink-0"
                      onclick="window._gbp.removeItem(${catIdx}, ${itemIdx})"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                  </div>
                </div>
              `;
                })
                .join("")}
            </div>

            <button
              type="button"
              class="mt-2 inline-flex items-center gap-1.5 text-xs text-[#4d4d4d] hover:text-[#171717] font-medium py-1 px-1.5 rounded hover:bg-[#fafafa] transition"
              onclick="window._gbp.addItem(${catIdx})"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              + ${t("common.add_item") || "Add item"} (${escapeHtml(catDisplayName)})
            </button>
          </div>
        </div>
      `;
        })
        .join("");
    }

    function calculateAndRenderResults() {
      const totalIncome = cleanMoney(
        state.income.reduce(
          (sum, item) => sum + normalize(item.amount, item.frequency),
          0,
        ),
      );

      let totalExpensesRaw = 0;
      let savingsTotalRaw = 0;
      const categoryTotals = [];

      state.categories.forEach((cat) => {
        let catTotalRaw = 0;
        let catSavingsRaw = 0;
        cat.items.forEach((item) => {
          const itemVal = normalize(item.amount, item.frequency);
          catTotalRaw += itemVal;
          if (cat.isSavings || item.isSavings) {
            catSavingsRaw += itemVal;
          }
        });
        totalExpensesRaw += catTotalRaw;
        savingsTotalRaw += catSavingsRaw;
        categoryTotals.push({ name: getCategoryDisplayName(cat), total: cleanMoney(catTotalRaw) });
      });

      const totalExpenses = cleanMoney(totalExpensesRaw);
      const savingsTotal = cleanMoney(savingsTotalRaw);
      const remaining = cleanMoney(totalIncome - totalExpenses);
      const spentPct =
        totalIncome > 0 ? Math.round((totalExpenses / totalIncome) * 100) : 0;
      const remainingPct =
        totalIncome > 0 ? Math.round((remaining / totalIncome) * 100) : 0;
      const savingsPct =
        totalIncome > 0 ? Math.round((savingsTotal / totalIncome) * 100) : 0;

      // Headers
      const incHeader = document.getElementById("income-header-total");
      if (incHeader) incHeader.textContent = formatMoney(totalIncome);

      const expHeader = document.getElementById("expenses-header-total");
      if (expHeader) expHeader.textContent = formatMoney(totalExpenses);

      // Summary Card
      const balanceVal = document.getElementById("summary-balance-value");
      const balanceLabel = document.getElementById("summary-balance-label");
      const statusBanner = document.getElementById("balance-status-banner");
      const statusText = document.getElementById("balance-status-text");

      if (balanceVal) balanceVal.textContent = formatMoney(remaining);

      if (statusBanner && statusText && balanceLabel) {
        if (totalIncome === 0 && totalExpenses === 0) {
          statusBanner.className =
            "p-3.5 rounded-[6px] mb-5 text-xs bg-[#f2f2f2] text-[#4d4d4d]";
          statusText.textContent = t("interpret.general_empty");
          balanceLabel.textContent = t("summary.net_balance");
        } else if (remaining === 0) {
          statusBanner.className =
            "p-3.5 rounded-[6px] mb-5 text-xs bg-[#eef6ff] text-[#0761d1] border border-[#bfdbfe]";
          statusText.textContent = t("interpret.general_balanced");
          balanceLabel.textContent = t("summary.net_balance");
        } else if (remaining > 0) {
          statusBanner.className =
            "p-3.5 rounded-[6px] mb-5 text-xs bg-[#e6fbf5] text-[#047857] border border-[#a7f3d0]";
          statusText.textContent = t("interpret.general_surplus", {
            amount: formatMoney(remaining),
          });
          balanceLabel.textContent = t("summary.monthly_surplus");
        } else {
          const deficit = Math.abs(remaining);
          statusBanner.className =
            "p-3.5 rounded-[6px] mb-5 text-xs bg-[#fef2f2] text-[#b91c1c] border border-[#fecaca]";
          statusText.textContent = t("interpret.general_deficit", {
            amount: formatMoney(deficit),
          });
          balanceLabel.textContent = t("summary.monthly_deficit");
        }
      }

      // Mobile Quick Summary
      const mBalVal = document.getElementById("mobile-summary-balance-value");
      const mInc = document.getElementById("mobile-summary-income");
      const mExp = document.getElementById("mobile-summary-expenses");
      const mRem = document.getElementById("mobile-summary-remaining");
      const mBadge = document.getElementById("mobile-balance-status-badge");
      const mText = document.getElementById("mobile-balance-status-text");

      if (mBalVal) mBalVal.textContent = formatMoney(remaining);
      if (mInc) mInc.textContent = formatMoney(totalIncome);
      if (mExp) mExp.textContent = formatMoney(totalExpenses);
      if (mRem) mRem.textContent = formatMoney(remaining);

      if (mBadge && mText) {
        if (totalIncome === 0 && totalExpenses === 0) {
          mBadge.className =
            "px-2 py-0.5 rounded text-[11px] font-medium bg-[#f2f2f2] text-[#4d4d4d]";
          mText.textContent = t("summary.balanced");
        } else if (remaining === 0) {
          mBadge.className =
            "px-2 py-0.5 rounded text-[11px] font-medium bg-[#eef6ff] text-[#0761d1] border border-[#bfdbfe]";
          mText.textContent = t("summary.balanced");
        } else if (remaining > 0) {
          mBadge.className =
            "px-2 py-0.5 rounded text-[11px] font-medium bg-[#e6fbf5] text-[#047857] border border-[#a7f3d0]";
          mText.textContent = t("summary.surplus");
        } else {
          mBadge.className =
            "px-2 py-0.5 rounded text-[11px] font-medium bg-[#fef2f2] text-[#b91c1c] border border-[#fecaca]";
          mText.textContent = t("summary.deficit");
        }
      }

      // Breakdown
      const sIncome = document.getElementById("summary-total-income");
      const sExpenses = document.getElementById("summary-total-expenses");
      const sSpentPct = document.getElementById("summary-spent-pct");
      const sRemPct = document.getElementById("summary-remaining-pct");
      const sSavings = document.getElementById("summary-savings-amount");

      if (sIncome) sIncome.textContent = formatMoney(totalIncome);
      if (sExpenses) sExpenses.textContent = formatMoney(totalExpenses);
      if (sSpentPct) sSpentPct.textContent = `${spentPct}%`;
      if (sRemPct) sRemPct.textContent = `${remainingPct}%`;
      if (sSavings)
        sSavings.textContent = `${formatMoney(savingsTotal)} (${savingsPct}%)`;

      // Progress Bar
      const allocLabel = document.getElementById("progress-allocation-label");
      const barSpent = document.getElementById("progress-bar-spent");
      const barSavings = document.getElementById("progress-bar-savings");
      const barSurplus = document.getElementById("progress-bar-surplus");

      if (allocLabel)
        allocLabel.textContent = t("summary.spent_pct", { pct: spentPct });
      if (barSpent && barSavings && barSurplus) {
        if (totalIncome > 0) {
          const nonSavingsExpenses = Math.max(0, totalExpenses - savingsTotal);
          const spentWidth = Math.min(
            100,
            (nonSavingsExpenses / totalIncome) * 100,
          );
          const savingsWidth = Math.min(
            100 - spentWidth,
            (savingsTotal / totalIncome) * 100,
          );
          const surplusWidth =
            remaining > 0
              ? Math.min(
                  100 - spentWidth - savingsWidth,
                  (remaining / totalIncome) * 100,
                )
              : 0;

          barSpent.style.width = `${spentWidth}%`;
          barSavings.style.width = `${savingsWidth}%`;
          barSurplus.style.width = `${surplusWidth}%`;
        } else {
          barSpent.style.width = "0%";
          barSavings.style.width = "0%";
          barSurplus.style.width = "0%";
        }
      }

      // Dynamic Interpretation
      renderInterpretation(
        totalIncome,
        totalExpenses,
        remaining,
        categoryTotals,
        savingsTotal,
      );

      // Top Categories
      renderTopCategories(categoryTotals, totalExpenses);
    }

    function renderInterpretation(
      income,
      expenses,
      remaining,
      categoryTotals,
      savings,
    ) {
      const box = document.getElementById("interpretation-box");
      if (!box) return;

      if (income === 0) {
        box.innerHTML = `<p class="text-[#8f8f8f]">${t("gbp.start_entering")}</p>`;
        return;
      }

      const sorted = [...categoryTotals]
        .sort((a, b) => b.total - a.total)
        .filter((c) => c.total > 0);
      const largest = sorted[0];
      const insights = [];

      // 1. Bottom-line state
      if (remaining === 0) {
        insights.push(t("interpret.general_insight_balanced"));
      } else if (remaining > 0) {
        const remPct = Math.round((remaining / income) * 100);
        insights.push(
          t("interpret.general_insight_surplus", {
            amount: formatMoney(remaining),
            pct: remPct,
          }),
        );
      } else {
        const deficit = Math.abs(remaining);
        insights.push(
          t("interpret.general_insight_deficit", {
            amount: formatMoney(deficit),
          }),
        );
      }

      // 2. Largest Category
      if (largest) {
        const largestPct =
          expenses > 0 ? Math.round((largest.total / expenses) * 100) : 0;
        const largestIncomePct = Math.round((largest.total / income) * 100);
        const largestName = window._mrb_i18n
          ? window._mrb_i18n.translateCategory(largest.name)
          : largest.name;
        insights.push(
          t("interpret.general_largest", {
            name: escapeHtml(largestName),
            amount: formatMoney(largest.total),
            pct: largestPct,
            incPct: largestIncomePct,
          }),
        );
      }

      // 3. Savings health
      const savingsPct = Math.round((savings / income) * 100);
      if (savingsPct > 0) {
        insights.push(t("interpret.general_savings", { pct: savingsPct }));
      } else {
        insights.push(t("interpret.general_zero_savings"));
      }

      box.innerHTML = insights
        .map(
          (i) =>
            `<p class="flex items-start gap-1.5"><span>•</span><span>${i}</span></p>`,
        )
        .join("");
    }

    function renderTopCategories(categoryTotals, totalExpenses) {
      const list = document.getElementById("top-categories-list");
      if (!list) return;

      const sorted = [...categoryTotals]
        .sort((a, b) => b.total - a.total)
        .filter((c) => c.total > 0)
        .slice(0, 5);

      if (sorted.length === 0) {
        list.innerHTML = `<p class="text-[#8f8f8f]">${t("gbp.empty_categories")}</p>`;
        return;
      }

      list.innerHTML = sorted
        .map((cat, idx) => {
          const pct =
            totalExpenses > 0
              ? Math.round((cat.total / totalExpenses) * 100)
              : 0;
          const catDisplayName = getCategoryDisplayName(cat);
          return `
        <div class="space-y-1">
          <div class="flex justify-between items-center text-xs">
            <span class="text-[#171717] font-medium">${idx + 1}. ${escapeHtml(catDisplayName)}</span>
            <span class="font-mono text-[#4d4d4d]">${formatMoney(cat.total)} (${pct}%)</span>
          </div>
          <div class="w-full h-1.5 rounded-full bg-[#f2f2f2] overflow-hidden">
            <div class="h-full bg-[#171717]" style="width: ${pct}%"></div>
          </div>
        </div>
      `;
        })
        .join("");
    }

    function escapeHtml(str) {
      return (str || "").replace(
        /[&<>"']/g,
        (m) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#039;",
          })[m],
      );
    }

    // Global handler object for inline event handlers
    window._gbp = {
      loadExample: loadExample,
      clearExample: clearExample,
      updateIncomeItem: function (idx, field, value, el) {
        if (!state.income[idx]) return;
        markAsCustomized();
        if (field === "amount") {
          validateNumericInput(el, value);
          state.income[idx].amount = sanitizeAmount(value);
        } else {
          state.income[idx][field] = value;
        }
        saveState();
        calculateAndRenderResults();
      },
      removeIncomeItem: function (idx) {
        markAsCustomized();
        state.income.splice(idx, 1);
        saveState();
        renderIncome();
        calculateAndRenderResults();
      },
      updateItem: function (catIdx, itemIdx, field, value, el) {
        if (
          !state.categories[catIdx] ||
          !state.categories[catIdx].items[itemIdx]
        )
          return;
        markAsCustomized();
        if (field === "amount") {
          validateNumericInput(el, value);
          state.categories[catIdx].items[itemIdx].amount =
            sanitizeAmount(value);
        } else {
          state.categories[catIdx].items[itemIdx][field] = value;
        }
        saveState();
        calculateAndRenderResults();
      },
      toggleCategorySavings: function (catIdx) {
        if (!state.categories[catIdx]) return;
        markAsCustomized();
        state.categories[catIdx].isSavings =
          !state.categories[catIdx].isSavings;
        if (Array.isArray(state.categories[catIdx].items)) {
          state.categories[catIdx].items.forEach((it) => {
            it.isSavings = state.categories[catIdx].isSavings;
          });
        }
        saveState();
        renderCategories();
        calculateAndRenderResults();
      },
      removeItem: function (catIdx, itemIdx) {
        if (!state.categories[catIdx]) return;
        markAsCustomized();
        state.categories[catIdx].items.splice(itemIdx, 1);
        saveState();
        renderCategories();
        calculateAndRenderResults();
      },
      addItem: function (catIdx) {
        if (!state.categories[catIdx]) return;
        markAsCustomized();
        state.categories[catIdx].items.push({
          id: "item_" + Date.now(),
          name: t("common.add_item") || "New Item",
          amount: 0,
          frequency: "monthly",
          isSavings: Boolean(state.categories[catIdx].isSavings),
        });
        saveState();
        renderCategories();
        calculateAndRenderResults();
      },
      updateCategoryName: function (catIdx, name) {
        if (!state.categories[catIdx]) return;
        const cat = state.categories[catIdx];
        const currentDisplay = getCategoryDisplayName(cat);
        const trimmed = (name || "").trim();
        if (trimmed === currentDisplay.trim()) return;

        markAsCustomized();
        const bId = resolveBuiltinCategoryId(null, trimmed);
        if (bId) {
          cat.categoryId = bId;
          const canon =
            window._mrb_i18n &&
            typeof window._mrb_i18n.getCanonicalCategoryName === "function"
              ? window._mrb_i18n.getCanonicalCategoryName(bId)
              : null;
          cat.name = canon || trimmed;
        } else {
          // Custom category created or renamed by user: preserve verbatim
          delete cat.categoryId;
          cat.name = trimmed;
        }
        saveState();
        calculateAndRenderResults();
      },
      removeCategory: function (catIdx) {
        const catName = state.categories[catIdx]
          ? getCategoryDisplayName(state.categories[catIdx])
          : "";
        if (confirm(t("confirm.delete_category", { name: catName }))) {
          markAsCustomized();
          state.categories.splice(catIdx, 1);
          saveState();
          renderCategories();
          calculateAndRenderResults();
        }
      },
      toggleCategory: function (catIdx) {
        if (openCategories.has(catIdx)) {
          openCategories.delete(catIdx);
        } else {
          openCategories.add(catIdx);
        }
        const body = document.getElementById(`gbp-cat-body-${catIdx}`);
        const btn = document.getElementById(`gbp-cat-btn-${catIdx}`);
        if (body) {
          if (openCategories.has(catIdx)) {
            body.classList.remove("hidden");
            body.classList.add("block");
          } else {
            body.classList.remove("block");
            body.classList.add("hidden");
          }
        }
        if (btn) {
          if (openCategories.has(catIdx)) {
            btn.classList.add("rotate-180");
          } else {
            btn.classList.remove("rotate-180");
          }
        }
      },
      toggleAllCategories: function (expand) {
        state.categories.forEach((_, idx) => {
          if (expand) openCategories.add(idx);
          else openCategories.delete(idx);
          const body = document.getElementById(`gbp-cat-body-${idx}`);
          const btn = document.getElementById(`gbp-cat-btn-${idx}`);
          if (body) {
            if (expand) {
              body.classList.remove("hidden");
              body.classList.add("block");
            } else {
              body.classList.remove("block");
              body.classList.add("hidden");
            }
          }
          if (btn) {
            if (expand) btn.classList.add("rotate-180");
            else btn.classList.remove("rotate-180");
          }
        });
      },
    };

    // DOM Events
    const addIncomeBtn = document.getElementById("btn-add-income-item");
    if (addIncomeBtn) {
      addIncomeBtn.addEventListener("click", () => {
        markAsCustomized();
        state.income.push({
          id: "inc_" + Date.now(),
          name: t("common.add_income") || "New Income Source",
          amount: 0,
          frequency: "monthly",
        });
        saveState();
        renderIncome();
        calculateAndRenderResults();
      });
    }

    const addCatBtn = document.getElementById("btn-add-custom-category");
    if (addCatBtn) {
      addCatBtn.addEventListener("click", () => {
        const name = prompt(t("prompt.new_category_name"), "Custom Category");
        if (name && name.trim()) {
          markAsCustomized();
          state.categories.push({
            id: "cat_" + Date.now(),
            name: name.trim(),
            isSavings: false,
            items: [
              {
                id: "item_" + Date.now(),
                name: "First Item",
                amount: 0,
                frequency: "monthly",
                isSavings: false,
              },
            ],
          });
          saveState();
          renderCategories();
          calculateAndRenderResults();
        }
      });
    }

    const btnLoadExample = document.getElementById("btn-load-example");
    if (btnLoadExample) {
      btnLoadExample.addEventListener("click", loadExample);
    }

    const btnClearExample = document.getElementById("gbp-btn-clear-example");
    if (btnClearExample) {
      btnClearExample.addEventListener("click", clearExample);
    }

    const resetBtn = document.getElementById("btn-reset-budget");
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        if (confirm(t("confirm.reset_general"))) {
          isExampleMode = false;
          updateExampleBanner();
          state = JSON.parse(JSON.stringify(getDefaultDataForCurrency()));
          saveState();
          renderIncome();
          renderCategories();
          calculateAndRenderResults();
        }
      });
    }

    const exportBtn = document.getElementById("btn-export-csv");
    if (exportBtn) {
      exportBtn.addEventListener("click", () => {
        let csv =
          "Section,Category,Item Name,Frequency,Entered Amount,Normalized Monthly\n";
        state.income.forEach((item) => {
          csv += `Income,Income,${csvClean(item.name)},${item.frequency},${item.amount},${normalize(item.amount, item.frequency).toFixed(2)}\n`;
        });
        state.categories.forEach((cat) => {
          cat.items.forEach((item) => {
            csv += `Expense,${csvClean(getCategoryDisplayName(cat))},${csvClean(item.name)},${item.frequency},${item.amount},${normalize(item.amount, item.frequency).toFixed(2)}\n`;
          });
        });

        const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `myrealbudget-planner-${new Date().toISOString().split("T")[0]}.csv`;
        a.click();
        URL.revokeObjectURL(url);
      });
    }

    function csvClean(str) {
      let s = String(str || "");
      if (/^[=+\-@]/.test(s)) {
        s = "'" + s;
      }
      return '"' + s.replace(/"/g, '""') + '"';
    }

    // Listen for global currency and language updates
    window.addEventListener("myrealbudget:currency-change", () => {
      document
        .querySelectorAll("#general-budget-planner .currency-symbol")
        .forEach((el) => {
          el.textContent = getCurrencySymbol();
        });
      if (isExampleMode) {
        state = JSON.parse(JSON.stringify(getDefaultDataForCurrency()));
      }
      renderIncome();
      renderCategories();
      calculateAndRenderResults();
    });

    window.addEventListener("myrealbudget:language-change", () => {
      renderIncome();
      renderCategories();
      calculateAndRenderResults();
    });

    // Initial Boot
    updateExampleBanner();
    renderIncome();
    renderCategories();
    calculateAndRenderResults();
  })();
</script>
