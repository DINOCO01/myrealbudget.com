    function getCurrentCurrencyCode() {
      if (
        window._mrb_currency &&
        typeof window._mrb_currency.get === "function"
      ) {
        return window._mrb_currency.get();
      }
      return (
        (typeof localStorage !== "undefined" &&
          localStorage.getItem("myrealbudget_currency")) ||
        "USD"
      );
    }

    function getDefaultDataForCurrency() {
      return getCurrentCurrencyCode() === "INR" ? defaultDataINR : defaultData;
    }

    const BUILTIN_CATEGORY_ALIASES = {
      cat_housing: "housing",
      cat_utilities: "utilities",
      cat_food: "food_groceries",
      cat_transportation: "transportation",
      cat_insurance: "insurance_healthcare",
      cat_debt: "debt_payments",
      cat_subscriptions: "subscriptions_lifestyle",
      cat_savings: "savings_investments",
    };

    function resolveBuiltinCategoryId(catId, catName) {
      if (
        window._mrb_i18n &&
        typeof window._mrb_i18n.getBuiltinCategoryId === "function"
      ) {
        return window._mrb_i18n.getBuiltinCategoryId(catId, catName);
      }
      if (catId && BUILTIN_CATEGORY_ALIASES[catId]) {
        return BUILTIN_CATEGORY_ALIASES[catId];
      }
      return null;
    }

    function normalizeCategory(cat) {
      if (!cat) return cat;
      const bId = cat.categoryId || resolveBuiltinCategoryId(cat.id, cat.name);
      if (bId) {
        cat.categoryId = bId;
        const canon =
          window._mrb_i18n &&
          typeof window._mrb_i18n.getCanonicalCategoryName === "function"
            ? window._mrb_i18n.getCanonicalCategoryName(bId)
            : null;
        if (canon) cat.name = canon;
      }
      return cat;
    }

    function getCategoryDisplayName(cat) {
      if (!cat) return "";
      if (
        window._mrb_i18n &&
        typeof window._mrb_i18n.translateCategory === "function"
      ) {
        if (cat.categoryId) {
          return window._mrb_i18n.translateCategory(cat.categoryId);
        }
        return window._mrb_i18n.translateCategory(cat.name);
      }
      return cat.name;
    }

    const MONEY_TOLERANCE =
      (window._mrb_currency && window._mrb_currency.tolerance) || 0.005;

    function sanitizeAmount(val) {
      if (
        window._mrb_currency &&
        typeof window._mrb_currency.sanitizeAmount === "function"
      ) {
        return window._mrb_currency.sanitizeAmount(val);
      }
      const num = Number(val);
      if (!isFinite(num) || isNaN(num) || num <= 0 || num > Number.MAX_SAFE_INTEGER / 100) return 0;
      return Math.round(num * 100) / 100;
    }

    function cleanMoney(val) {
      if (
        window._mrb_currency &&
        typeof window._mrb_currency.cleanMoney === "function"
      ) {
        return window._mrb_currency.cleanMoney(val);
      }
      const num = Number(val);
      if (!isFinite(num) || isNaN(num) || Math.abs(num) < MONEY_TOLERANCE || Object.is(num, -0) || Math.abs(num) > Number.MAX_SAFE_INTEGER / 100)
        return 0;
      const rounded = Math.round(num * 100) / 100;
      return (!isFinite(rounded) || Math.abs(rounded) < MONEY_TOLERANCE || Object.is(rounded, -0)) ? 0 : rounded;
    }

    function getEmptyData() {
      return { income: [], categories: [] };
    }

    let isExampleMode = false;
    let state = loadState();

    function updateExampleBanner() {
      const banner = document.getElementById("gbp-example-banner");
      if (!banner) return;
      if (isExampleMode) {
        banner.classList.remove("hidden");
        banner.classList.add("flex");
      } else {
        banner.classList.remove("flex");
        banner.classList.add("hidden");
      }
    }

    function markAsCustomized() {
      if (isExampleMode) {
        isExampleMode = false;
        updateExampleBanner();
      }
    }

    function loadExample() {
      isExampleMode = true;
      state = JSON.parse(JSON.stringify(getDefaultDataForCurrency()));
      updateExampleBanner();
      renderIncome();
      renderCategories();
      calculateAndRenderResults();
    }

    function clearExample() {
      isExampleMode = false;
      state = getEmptyData();
      updateExampleBanner();
      renderIncome();
      renderCategories();
      calculateAndRenderResults();
    }

    function loadState() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          if (
            Array.isArray(parsed.income) &&
            Array.isArray(parsed.categories)
          ) {
            parsed.income.forEach((item) => {
              item.amount = sanitizeAmount(item.amount);
            });
            parsed.categories.forEach((cat) => {
              normalizeCategory(cat);
              if (typeof cat.isSavings !== "boolean") {
                const catId = (cat.id || "").toLowerCase();
                const catName = (cat.name || "").toLowerCase();
                const bId = (cat.categoryId || "").toLowerCase();
                cat.isSavings =
                  bId.includes("saving") ||
                  bId.includes("invest") ||
                  catId.includes("saving") ||
                  catId.includes("invest") ||
                  catName.includes("saving") ||
                  catName.includes("invest") ||
                  catName.includes("emergency");
              }
              if (Array.isArray(cat.items)) {
                cat.items.forEach((item) => {
                  item.amount = sanitizeAmount(item.amount);
                  if (typeof item.isSavings !== "boolean") {
                    item.isSavings = Boolean(cat.isSavings);
                  }
                });
              }
            });
            return parsed;
          }
        }
      } catch (e) {
        console.warn("LocalStorage error:", e);
      }
      return getEmptyData();
    }

    function saveState() {
      if (isExampleMode) return;
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (e) {
        console.warn("Failed to save to localStorage:", e);
      }
    }

    function normalize(amount, freq) {
      const mult = FREQUENCY_MULTIPLIERS[freq] || 1;
      const sanitized = sanitizeAmount(amount);
      return sanitized * mult;
    }

    function validateNumericInput(el, rawVal) {
      if (!el) return false;
      const str = String(rawVal ?? "").trim();
      const num = Number(rawVal);
      const isNeg = str.startsWith("-") || num < 0;
      if (isNeg) {
        el.classList.add("!border-[#ee0000]", "!text-[#ee0000]", "focus:!border-[#ee0000]");
        el.setAttribute("aria-invalid", "true");
      } else {
        el.classList.remove("!border-[#ee0000]", "!text-[#ee0000]", "focus:!border-[#ee0000]");
        el.removeAttribute("aria-invalid");
      }
      return isNeg;
    }

    function t(k, vars) {
      if (window._mrb_i18n && typeof window._mrb_i18n.t === "function") {
        return window._mrb_i18n.t(k, vars);
      }
      return k;
    }

    function getCurrencySymbol() {
      if (
        window._mrb_currency &&
        typeof window._mrb_currency.symbol === "function"
      ) {
        return window._mrb_currency.symbol();
      }
      const curr =
        (typeof localStorage !== "undefined" &&
          localStorage.getItem("myrealbudget_currency")) ||
        "USD";
      const syms = {
        USD: "$",
        EUR: "€",
        GBP: "£",
        INR: "₹",
        CAD: "C$",
        AUD: "A$",
      };
      return syms[curr] || "$";
    }

    function formatMoney(amount) {
      amount = cleanMoney(amount);
      if (
        window._mrb_currency &&
        typeof window._mrb_currency.format === "function"
      ) {
        return window._mrb_currency.format(amount);
      }
      const sym = getCurrencySymbol();
      if (!isFinite(amount) || isNaN(amount)) {
        return sym + "0";
      }
      const curr =
        (typeof localStorage !== "undefined" &&
          localStorage.getItem("myrealbudget_currency")) ||
        "USD";
      const locale = curr === "INR" ? "en-IN" : "en-US";
      const hasCents = amount % 1 !== 0;
      const formatted = new Intl.NumberFormat(locale, {
        minimumFractionDigits: hasCents ? 2 : 0,
        maximumFractionDigits: hasCents ? 2 : 0,
      }).format(Math.abs(amount));
      const sign =
        amount < 0 && Math.abs(amount) >= MONEY_TOLERANCE ? "-" : "";
      return sign + sym + formatted;
    }

