---
import { FREQUENCY_OPTIONS } from "../../utils/frequency";
import CurrencyLanguageControls from "../ui/CurrencyLanguageControls.astro";
---

<div id="fifty-thirty-twenty-planner" class="w-full">
  <!-- Privacy & Quick Action strip -->
  <div
    class="mb-4 sm:mb-6 flex flex-wrap items-center justify-between gap-2.5 sm:gap-3 text-[11px] sm:text-xs"
  >
    <div
      class="inline-flex items-center gap-1.5 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-full bg-white border border-[#ebebeb] text-[#4d4d4d] shadow-whisper"
    >
      <span class="w-2 h-2 rounded-full bg-[#50e3c2]"></span>
      <span data-mrb-t="common.autosaved">Autosaved locally to this device</span
      >
    </div>
    <div class="flex items-center gap-2">
      <CurrencyLanguageControls idPrefix="f3020" />
      <button
        type="button"
        id="f3020-reset-btn"
        data-mrb-t="common.reset_defaults"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-[6px] border border-[#ebebeb] bg-white text-[#8f8f8f] hover:text-[#ee0000] font-medium hover:bg-neutral-50 transition shadow-whisper focus-visible:outline-none"
      >
        Reset Defaults
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-8 items-start">
    <!-- LEFT: Inputs (7 cols on lg) -->
    <div class="lg:col-span-7 xl:col-span-8 space-y-4 sm:space-y-6">
      <!-- 1. Take-Home Pay Input -->
      <div
        class="bg-white rounded-[12px] border border-[#ebebeb] p-3.5 sm:p-6 shadow-whisper"
      >
        <label
          for="f3020-income-input"
          class="block text-xs sm:text-sm font-semibold text-[#171717] mb-0.5 sm:mb-1"
          data-mrb-t="f3020.take_home_label"
        >
          Monthly Take-Home Pay (After Taxes)
        </label>
        <p
          class="text-[11px] sm:text-xs text-[#8f8f8f] mb-3 sm:mb-4"
          data-mrb-t="f3020.take_home_desc"
        >
          Enter your total net monthly income. If paid biweekly, multiply your
          paycheck by 26 and divide by 12.
        </p>
        <div class="flex items-center gap-2 max-w-md">
          <div class="relative flex-1">
            <span
              class="currency-symbol absolute left-3 top-2 sm:left-3.5 sm:top-2.5 text-[#8f8f8f] font-mono text-sm sm:text-base"
              >$</span
            >
            <input
              type="number"
              id="f3020-income-input"
              min="0"
              step="50"
              value="5000"
              class="w-full pl-7 pr-3 py-2 sm:pl-8 sm:pr-4 sm:py-2.5 rounded-[6px] bg-white border border-[#ebebeb] text-[#171717] font-mono text-base sm:text-lg font-semibold focus:outline-none focus:border-[#171717] shadow-whisper"
              placeholder="5000"
            />
          </div>
          <select
            id="f3020-income-frequency"
            aria-label="Income Frequency"
            class="px-2 sm:px-3 py-2 sm:py-2.5 rounded-[6px] bg-white border border-[#ebebeb] text-[#4d4d4d] focus:outline-none focus:border-[#171717] text-xs sm:text-sm font-mono shrink-0 shadow-whisper"
          >
            <option value="monthly" selected>Monthly</option>
            <option value="weekly">Weekly</option>
            <option value="biweekly">Every 2 wks</option>
            <option value="quarterly">Quarterly</option>
            <option value="semiannual">Semi-Annual</option>
            <option value="yearly">Yearly</option>
          </select>
        </div>
      </div>

      <!-- Mobile Quick Snapshot (Visible only on mobile/tablet < lg) -->
      <div
        class="lg:hidden bg-white rounded-[10px] border border-[#ebebeb] p-3 shadow-whisper"
      >
        <div
          class="flex items-center justify-between pb-2 mb-2 border-b border-[#ebebeb]"
        >
          <div class="flex items-center gap-1.5">
            <span
              class="text-xs font-semibold text-[#171717]"
              data-mrb-t="summary.remaining">Remaining</span
            >
            <span
              id="mobile-f3020-unassigned-val"
              class="font-mono text-base font-bold text-[#171717]"
              data-mrb-currency-val="0">$0</span
            >
          </div>
          <div
            id="mobile-f3020-status-badge"
            class="px-2 py-0.5 rounded text-[11px] font-medium bg-[#f2f2f2] text-[#4d4d4d]"
          >
            <span id="mobile-f3020-status-text" data-mrb-t="summary.balanced"
              >Balanced</span
            >
          </div>
        </div>
        <div class="grid grid-cols-3 gap-1.5 text-center text-xs font-mono">
          <div class="bg-[#fafafa] py-1 px-1.5 rounded border border-[#ebebeb]">
            <span
              class="text-[10px] text-[#8f8f8f] block truncate"
              data-mrb-t="f3020.needs_title">Needs (50%)</span
            >
            <span
              id="mobile-f3020-needs-val"
              class="font-semibold text-[#171717] text-xs block"
              data-mrb-currency-val="0">$0</span
            >
            <span
              id="mobile-f3020-needs-target"
              class="text-[9px] text-[#8f8f8f] block"
              data-mrb-currency-prefix-val="2500">/ $2,500</span
            >
          </div>
          <div class="bg-[#fafafa] py-1 px-1.5 rounded border border-[#ebebeb]">
            <span
              class="text-[10px] text-[#8f8f8f] block truncate"
              data-mrb-t="f3020.wants_title">Wants (30%)</span
            >
            <span
              id="mobile-f3020-wants-val"
              class="font-semibold text-[#7928ca] text-xs block"
              data-mrb-currency-val="0">$0</span
            >
            <span
              id="mobile-f3020-wants-target"
              class="text-[9px] text-[#8f8f8f] block"
              data-mrb-currency-prefix-val="1500">/ $1,500</span
            >
          </div>
          <div class="bg-[#fafafa] py-1 px-1.5 rounded border border-[#ebebeb]">
            <span
              class="text-[10px] text-[#8f8f8f] block truncate"
              data-mrb-t="f3020.savings_title">Savings (20%)</span
            >
            <span
              id="mobile-f3020-savings-val"
              class="font-semibold text-[#0070f3] text-xs block"
              data-mrb-currency-val="0">$0</span
            >
            <span
              id="mobile-f3020-savings-target"
              class="text-[9px] text-[#8f8f8f] block"
              data-mrb-currency-prefix-val="1000">/ $1,000</span
            >
          </div>
        </div>
        <div
          class="flex items-center justify-between text-[11px] text-[#8f8f8f] pt-2 mt-1"
        >
          <span
            ><span data-mrb-t="summary.actual_outflow">Actual Outflow:</span>
            <strong
              id="mobile-f3020-total-outflow"
              class="text-[#171717] font-mono"
              data-mrb-currency-val="0">$0</strong
            ></span
          >
          <div class="flex sm:hidden items-center gap-1.5">
            <button
              type="button"
              class="hover:text-[#171717] underline text-[11px]"
              data-mrb-t="common.expand_all"
              onclick="window._f3020.toggleAllSections(true)"
            >
              Expand all
            </button>
            <span>·</span>
            <button
              type="button"
              class="hover:text-[#171717] underline text-[11px]"
              data-mrb-t="common.collapse_all"
              onclick="window._f3020.toggleAllSections(false)"
            >
              Collapse all
            </button>
          </div>
        </div>
      </div>

      <!-- 2. Needs (50%) Inputs -->
      <div
        class="bg-white rounded-[10px] sm:rounded-[12px] border border-[#ebebeb] p-2.5 sm:p-6 shadow-whisper"
      >
        <div
          class="flex items-center justify-between pb-1.5 sm:pb-3 border-b border-[#ebebeb] cursor-pointer sm:cursor-default select-none sm:select-auto gap-2"
          onclick="if(window.innerWidth < 640) window._f3020.toggleSection('needs')"
        >
          <div
            class="flex items-center gap-1.5 sm:gap-2 flex-1 min-w-0 pr-1 sm:pr-2"
          >
            <button
              type="button"
              id="f3020-btn-needs"
              class="sm:hidden p-0.5 text-[#8f8f8f] hover:text-[#171717] transition-transform duration-200 shrink-0 rotate-180"
              aria-label="Toggle Needs items"
              data-mrb-t-aria="aria.toggle_needs"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path></svg
              >
            </button>
            <span
              class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-[#171717] shrink-0"
            ></span>
            <div class="flex-1 min-w-0">
              <h3
                class="text-xs sm:text-base font-semibold text-[#171717] truncate sm:whitespace-normal"
              >
                <span data-mrb-t="f3020.needs_title">Needs</span>
                <span
                  class="text-[11px] sm:text-xs font-normal text-[#8f8f8f]"
                  data-mrb-t="f3020.needs_target_label">(Target: 50%)</span>
              </h3>
              <p
                class="hidden sm:block text-xs text-[#8f8f8f] mt-0.5"
                data-mrb-t="f3020.needs_desc"
              >
                Housing, utilities, groceries, gas/transit, insurance, minimum
                debt payments.
              </p>
            </div>
          </div>
          <div class="text-right shrink-0">
            <span
              class="hidden sm:block text-xs font-mono text-[#8f8f8f]"
              data-mrb-t="summary.actual">Actual</span
            >
            <span
              id="f3020-needs-actual-header"
              class="font-mono text-xs sm:text-sm font-semibold text-[#171717]"
              data-mrb-currency-val="0">$0</span
            >
          </div>
        </div>

        <div id="f3020-body-needs" class="block sm:!block pt-2 sm:pt-3">
          <div id="f3020-needs-items" class="space-y-1.5 sm:space-y-2">
            <!-- Populated by JS -->
          </div>

          <button
            type="button"
            class="mt-2 inline-flex items-center gap-1.5 text-xs text-[#4d4d4d] hover:text-[#171717] font-medium py-1 px-1.5 rounded hover:bg-[#fafafa] transition"
            onclick="window._f3020.addItem('needs')"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"></path></svg
            >
            <span data-mrb-t="f3020.add_need">Add Need Line Item</span>
          </button>
        </div>
      </div>

      <!-- 3. Wants (30%) Inputs -->
      <div
        class="bg-white rounded-[10px] sm:rounded-[12px] border border-[#ebebeb] p-2.5 sm:p-6 shadow-whisper"
      >
        <div
          class="flex items-center justify-between pb-1.5 sm:pb-3 border-b border-[#ebebeb] cursor-pointer sm:cursor-default select-none sm:select-auto gap-2"
          onclick="if(window.innerWidth < 640) window._f3020.toggleSection('wants')"
        >
          <div
            class="flex items-center gap-1.5 sm:gap-2 flex-1 min-w-0 pr-1 sm:pr-2"
          >
            <button
              type="button"
              id="f3020-btn-wants"
              class="sm:hidden p-0.5 text-[#8f8f8f] hover:text-[#171717] transition-transform duration-200 shrink-0"
              aria-label="Toggle Wants items"
              data-mrb-t-aria="aria.toggle_wants"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path></svg
              >
            </button>
            <span
              class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-[#7928ca] shrink-0"
            ></span>
            <div class="flex-1 min-w-0">
              <h3
                class="text-xs sm:text-base font-semibold text-[#171717] truncate sm:whitespace-normal"
              >
                <span data-mrb-t="f3020.wants_title">Wants</span>
                <span
                  class="text-[11px] sm:text-xs font-normal text-[#8f8f8f]"
                  data-mrb-t="f3020.wants_target_label">(Target: 30%)</span>
              </h3>
              <p
                class="hidden sm:block text-xs text-[#8f8f8f] mt-0.5"
                data-mrb-t="f3020.wants_desc"
              >
                Dining out, entertainment, shopping, subscriptions, vacations,
                hobbies.
              </p>
            </div>
          </div>
          <div class="text-right shrink-0">
            <span
              class="hidden sm:block text-xs font-mono text-[#8f8f8f]"
              data-mrb-t="summary.actual">Actual</span
            >
            <span
              id="f3020-wants-actual-header"
              class="font-mono text-xs sm:text-sm font-semibold text-[#171717]"
              data-mrb-currency-val="0">$0</span
            >
          </div>
        </div>

        <div id="f3020-body-wants" class="hidden sm:!block pt-2 sm:pt-3">
          <div id="f3020-wants-items" class="space-y-1.5 sm:space-y-2">
            <!-- Populated by JS -->
          </div>

          <button
            type="button"
            class="mt-2 inline-flex items-center gap-1.5 text-xs text-[#4d4d4d] hover:text-[#171717] font-medium py-1 px-1.5 rounded hover:bg-[#fafafa] transition"
            onclick="window._f3020.addItem('wants')"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"></path></svg
            >
            <span data-mrb-t="f3020.add_want">Add Want Line Item</span>
          </button>
        </div>
      </div>

      <!-- 4. Savings & Debt (20%) Inputs -->
      <div
        class="bg-white rounded-[10px] sm:rounded-[12px] border border-[#ebebeb] p-2.5 sm:p-6 shadow-whisper"
      >
        <div
          class="flex items-center justify-between pb-1.5 sm:pb-3 border-b border-[#ebebeb] cursor-pointer sm:cursor-default select-none sm:select-auto gap-2"
          onclick="if(window.innerWidth < 640) window._f3020.toggleSection('savings')"
        >
          <div
            class="flex items-center gap-1.5 sm:gap-2 flex-1 min-w-0 pr-1 sm:pr-2"
          >
            <button
              type="button"
              id="f3020-btn-savings"
              class="sm:hidden p-0.5 text-[#8f8f8f] hover:text-[#171717] transition-transform duration-200 shrink-0"
              aria-label="Toggle Savings items"
              data-mrb-t-aria="aria.toggle_savings"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path></svg
              >
            </button>
            <span
              class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-[#0070f3] shrink-0"
            ></span>
            <div class="flex-1 min-w-0">
              <h3
                class="text-xs sm:text-base font-semibold text-[#171717] truncate sm:whitespace-normal"
              >
                <span data-mrb-t="f3020.savings_title">Savings & Debt</span>
                <span
                  class="text-[11px] sm:text-xs font-normal text-[#8f8f8f]"
                  data-mrb-t="f3020.savings_target_label">(Target: 20%)</span>
              </h3>
              <p
                class="hidden sm:block text-xs text-[#8f8f8f] mt-0.5"
                data-mrb-t="f3020.savings_desc"
              >
                Emergency funds, 401(k)/IRA contributions, extra principal debt
                payoffs.
              </p>
            </div>
          </div>
          <div class="text-right shrink-0">
            <span
              class="hidden sm:block text-xs font-mono text-[#8f8f8f]"
              data-mrb-t="summary.actual">Actual</span
            >
            <span
              id="f3020-savings-actual-header"
              class="font-mono text-xs sm:text-sm font-semibold text-[#171717]"
              data-mrb-currency-val="0">$0</span
            >
          </div>
        </div>

        <div id="f3020-body-savings" class="hidden sm:!block pt-2 sm:pt-3">
          <div id="f3020-savings-items" class="space-y-1.5 sm:space-y-2">
            <!-- Populated by JS -->
          </div>

          <button
            type="button"
            class="mt-2 inline-flex items-center gap-1.5 text-xs text-[#4d4d4d] hover:text-[#171717] font-medium py-1 px-1.5 rounded hover:bg-[#fafafa] transition"
            onclick="window._f3020.addItem('savings')"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"></path></svg
            >
            <span data-mrb-t="f3020.add_saving">Add Savings/Debt Line Item</span
            >
          </button>
        </div>
      </div>
    </div>

    <!-- RIGHT: Target vs Actual Comparison Card (Sticky on Desktop) -->
    <div
      class="lg:col-span-5 xl:col-span-4 lg:sticky lg:top-24 space-y-4 sm:space-y-6"
    >
      <div
        class="bg-white rounded-[12px] border border-[#ebebeb] p-4 sm:p-6 shadow-whisper"
      >
        <span
          class="font-mono text-[11px] sm:text-xs uppercase tracking-wider text-[#8f8f8f] block mb-0.5 sm:mb-1"
          data-mrb-t="f3020.rule_summary"
        >
          50/30/20 Targets vs Actual
        </span>
        <h3
          class="text-base sm:text-lg font-semibold text-[#171717] tracking-tight mb-3 sm:mb-5"
          data-mrb-t="summary.budget_summary"
        >
          Plan Comparison
        </h3>

        <!-- Comparison Cards -->
        <div class="space-y-2.5 sm:space-y-4">
          <!-- Needs Row -->
          <div
            class="p-2.5 sm:p-3.5 rounded-[8px] bg-[#fafafa] border border-[#ebebeb]"
          >
            <div class="flex justify-between items-center mb-1.5">
              <span
                class="font-semibold text-xs text-[#171717] flex items-center gap-1.5"
              >
                <span class="w-2 h-2 rounded-full bg-[#171717]"></span>
                <span data-mrb-t="f3020.needs_title">Needs (50%)</span>
              </span>
              <span
                id="cmp-needs-diff"
                class="font-mono text-xs font-semibold"
                data-mrb-currency-val="0"
              >
                $0
              </span>
            </div>
            <div
              class="flex justify-between text-[11px] sm:text-xs text-[#8f8f8f] mb-1.5 sm:mb-2 font-mono"
            >
              <span
                ><span data-mrb-t="summary.target">Target</span>: <strong
                  id="cmp-needs-target"
                  class="text-[#171717]"
                  data-mrb-currency-val="2500">$2,500</strong
                ></span
              >
              <span
                ><span data-mrb-t="summary.actual">Actual</span>: <strong
                  id="cmp-needs-actual"
                  class="text-[#171717]"
                  data-mrb-currency-val="0">$0</strong
                ></span
              >
            </div>
            <div
              class="w-full h-1.5 sm:h-2 rounded-full bg-[#ebebeb] overflow-hidden"
            >
              <div
                id="cmp-needs-bar"
                class="h-full bg-[#171717] transition-all duration-300"
                style="width: 0%"
              >
              </div>
            </div>
          </div>

          <!-- Wants Row -->
          <div
            class="p-2.5 sm:p-3.5 rounded-[8px] bg-[#fafafa] border border-[#ebebeb]"
          >
            <div class="flex justify-between items-center mb-1.5">
              <span
                class="font-semibold text-xs text-[#171717] flex items-center gap-1.5"
              >
                <span class="w-2 h-2 rounded-full bg-[#7928ca]"></span>
                <span data-mrb-t="f3020.wants_title">Wants (30%)</span>
              </span>
              <span
                id="cmp-wants-diff"
                class="font-mono text-xs font-semibold"
                data-mrb-currency-val="0"
              >
                $0
              </span>
            </div>
            <div
              class="flex justify-between text-[11px] sm:text-xs text-[#8f8f8f] mb-1.5 sm:mb-2 font-mono"
            >
              <span
                ><span data-mrb-t="summary.target">Target</span>: <strong
                  id="cmp-wants-target"
                  class="text-[#171717]"
                  data-mrb-currency-val="1500">$1,500</strong
                ></span
              >
              <span
                ><span data-mrb-t="summary.actual">Actual</span>: <strong
                  id="cmp-wants-actual"
                  class="text-[#171717]"
                  data-mrb-currency-val="0">$0</strong
                ></span
              >
            </div>
            <div
              class="w-full h-1.5 sm:h-2 rounded-full bg-[#ebebeb] overflow-hidden"
            >
              <div
                id="cmp-wants-bar"
                class="h-full bg-[#7928ca] transition-all duration-300"
                style="width: 0%"
              >
              </div>
            </div>
          </div>

          <!-- Savings Row -->
          <div
            class="p-2.5 sm:p-3.5 rounded-[8px] bg-[#fafafa] border border-[#ebebeb]"
          >
            <div class="flex justify-between items-center mb-1.5">
              <span
                class="font-semibold text-xs text-[#171717] flex items-center gap-1.5"
              >
                <span class="w-2 h-2 rounded-full bg-[#0070f3]"></span>
                <span data-mrb-t="f3020.savings_title"
                  >Savings & Debt (20%)</span
                >
              </span>
              <span
                id="cmp-savings-diff"
                class="font-mono text-xs font-semibold"
                data-mrb-currency-val="0"
              >
                $0
              </span>
            </div>
            <div
              class="flex justify-between text-[11px] sm:text-xs text-[#8f8f8f] mb-1.5 sm:mb-2 font-mono"
            >
              <span
                ><span data-mrb-t="summary.target">Target</span>: <strong
                  id="cmp-savings-target"
                  class="text-[#171717]"
                  data-mrb-currency-val="1000">$1,000</strong
                ></span
              >
              <span
                ><span data-mrb-t="summary.actual">Actual</span>: <strong
                  id="cmp-savings-actual"
                  class="text-[#171717]"
                  data-mrb-currency-val="0">$0</strong
                ></span
              >
            </div>
            <div
              class="w-full h-1.5 sm:h-2 rounded-full bg-[#ebebeb] overflow-hidden"
            >
              <div
                id="cmp-savings-bar"
                class="h-full bg-[#0070f3] transition-all duration-300"
                style="width: 0%"
              >
              </div>
            </div>
          </div>
        </div>

        <!-- Overall Budget Net Balance -->
        <div
          class="mt-4 sm:mt-5 pt-3 sm:pt-4 border-t border-[#ebebeb] flex justify-between items-baseline text-xs"
        >
          <span class="text-[#8f8f8f]" data-mrb-t="summary.actual_outflow"
            >Total Actual Outflow:</span
          >
          <span
            id="cmp-total-outflow"
            class="font-mono font-semibold text-xs sm:text-sm text-[#171717]"
            data-mrb-currency-val="0">$0</span
          >
        </div>
        <div class="mt-1 flex justify-between items-baseline text-xs">
          <span class="text-[#8f8f8f]" data-mrb-t="f3020.unassigned_cash"
            >Unassigned Cash Flow:</span
          >
          <span
            id="cmp-unassigned-cash"
            class="font-mono font-semibold text-xs sm:text-sm text-[#171717]"
            data-mrb-currency-val="0">$0</span
          >
        </div>

        <!-- Plain Language Interpretation (Secondary Breakdown) -->
        <details
          class="group mt-4 sm:mt-6 pt-3 sm:pt-5 border-t border-[#ebebeb] space-y-2"
        >
          <summary
            class="flex items-center justify-between font-mono text-[11px] sm:text-xs font-medium uppercase tracking-wider text-[#8f8f8f] cursor-pointer list-none select-none py-0.5"
          >
            <span data-mrb-t="gbp.live_assessment">Framework Assessment</span>
            <svg
              class="w-3.5 h-3.5 text-[#8f8f8f] transition-transform duration-200 group-open:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <div
            id="f3020-assessment-box"
            class="space-y-2 text-xs text-[#4d4d4d] leading-relaxed pt-1"
          >
            <!-- Dynamic assessment generated by JS -->
          </div>
        </details>
      </div>

      <!-- Educational Note (Collapsed by default) -->
      <details
        class="group bg-[#fafafa] rounded-[10px] sm:rounded-[12px] border border-[#ebebeb] p-3 sm:p-4 text-xs text-[#4d4d4d] space-y-1.5"
      >
        <summary
          class="flex items-center justify-between font-medium text-[#171717] cursor-pointer list-none select-none"
        >
          <span data-mrb-t="f3020.guide_title"
            >Remember: 50/30/20 is a guide, not a law</span
          >
          <svg
            class="w-3.5 h-3.5 text-[#8f8f8f] transition-transform duration-200 group-open:rotate-180"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path></svg
          >
        </summary>
        <p
          class="text-[11px] sm:text-[12px] text-[#8f8f8f] leading-normal pt-1"
          data-mrb-t="f3020.guide_desc"
        >
          In high-cost-of-living metropolitan areas, housing alone often
          consumes 35–45% of income, pushing Needs toward 60%. If your Needs are
          higher, look to balance by temporarily scaling back Wants rather than
          abandoning the plan entirely.
        </p>
      </details>

      <!-- Quick Method Switcher -->
      <div
        class="bg-[#fafafa] rounded-[10px] sm:rounded-[12px] border border-[#ebebeb] p-3 sm:p-4 text-xs text-[#4d4d4d] space-y-1.5"
      >
        <p
          class="font-medium text-[#171717]"
          data-mrb-t="common.try_another_method"
        >
          Want to try another budgeting method?
        </p>
        <p
          class="text-[11px] sm:text-[12px] text-[#8f8f8f]"
          data-mrb-t-html="f3020.switch_methods_desc"
        >
          Switch to the <a
            href="/budget-planner/"
            class="text-[#0070f3] underline hover:text-[#0761d1]"
            >General Budget</a
          > for flexible categories, or the <a
            href="/zero-based-budget/"
            class="text-[#0070f3] underline hover:text-[#0761d1]"
            >Zero-Based Method</a
          > to allocate every dollar to zero.
        </p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const STORAGE_KEY = "myrealbudget_503020_v1";

    const FREQUENCY_MULTIPLIERS = {
      weekly: 52 / 12,
      biweekly: 26 / 12,
      monthly: 1,
      quarterly: 4 / 12,
      semiannual: 2 / 12,
      yearly: 1 / 12,
    };

    const FREQUENCY_OPTIONS = [
      { id: "monthly", label: "Monthly" },
      { id: "weekly", label: "Weekly" },
      { id: "biweekly", label: "Every 2 wks" },
      { id: "quarterly", label: "Quarterly" },
      { id: "semiannual", label: "Semi-Annual" },
      { id: "yearly", label: "Yearly" },
    ];

    const defaultData = {
      income: 5000,
      incomeFrequency: "monthly",
      needs: [
        {
          id: "n1",
          name: "Rent / Mortgage",
          amount: 1600,
          frequency: "monthly",
        },
        {
          id: "n2",
          name: "Groceries & Essentials",
          amount: 125,
          frequency: "weekly",
        },
        {
          id: "n3",
          name: "Utilities & Internet",
          amount: 240,
          frequency: "monthly",
        },
        {
          id: "n4",
          name: "Car Loan & Insurance",
          amount: 420,
          frequency: "monthly",
        },
        {
          id: "n5",
          name: "Health & Prescriptions",
          amount: 65,
          frequency: "monthly",
        },
      ],
      wants: [
        {
          id: "w1",
          name: "Dining Out & Takeaway",
          amount: 60,
          frequency: "weekly",
        },
        {
          id: "w2",
          name: "Entertainment & Hobbies",
          amount: 120,
          frequency: "monthly",
        },
        {
          id: "w3",
          name: "Streaming & Subscriptions",
          amount: 55,
          frequency: "monthly",
        },
        {
          id: "w4",
          name: "Shopping & Personal Care",
          amount: 150,
          frequency: "monthly",
        },
      ],
      savings: [
        {
          id: "s1",
          name: "Emergency Savings Account",
          amount: 400,
          frequency: "monthly",
        },
        {
          id: "s2",
          name: "Roth IRA / Retirement",
          amount: 350,
          frequency: "monthly",
        },
        {
          id: "s3",
          name: "Extra Student Debt Paydown",
          amount: 200,
          frequency: "monthly",
        },
      ],
    };

    let state = loadState();

    const MONEY_TOLERANCE =
      (window._mrb_currency && window._mrb_currency.tolerance) || 0.005;

    function sanitizeAmount(val) {
      if (
        window._mrb_currency &&
        typeof window._mrb_currency.sanitizeAmount === "function"
      ) {
        return window._mrb_currency.sanitizeAmount(val);
      }
      const n = typeof val === "number" ? val : parseFloat(val);
      if (isNaN(n) || !isFinite(n) || n <= 0 || n > Number.MAX_SAFE_INTEGER / 100) return 0;
      return Math.round(n * 100) / 100;
    }

    function cleanMoney(val) {
      if (
        window._mrb_currency &&
        typeof window._mrb_currency.cleanMoney === "function"
      ) {
        return window._mrb_currency.cleanMoney(val);
      }
      const num = Number(val);
      if (!isFinite(num) || isNaN(num) || Math.abs(num) < MONEY_TOLERANCE || Object.is(num, -0) || Math.abs(num) > Number.MAX_SAFE_INTEGER / 100)
        return 0;
      const rounded = Math.round(num * 100) / 100;
      return (!isFinite(rounded) || Math.abs(rounded) < MONEY_TOLERANCE || Object.is(rounded, -0)) ? 0 : rounded;
    }

    function loadState() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          if (
            typeof parsed.income === "number" &&
            !isNaN(parsed.income) &&
            Array.isArray(parsed.needs) &&
            Array.isArray(parsed.wants) &&
            Array.isArray(parsed.savings)
          ) {
            parsed.income = sanitizeAmount(parsed.income);
            parsed.incomeFrequency = parsed.incomeFrequency || "monthly";
            parsed.needs.forEach((i) => (i.amount = sanitizeAmount(i.amount)));
            parsed.wants.forEach((i) => (i.amount = sanitizeAmount(i.amount)));
            parsed.savings.forEach(
              (i) => (i.amount = sanitizeAmount(i.amount)),
            );
            return parsed;
          }
        }
      } catch (e) {
        console.warn("LocalStorage error:", e);
      }
      return JSON.parse(JSON.stringify(defaultData));
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (e) {
        console.warn("Failed to save to localStorage:", e);
      }
    }

    function normalize(amount, freq) {
      return sanitizeAmount(amount) * (FREQUENCY_MULTIPLIERS[freq] || 1);
    }

    function validateNumericInput(el, rawVal) {
      if (!el) return false;
      const str = String(rawVal ?? "").trim();
      const num = Number(rawVal);
      const isNeg = str.startsWith("-") || num < 0;
      if (isNeg) {
        el.classList.add("!border-[#ee0000]", "!text-[#ee0000]", "focus:!border-[#ee0000]");
        el.setAttribute("aria-invalid", "true");
      } else {
        el.classList.remove("!border-[#ee0000]", "!text-[#ee0000]", "focus:!border-[#ee0000]");
        el.removeAttribute("aria-invalid");
      }
      return isNeg;
    }

    function t(k, vars) {
      if (window._mrb_i18n && typeof window._mrb_i18n.t === "function") {
        return window._mrb_i18n.t(k, vars);
      }
      return k;
    }

    function getCurrencySymbol() {
      if (
        window._mrb_currency &&
        typeof window._mrb_currency.symbol === "function"
      ) {
        return window._mrb_currency.symbol();
      }
      const curr =
        (typeof localStorage !== "undefined" &&
          localStorage.getItem("myrealbudget_currency")) ||
        "USD";
      const syms = {
        USD: "$",
        EUR: "€",
        GBP: "£",
        INR: "₹",
        CAD: "C$",
        AUD: "A$",
      };
      return syms[curr] || "$";
    }

    function formatMoney(amount) {
      amount = cleanMoney(amount);
      if (
        window._mrb_currency &&
        typeof window._mrb_currency.format === "function"
      ) {
        return window._mrb_currency.format(amount);
      }
      const sym = getCurrencySymbol();
      if (!isFinite(amount) || isNaN(amount)) {
        return sym + "0";
      }
      const curr =
        (typeof localStorage !== "undefined" &&
          localStorage.getItem("myrealbudget_currency")) ||
        "USD";
      const locale = curr === "INR" ? "en-IN" : "en-US";
      const hasCents = amount % 1 !== 0;
      const formatted = new Intl.NumberFormat(locale, {
        minimumFractionDigits: hasCents ? 2 : 0,
        maximumFractionDigits: hasCents ? 2 : 0,
      }).format(Math.abs(amount));
      const sign =
        amount < 0 && Math.abs(amount) >= MONEY_TOLERANCE ? "-" : "";
      return sign + sym + formatted;
    }

    function renderGroup(groupKey, containerId) {
      const container = document.getElementById(containerId);
      if (!container) return;

      container.innerHTML = state[groupKey]
        .map((item, idx) => {
          const translatedName = window._mrb_i18n
            ? window._mrb_i18n.translateItem(item.name)
            : item.name;
          return `
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-1 sm:gap-2 p-1.5 sm:p-2 rounded-[6px] bg-[#fafafa] border border-[#ebebeb] text-xs">
        <input
          type="text"
          value="${escapeHtml(translatedName)}"
          aria-label="${groupKey} line item"
          class="flex-1 px-2 py-1 sm:px-2.5 sm:py-1.5 rounded-[5px] bg-white border border-[#ebebeb] text-[#171717] focus:outline-none focus:border-[#171717] text-xs"
          onchange="window._f3020.updateItem('${groupKey}', ${idx}, 'name', this.value)"
        />
        <div class="flex items-center gap-1 sm:gap-2">
          <div class="relative flex-1 sm:w-28 sm:flex-initial">
            <span class="currency-symbol absolute left-2 top-1 sm:top-1.5 text-[#8f8f8f] font-mono text-xs">${getCurrencySymbol()}</span>
            <input
              type="number"
              min="0"
              step="any"
              value="${item.amount || ""}"
              placeholder="0"
              aria-label="${groupKey} amount"
              class="w-full pl-5 pr-1.5 py-1 sm:pl-6 sm:pr-2 sm:py-1.5 rounded-[5px] bg-white border border-[#ebebeb] text-[#171717] font-mono text-right focus:outline-none focus:border-[#171717] text-xs"
              oninput="window._f3020.updateItem('${groupKey}', ${idx}, 'amount', this.value, this)"
              onchange="if((this.value||'').trim().startsWith('-')||Number(this.value)<0){this.value='';window._f3020.updateItem('${groupKey}', ${idx}, 'amount', 0, this);}"
            />
          </div>
          <select
            aria-label="${groupKey} frequency"
            class="px-1.5 py-1 sm:px-2 sm:py-1.5 rounded-[5px] bg-white border border-[#ebebeb] text-[#4d4d4d] focus:outline-none focus:border-[#171717] text-xs font-mono shrink-0"
            onchange="window._f3020.updateItem('${groupKey}', ${idx}, 'frequency', this.value)"
          >
            ${FREQUENCY_OPTIONS.map((opt) => {
              const label = window._mrb_i18n
                ? window._mrb_i18n.getFrequencyLabel(opt.id)
                : opt.label;
              return `<option value="${opt.id}" ${item.frequency === opt.id ? "selected" : ""}>${label}</option>`;
            }).join("")}
          </select>
          <button
            type="button"
            title="${t("actions.delete") || "Remove item"}"
            aria-label="${t("actions.delete") || "Remove item"}"
            class="p-1 sm:p-1.5 text-[#8f8f8f] hover:text-[#ee0000] rounded hover:bg-neutral-100 transition shrink-0"
            onclick="window._f3020.removeItem('${groupKey}', ${idx})"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
    `;
        })
        .join("");
    }

    function calculateAndRender() {
      const incomeFreq = state.incomeFrequency || "monthly";
      const monthlyIncome = cleanMoney(normalize(state.income, incomeFreq));
      const targetNeeds = cleanMoney(monthlyIncome * 0.5);
      const targetWants = cleanMoney(monthlyIncome * 0.3);
      const targetSavings = cleanMoney(monthlyIncome - targetNeeds - targetWants);

      const actualNeeds = cleanMoney(
        state.needs.reduce((s, i) => s + normalize(i.amount, i.frequency), 0),
      );
      const actualWants = cleanMoney(
        state.wants.reduce((s, i) => s + normalize(i.amount, i.frequency), 0),
      );
      const actualSavings = cleanMoney(
        state.savings.reduce((s, i) => s + normalize(i.amount, i.frequency), 0),
      );

      const totalOutflow = cleanMoney(
        actualNeeds + actualWants + actualSavings,
      );
      const unassigned = cleanMoney(monthlyIncome - totalOutflow);

      // Headers
      const hNeeds = document.getElementById("f3020-needs-actual-header");
      const hWants = document.getElementById("f3020-wants-actual-header");
      const hSavings = document.getElementById("f3020-savings-actual-header");

      if (hNeeds) hNeeds.textContent = formatMoney(actualNeeds);
      if (hWants) hWants.textContent = formatMoney(actualWants);
      if (hSavings) hSavings.textContent = formatMoney(actualSavings);

      // Targets
      const tNeeds = document.getElementById("cmp-needs-target");
      const tWants = document.getElementById("cmp-wants-target");
      const tSavings = document.getElementById("cmp-savings-target");

      if (tNeeds) tNeeds.textContent = formatMoney(targetNeeds);
      if (tWants) tWants.textContent = formatMoney(targetWants);
      if (tSavings) tSavings.textContent = formatMoney(targetSavings);

      // Actuals
      const aNeeds = document.getElementById("cmp-needs-actual");
      const aWants = document.getElementById("cmp-wants-actual");
      const aSavings = document.getElementById("cmp-savings-actual");

      if (aNeeds) aNeeds.textContent = formatMoney(actualNeeds);
      if (aWants) aWants.textContent = formatMoney(actualWants);
      if (aSavings) aSavings.textContent = formatMoney(actualSavings);

      // Mobile Snapshot Updates
      const mUnassigned = document.getElementById(
        "mobile-f3020-unassigned-val",
      );
      const mBadge = document.getElementById("mobile-f3020-status-badge");
      const mText = document.getElementById("mobile-f3020-status-text");
      const mNeedsVal = document.getElementById("mobile-f3020-needs-val");
      const mNeedsTarget = document.getElementById("mobile-f3020-needs-target");
      const mWantsVal = document.getElementById("mobile-f3020-wants-val");
      const mWantsTarget = document.getElementById("mobile-f3020-wants-target");
      const mSavingsVal = document.getElementById("mobile-f3020-savings-val");
      const mSavingsTarget = document.getElementById(
        "mobile-f3020-savings-target",
      );
      const mTotalOut = document.getElementById("mobile-f3020-total-outflow");

      if (mUnassigned) {
        mUnassigned.textContent = formatMoney(unassigned);
        mUnassigned.className =
          unassigned < 0
            ? "font-mono text-base font-bold tracking-tight text-[#ee0000]"
            : "font-mono text-base font-bold tracking-tight text-[#171717]";
      }
      if (mBadge && mText) {
        if (unassigned === 0) {
          mBadge.className =
            "px-2 py-0.5 rounded text-[11px] font-medium bg-[#eef6ff] text-[#0761d1] border border-[#bfdbfe]";
          mText.textContent = t("summary.balanced");
        } else if (unassigned < 0) {
          mBadge.className =
            "px-2 py-0.5 rounded text-[11px] font-medium bg-[#fef2f2] text-[#b91c1c] border border-[#fecaca]";
          mText.textContent = t("summary.over_budget");
        } else {
          mBadge.className =
            "px-2 py-0.5 rounded text-[11px] font-medium bg-[#e6fbf5] text-[#047857] border border-[#a7f3d0]";
          mText.textContent = t("summary.surplus");
        }
      }
      if (mNeedsVal) mNeedsVal.textContent = formatMoney(actualNeeds);
      if (mNeedsTarget)
        mNeedsTarget.textContent = `/ ${formatMoney(targetNeeds)}`;
      if (mWantsVal) mWantsVal.textContent = formatMoney(actualWants);
      if (mWantsTarget)
        mWantsTarget.textContent = `/ ${formatMoney(targetWants)}`;
      if (mSavingsVal) mSavingsVal.textContent = formatMoney(actualSavings);
      if (mSavingsTarget)
        mSavingsTarget.textContent = `/ ${formatMoney(targetSavings)}`;
      if (mTotalOut) mTotalOut.textContent = formatMoney(totalOutflow);

      // Differences
      updateDiffEl("cmp-needs-diff", targetNeeds, actualNeeds, true);
      updateDiffEl("cmp-wants-diff", targetWants, actualWants, true);
      updateDiffEl("cmp-savings-diff", targetSavings, actualSavings, false);

      // Progress Bars
      updateBar("cmp-needs-bar", targetNeeds, actualNeeds);
      updateBar("cmp-wants-bar", targetWants, actualWants);
      updateBar("cmp-savings-bar", targetSavings, actualSavings);

      // Totals
      const tOut = document.getElementById("cmp-total-outflow");
      const uCash = document.getElementById("cmp-unassigned-cash");
      if (tOut) tOut.textContent = formatMoney(totalOutflow);
      if (uCash) {
        uCash.textContent = formatMoney(unassigned);
        uCash.className =
          unassigned < 0
            ? "font-mono font-semibold text-sm text-[#ee0000]"
            : "font-mono font-semibold text-sm text-[#047857]";
      }

      // Assessment
      renderAssessment(
        monthlyIncome,
        targetNeeds,
        actualNeeds,
        targetWants,
        actualWants,
        targetSavings,
        actualSavings,
        unassigned,
      );
    }

    function updateDiffEl(id, target, actual, isExpense) {
      const el = document.getElementById(id);
      if (!el) return;
      const diff = cleanMoney(actual - target);
      if (diff === 0 || Math.abs(diff) < MONEY_TOLERANCE) {
        el.textContent = t("summary.on_target");
        el.className = "font-mono text-xs font-semibold text-[#047857]";
      } else if (diff > 0) {
        const label = `+${formatMoney(diff)}`;
        el.textContent = `${label} ${t("summary.over")}`;
        el.className = isExpense
          ? "font-mono text-xs font-semibold text-[#ee0000]"
          : "font-mono text-xs font-semibold text-[#047857]";
      } else {
        const label = `-${formatMoney(Math.abs(diff))}`;
        el.textContent = `${label} ${t("summary.under")}`;
        el.className = isExpense
          ? "font-mono text-xs font-semibold text-[#047857]"
          : "font-mono text-xs font-semibold text-[#8f8f8f]";
      }
    }

    function updateBar(id, target, actual) {
      const el = document.getElementById(id);
      if (!el) return;
      const realPct =
        target > 0 ? Math.round((actual / target) * 100) : 0;
      el.style.width = `${Math.min(100, realPct)}%`;
      el.setAttribute("aria-valuenow", String(realPct));
      if (realPct > 100) {
        el.title = `${realPct}% of target`;
      } else {
        el.removeAttribute("title");
      }
    }

    function renderAssessment(
      income,
      tNeeds,
      aNeeds,
      tWants,
      aWants,
      tSavings,
      aSavings,
      unassigned,
    ) {
      const box = document.getElementById("f3020-assessment-box");
      if (!box) return;

      if (income === 0) {
        box.innerHTML = `<p class="text-[#8f8f8f]">${t("interpret.f3020_empty")}</p>`;
        return;
      }

      const needsPct = Math.round((aNeeds / income) * 100);
      const wantsPct = Math.round((aWants / income) * 100);
      const savingsPct = Math.round((aSavings / income) * 100);
      const bullets = [];

      // Needs
      if (aNeeds > tNeeds) {
        const over = aNeeds - tNeeds;
        bullets.push(
          t("interpret.f3020_needs_over", {
            pct: needsPct,
            amount: formatMoney(over),
          }),
        );
      } else {
        bullets.push(t("interpret.f3020_needs_ok", { pct: needsPct }));
      }

      // Wants
      if (aWants > tWants) {
        const overW = aWants - tWants;
        bullets.push(
          t("interpret.f3020_wants_over", {
            pct: wantsPct,
            amount: formatMoney(overW),
          }),
        );
      } else {
        bullets.push(t("interpret.f3020_wants_ok", { pct: wantsPct }));
      }

      // Savings
      if (aSavings >= tSavings) {
        bullets.push(t("interpret.f3020_savings_ok", { pct: savingsPct }));
      } else {
        const underS = tSavings - aSavings;
        bullets.push(
          t("interpret.f3020_savings_under", {
            pct: savingsPct,
            amount: formatMoney(underS),
          }),
        );
      }

      // Net balance
      if (unassigned === 0) {
        bullets.push(t("interpret.f3020_unassigned_balanced"));
      } else if (unassigned < 0) {
        bullets.push(
          `<span class="text-[#ee0000] font-medium">${t("interpret.f3020_unassigned_over", { amount: formatMoney(Math.abs(unassigned)) })}</span>`,
        );
      } else {
        bullets.push(
          t("interpret.f3020_unassigned_surplus", {
            amount: formatMoney(unassigned),
          }),
        );
      }

      box.innerHTML = bullets
        .map(
          (b) =>
            `<p class="flex items-start gap-1.5"><span>•</span><span>${b}</span></p>`,
        )
        .join("");
    }

    function escapeHtml(str) {
      return (str || "").replace(
        /[&<>"']/g,
        (m) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#039;",
          })[m],
      );
    }

    window._f3020 = {
      updateItem: function (group, idx, field, value, el) {
        if (!state[group] || !state[group][idx]) return;
        if (field === "amount") {
          if (el) validateNumericInput(el, value);
          state[group][idx].amount = sanitizeAmount(value);
        } else {
          state[group][idx][field] = value;
        }
        saveState();
        calculateAndRender();
      },
      removeItem: function (group, idx) {
        if (!state[group]) return;
        state[group].splice(idx, 1);
        saveState();
        renderGroup(group, `f3020-${group}-items`);
        calculateAndRender();
      },
      addItem: function (group) {
        if (!state[group]) return;
        state[group].push({
          id: "item_" + Date.now(),
          name:
            "New " +
            (group === "needs"
              ? "Need"
              : group === "wants"
                ? "Want"
                : "Savings Goal"),
          amount: 0,
          frequency: "monthly",
        });
        saveState();
        renderGroup(group, `f3020-${group}-items`);
        calculateAndRender();
      },
      toggleSection: function (key) {
        const body = document.getElementById(`f3020-body-${key}`);
        const btn = document.getElementById(`f3020-btn-${key}`);
        if (body) {
          const isCurrentlyHidden = body.classList.contains("hidden");
          if (isCurrentlyHidden) {
            body.classList.remove("hidden");
            body.classList.add("block");
          } else {
            body.classList.remove("block");
            body.classList.add("hidden");
          }
        }
        if (btn) {
          btn.classList.toggle("rotate-180");
        }
      },
      toggleAllSections: function (expand) {
        ["needs", "wants", "savings"].forEach((key) => {
          const body = document.getElementById(`f3020-body-${key}`);
          const btn = document.getElementById(`f3020-btn-${key}`);
          if (body) {
            if (expand) {
              body.classList.remove("hidden");
              body.classList.add("block");
            } else {
              body.classList.remove("block");
              body.classList.add("hidden");
            }
          }
          if (btn) {
            if (expand) btn.classList.add("rotate-180");
            else btn.classList.remove("rotate-180");
          }
        });
      },
    };

    function updateIncomeFrequencySelect() {
      const sel = document.getElementById("f3020-income-frequency");
      if (!sel) return;
      const current = state.incomeFrequency || "monthly";
      sel.innerHTML = FREQUENCY_OPTIONS.map((opt) => {
        const freqLabel = window._mrb_i18n
          ? window._mrb_i18n.getFrequencyLabel(opt.id)
          : opt.label;
        return `<option value="${opt.id}" ${current === opt.id ? "selected" : ""}>${freqLabel}</option>`;
      }).join("");
      sel.value = current;
    }

    const incomeInput = document.getElementById("f3020-income-input");
    if (incomeInput) {
      incomeInput.addEventListener("input", (e) => {
        validateNumericInput(e.target, e.target.value);
        state.income = sanitizeAmount(e.target.value);
        saveState();
        calculateAndRender();
      });
      incomeInput.addEventListener("change", (e) => {
        if ((e.target.value || "").trim().startsWith("-") || Number(e.target.value) < 0) {
          e.target.value = "0";
          validateNumericInput(e.target, "0");
          state.income = 0;
          saveState();
          calculateAndRender();
        }
      });
    }

    const incomeFreqSelect = document.getElementById("f3020-income-frequency");
    if (incomeFreqSelect) {
      incomeFreqSelect.addEventListener("change", (e) => {
        state.incomeFrequency = e.target.value;
        saveState();
        calculateAndRender();
      });
    }

    const resetBtn = document.getElementById("f3020-reset-btn");
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        if (confirm(t("confirm.reset_503020"))) {
          state = JSON.parse(JSON.stringify(defaultData));
          if (incomeInput) incomeInput.value = state.income;
          updateIncomeFrequencySelect();
          saveState();
          renderGroup("needs", "f3020-needs-items");
          renderGroup("wants", "f3020-wants-items");
          renderGroup("savings", "f3020-savings-items");
          calculateAndRender();
        }
      });
    }

    // Listen for global currency and language updates
    window.addEventListener("myrealbudget:currency-change", () => {
      document
        .querySelectorAll("#fifty-thirty-twenty-planner .currency-symbol")
        .forEach((el) => {
          el.textContent = getCurrencySymbol();
        });
      renderGroup("needs", "f3020-needs-items");
      renderGroup("wants", "f3020-wants-items");
      renderGroup("savings", "f3020-savings-items");
      calculateAndRender();
    });

    window.addEventListener("myrealbudget:language-change", () => {
      updateIncomeFrequencySelect();
      renderGroup("needs", "f3020-needs-items");
      renderGroup("wants", "f3020-wants-items");
      renderGroup("savings", "f3020-savings-items");
      calculateAndRender();
    });

    // Initial Boot
    document
      .querySelectorAll("#fifty-thirty-twenty-planner .currency-symbol")
      .forEach((el) => {
        el.textContent = getCurrencySymbol();
      });
    if (incomeInput) incomeInput.value = state.income;
    updateIncomeFrequencySelect();
    renderGroup("needs", "f3020-needs-items");
    renderGroup("wants", "f3020-wants-items");
    renderGroup("savings", "f3020-savings-items");
    calculateAndRender();
  })();
</script>
