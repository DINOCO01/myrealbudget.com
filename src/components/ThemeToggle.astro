---
interface Props {
  id?: string;
  class?: string;
}

const { id = 'theme-toggle-btn', class: className = '' } = Astro.props;
---

<button
  type="button"
  id={id}
  class={`theme-toggle flex items-center justify-center w-9 h-9 rounded-[6px] border border-hairline bg-canvas-elevated text-ink hover:bg-hairline-soft transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0070f3] ${className}`}
  aria-label="Toggle theme between light and dark"
  title="Toggle theme (Light / Dark)"
>
  <!-- Sun Icon (shown in dark mode) -->
  <svg class="sun-icon w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    />
  </svg>
  <!-- Moon Icon (shown in light mode) -->
  <svg class="moon-icon w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    />
  </svg>
</button>

<script is:inline>
(function() {
  function updateToggleIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    document.querySelectorAll('.theme-toggle').forEach(btn => {
      const sun = btn.querySelector('.sun-icon');
      const moon = btn.querySelector('.moon-icon');
      if (sun && moon) {
        if (isDark) {
          sun.classList.remove('hidden');
          moon.classList.add('hidden');
          const txt = window._mrb_i18n ? window._mrb_i18n.t('aria.switch_light') : 'Switch to light mode';
          btn.setAttribute('aria-label', txt);
          btn.setAttribute('title', txt);
        } else {
          sun.classList.add('hidden');
          moon.classList.remove('hidden');
          const txt = window._mrb_i18n ? window._mrb_i18n.t('aria.switch_dark') : 'Switch to dark mode';
          btn.setAttribute('aria-label', txt);
          btn.setAttribute('title', txt);
        }
      }
    });
  }

  window.addEventListener('myrealbudget:language-change', updateToggleIcons);

  // Global toggle handler
  window.toggleTheme = function() {
    const isDark = document.documentElement.classList.contains('dark');
    const nextIsDark = !isDark;
    if (nextIsDark) {
      document.documentElement.classList.add('dark');
      localStorage.setItem('myrealbudget_theme', 'dark');
    } else {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('myrealbudget_theme', 'light');
    }
    updateToggleIcons();
    // Dispatch custom event for charts or dynamic components if needed
    window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: nextIsDark ? 'dark' : 'light' } }));
  };

  // Wire buttons
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.theme-toggle').forEach(btn => {
      btn.addEventListener('click', window.toggleTheme);
    });
    updateToggleIcons();
  });

  // Listen to system preference changes if no manual choice set
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!localStorage.getItem('myrealbudget_theme')) {
      if (e.matches) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      updateToggleIcons();
    }
  });

  // Sync initially
  updateToggleIcons();
})();
</script>
